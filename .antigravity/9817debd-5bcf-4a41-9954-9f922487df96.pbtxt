  file_change {
    absolute_path_uri: "file:///src/components/SocialPublishModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  X, \n  Send, \n  CheckCircle2, \n  ShieldCheck, \n  Clock, \n  AlertCircle, \n  Sparkles, \n  ExternalLink,\n  Instagram,\n  Linkedin,\n  Twitter,\n  Facebook\n} from \'lucide-react\';\nimport { SocialPlatform, SocialAccount } from \'../types\';\n\ninterface SocialPublishModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  mediaFilename: string;\n  mediaThumbnail: string;\n  captionText: string;\n  platform: SocialPlatform;\n  connectedAccounts: SocialAccount[];\n  onPublish: (data: {\n    platform: SocialPlatform;\n    account_handle: string;\n    caption_text: string;\n    user_approved: boolean;\n    scheduled_for?: string;\n  }) => Promise<any>;\n}\n\nexport const SocialPublishModal: React.FC<SocialPublishModalProps> = ({\n  isOpen,\n  onClose,\n  mediaFilename,\n  mediaThumbnail,\n  captionText,\n  platform,\n  connectedAccounts,\n  onPublish\n}) => {\n  const [selectedPlatform, setSelectedPlatform] = useState<SocialPlatform>(platform);\n  const [userApproved, setUserApproved] = useState<boolean>(true);\n  const [isScheduling, setIsScheduling] = useState<boolean>(false);\n  const [scheduledTime, setScheduledTime] = useState<string>(\'\');\n  const [editedCaption, setEditedCaption] = useState<string>(captionText);\n  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);\n  const [publishResult, setPublishResult] = useState<{ success: boolean; message: string; postUrl?: string } | null>(null);\n\n  if (!isOpen) return null;\n\n  // Find connected account for selected platform\n  const currentAccount = connectedAccounts.find(\n    a => a.platform.toLowerCase() === selectedPlatform.toLowerCase() && a.is_connected\n  );\n\n  const getPlatformIcon = (plat: SocialPlatform) => {\n    switch (plat) {\n      case \'Instagram\': return <Instagram className=\"w-4 h-4 text-pink-600\" />;\n      case \'LinkedIn\': return <Linkedin className=\"w-4 h-4 text-blue-600\" />;\n      case \'X\': return <Twitter className=\"w-4 h-4 text-slate-900 dark:text-white\" />;\n      case \'Facebook\': return <Facebook className=\"w-4 h-4 text-blue-700\" />;\n      default: return <Send className=\"w-4 h-4 text-indigo-600\" />;\n    }\n  };\n\n  const handleExecutePublish = async () => {\n    if (!userApproved) return;\n    setIsSubmitting(true);\n    setPublishResult(null);\n\n    try {\n      const res = await onPublish({\n        platform: selectedPlatform,\n        account_handle: currentAccount?.handle || `@${selectedPlatform.toLowerCase()}_creator`,\n        caption_text: editedCaption,\n        user_approved: true,\n        scheduled_for: isScheduling ? scheduledTime : undefined\n      });\n\n      setPublishResult({\n        success: true,\n        message: res.message || \'Post published successfully!\',\n        postUrl: res.post?.post_url\n      });\n    } catch (err: any) {\n      setPublishResult({\n        success: false,\n        message: err.message || \'Failed to publish post. Please check user approval.\'\n      });\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n      <div className=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl w-full max-w-xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between bg-white dark:bg-slate-900\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center shadow-xs\">\n              <Send className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <span>Approve & Post to Social Media</span>\n                <span className=\"text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 flex items-center gap-1\">\n                  <ShieldCheck className=\"w-3 h-3\" />\n                  Approval Required\n                </span>\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                Review post media, caption, and authorize immediate or scheduled publication\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5 flex-1\">\n          \n          {/* Success Banner */}\n          {publishResult && publishResult.success ? (\n            <div className=\"p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 space-y-2\">\n              <div className=\"flex items-center gap-2 text-sm font-bold\">\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-600\" />\n                <span>{publishResult.message}</span>\n              </div>\n              {publishResult.postUrl && (\n                <a\n                  href={publishResult.postUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline pt-1\"\n                >\n                  <span>View Published Post on {selectedPlatform}</span>\n                  <ExternalLink className=\"w-3.5 h-3.5\" />\n                </a>\n              )}\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  onClick={onClose}\n                  className=\"px-4 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 cursor-pointer\"\n                >\n                  Done\n                </button>\n              </div>\n            </div>\n          ) : publishResult && !publishResult.success ? (\n            <div className=\"p-4 rounded-xl bg-red-50 dark:bg-red-950/80 border border-red-200 dark:border-red-800 text-red-900 dark:text-red-200 flex items-center gap-2 text-xs font-medium\">\n              <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0\" />\n              <span>{publishResult.message}</span>\n            </div>\n          ) : null}\n\n          {/* Platform Selector */}\n          <div className=\"space-y-2\">\n            <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 block uppercase tracking-wider\">\n              Target Platform & Page\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {([\'Instagram\', \'LinkedIn\', \'X\', \'Facebook\'] as SocialPlatform[]).map((plat) => {\n                const isSelected = selectedPlatform === plat;\n                const acc = connectedAccounts.find(a => a.platform === plat && a.is_connected);\n                return (\n                  <button\n                    key={plat}\n                    onClick={() => setSelectedPlatform(plat)}\n                    className={`p-3 rounded-xl border text-left flex flex-col justify-between transition-all cursor-pointer ${\n                      isSelected\n                        ? \'border-indigo-600 bg-indigo-50/50 dark:bg-indigo-950/60 ring-1 ring-indigo-600\'\n                        : \'border-gray-200 dark:border-slate-800 hover:border-gray-300 bg-white dark:bg-slate-800\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between w-full mb-2\">\n                      {getPlatformIcon(plat)}\n                      <span className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${\n                        acc ? \'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300\' : \'bg-gray-100 text-gray-500\'\n                      }`}>\n                        {acc ? \'Connected\' : \'Offline\'}\n                      </span>\n                    </div>\n                    <div>\n                      <span className=\"text-xs font-bold text-gray-900 dark:text-white block\">{plat}</span>\n                      <span className=\"text-[10px] text-gray-500 dark:text-slate-400 truncate block\">\n                        {acc ? acc.handle : \'Not connected\'}\n                      </span>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Preview Card */}\n          <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-700 space-y-3\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={mediaThumbnail}\n                alt={mediaFilename}\n                className=\"w-14 h-14 rounded-lg object-cover border border-gray-200 dark:border-slate-700 shrink-0\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <span className=\"text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider block\">\n                  Media Attachment\n                </span>\n                <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                  {mediaFilename}\n                </p>\n                <p className=\"text-[11px] text-gray-500 dark:text-slate-400\">\n                  Target: <strong className=\"text-gray-800 dark:text-slate-200\">{currentAccount ? currentAccount.account_name : selectedPlatform}</strong> ({currentAccount?.handle || \'Unlinked\'})\n                </p>\n              </div>\n            </div>\n\n            {/* Editable Caption Text */}\n            <div className=\"space-y-1\">\n              <label className=\"text-[11px] font-bold text-gray-600 dark:text-slate-400 block\">\n                Caption Preview (Click to edit)\n              </label>\n              <textarea\n                value={editedCaption}\n                onChange={(e) => setEditedCaption(e.target.value)}\n                rows={5}\n                className=\"w-full p-3 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-sans leading-relaxed resize-none\"\n              />\n            </div>\n          </div>\n\n          {/* Schedule Toggle */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 flex items-center gap-1.5 cursor-pointer\">\n                <Clock className=\"w-4 h-4 text-indigo-600\" />\n                <span>Schedule Post for Later</span>\n              </label>\n              <input\n                type=\"checkbox\"\n                checked={isScheduling}\n                onChange={(e) => setIsScheduling(e.target.checked)}\n                className=\"w-4 h-4 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            {isScheduling && (\n              <input\n                type=\"datetime-local\"\n                value={scheduledTime}\n                onChange={(e) => setScheduledTime(e.target.value)}\n                className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n              />\n            )}\n          </div>\n\n          {/* Mandatory User Approval Checkbox */}\n          <div className=\"p-4 rounded-xl bg-indigo-50/70 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-900/60 flex items-start gap-3\">\n            <input\n              type=\"checkbox\"\n              id=\"user-approval-check\"\n              checked={userApproved}\n              onChange={(e) => setUserApproved(e.target.checked)}\n              className=\"w-5 h-5 mt-0.5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer\"\n            />\n            <label htmlFor=\"user-approval-check\" className=\"text-xs text-indigo-950 dark:text-indigo-200 font-medium leading-relaxed cursor-pointer\">\n              <strong className=\"font-bold text-indigo-900 dark:text-indigo-100 block mb-0.5 flex items-center gap-1\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-indigo-600\" />\n                User Authorization & Explicit Approval\n              </strong>\n              I explicitly approve and authorize publishing this media content and caption directly to my connected <span className=\"font-bold\">{selectedPlatform}</span> account ({currentAccount?.handle || \'@connected_page\'}).\n            </label>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-gray-200 dark:border-slate-800 bg-gray-50/80 dark:bg-slate-900/80 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded-lg text-xs font-semibold text-gray-600 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            Cancel\n          </button>\n\n          <button\n            onClick={handleExecutePublish}\n            disabled={!userApproved || isSubmitting || (isScheduling && !scheduledTime)}\n            className=\"px-5 py-2 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-all active:scale-95 disabled:opacity-50 disabled:pointer-events-none flex items-center gap-2 cursor-pointer\"\n          >\n            {isSubmitting ? (\n              <>\n                <Sparkles className=\"w-4 h-4 animate-spin\" />\n                <span>Publishing to API...</span>\n              </>\n            ) : isScheduling ? (\n              <>\n                <Clock className=\"w-4 h-4\" />\n                <span>Approve & Schedule</span>\n              </>\n            ) : (\n              <>\n                <Send className=\"w-4 h-4\" />\n                <span>Approve & Post Now</span>\n              </>\n            )}\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
