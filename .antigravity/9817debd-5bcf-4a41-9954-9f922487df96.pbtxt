      replacement_content: "import React from \'react\';\nimport { Heart, Sparkles, FolderImage } from \'lucide-react\';\nimport { MediaItem } from \'../types\';\nimport { MediaCard } from \'./MediaCard\';\n\ninterface FavoritesViewProps {\n  items: MediaItem[];\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onOpenLibrary: () => void;\n}\n\nexport const FavoritesView: React.FC<FavoritesViewProps> = ({\n  items,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n  onOpenLibrary\n}) => {\n  const favoriteItems = items.filter((i) => i.is_favorite);\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n            <Heart className=\"w-5 h-5 text-rose-500 fill-current\" />\n            <span>Favorite Media ({favoriteItems.length})</span>\n          </h2>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n            Quickly access your starred Google Drive assets for rapid post creation\n          </p>\n        </div>\n      </div>\n\n      {favoriteItems.length > 0 ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">\n          {favoriteItems.map((item) => (\n            <MediaCard\n              key={item.id}\n              item={item}\n              viewMode=\"grid\"\n              onSelectMedia={onSelectMedia}\n              onGenerateCaption={onGenerateCaption}\n              onToggleFavorite={onToggleFavorite}\n            />\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-3xl bg-white dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 p-8 space-y-3\">\n          <div className=\"w-14 h-14 rounded-full bg-rose-50 dark:bg-rose-950 text-rose-500 flex items-center justify-center mx-auto\">\n            <Heart className=\"w-7 h-7\" />\n          </div>\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            No favorite assets starred yet\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Click the heart icon on any media card in your library to bookmark it here for fast access.\n          </p>\n          <button\n            onClick={onOpenLibrary}\n            className=\"mt-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md\"\n          >\n            Go to Media Library\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
