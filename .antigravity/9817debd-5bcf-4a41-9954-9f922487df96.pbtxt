    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { \n  User as UserIcon, \n  HardDrive, \n  Sparkles, \n  Sliders, \n  CheckCircle2, \n  ShieldCheck, \n  Layers, \n  Calendar, \n  BarChart2, \n  Users, \n  Cloud, \n  ExternalLink,\n  Moon,\n  Sun\n} from \'lucide-react\';\nimport { User } from \'../types\';\n\ninterface SettingsViewProps {\n  user: User;\n  onConnectDrive: () => void;\n  onDisconnectDrive: () => void;\n  darkMode: boolean;\n  onToggleDarkMode: () => void;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({\n  user,\n  onConnectDrive,\n  onDisconnectDrive,\n  darkMode,\n  onToggleDarkMode\n}) => {\n  const futureRoadmap = [\n    { title: \'Brand Voice Learning\', desc: \'Train AI on your previous top-performing posts to replicate your exact tone\', icon: Sparkles },\n    { title: \'Direct Auto-Posting\', desc: \'Publish approved captions and media directly to Instagram & LinkedIn without leaving\', icon: ExternalLink },\n    { title: \'Content Calendar & Scheduling\', desc: \'Plan weekly content schedules and queue automated post releases\', icon: Calendar },\n    { title: \'Social Analytics Dashboard\', desc: \'Track engagement rates, reach, and conversion performance per caption style\', icon: BarChart2 },\n    { title: \'Team Collaboration\', desc: \'Share caption drafts, assign approvals, and manage brand workspaces\', icon: Users },\n    { title: \'Multi-Cloud Integration\', desc: \'Connect Dropbox, OneDrive, and Google Photos alongside Google Drive\', icon: Cloud }\n  ];\n\n  return (\n    <div className=\"space-y-6 max-w-4xl mx-auto animate-fadeIn\">\n      \n      {/* Title */}\n      <div>\n        <h2 className=\"text-xl font-bold text-slate-900 dark:text-white\">\n          Account & App Settings\n        </h2>\n        <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n          Manage integrations, preferences, and theme choices\n        </p>\n      </div>\n\n      {/* User Profile Card */}\n      <div className=\"p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs space-y-4\">\n        <h3 className=\"text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n          <UserIcon className=\"w-4 h-4 text-indigo-500\" />\n          <span>User Profile</span>\n        </h3>\n\n        <div className=\"flex items-center gap-4\">\n          <img src={user.avatar} alt={user.name} className=\"w-14 h-14 rounded-full ring-4 ring-indigo-500/20 object-cover\" />\n          <div>\n            <h4 className=\"text-base font-bold text-slate-900 dark:text-white\">{user.name}</h4>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">{user.email}</p>\n            <span className=\"inline-block mt-1 text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400\">\n              Pro Creator Tier\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Google Drive Connection Card */}\n      <div className=\"p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n            <HardDrive className=\"w-4 h-4 text-emerald-500\" />\n            <span>Google Drive Integration</span>\n          </h3>\n\n          <span className={`text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1 ${\n            user.isDriveConnected \n              ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300\' \n              : \'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300\'\n          }`}>\n            <CheckCircle2 className=\"w-3.5 h-3.5\" />\n            <span>{user.isDriveConnected ? \'Connected\' : \'Not Connected\'}</span>\n          </span>\n        </div>\n\n        <p className=\"text-xs text-slate-600 dark:text-slate-300 leading-relaxed\">\n          CaptionDrive requests read-only permission to scan media files in your Google Drive folders. Your files stay safely stored inside your Google Account.\n        </p>\n\n        {user.isDriveConnected ? (\n          <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs\">\n            <div>\n              <p className=\"font-semibold text-slate-900 dark:text-white\">Active Connected Account:</p>\n              <p className=\"text-slate-500\">{user.connectedDriveEmail || user.email}</p>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={onConnectDrive}\n                className=\"px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-100\"\n              >\n                Re-Sync Files\n              </button>\n              <button\n                onClick={onDisconnectDrive}\n                className=\"px-3 py-1.5 rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950 dark:text-rose-300 font-semibold hover:bg-rose-100\"\n              >\n                Disconnect\n              </button>\n            </div>\n          </div>\n        ) : (\n          <button\n            onClick={onConnectDrive}\n            className=\"px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md flex items-center gap-2\"\n          >\n            <HardDrive className=\"w-4 h-4\" />\n            <span>Connect Google Drive</span>\n          </button>\n        )}\n      </div>\n\n      {/* Preferences & Appearance */}\n      <div className=\"p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs space-y-4\">\n        <h3 className=\"text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n          <Sliders className=\"w-4 h-4 text-purple-500\" />\n          <span>Appearance & Preferences</span>\n        </h3>\n\n        <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs\">\n          <div>\n            <p className=\"font-bold text-slate-900 dark:text-white\">Interface Theme</p>\n            <p className=\"text-slate-500\">Switch between dark mode and light mode</p>\n          </div>\n\n          <button\n            onClick={onToggleDarkMode}\n            className=\"px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-2\"\n          >\n            {darkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4 text-indigo-500\" />}\n            <span>{darkMode ? \'Dark Mode\' : \'Light Mode\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Future Roadmap Section */}\n      <div className=\"p-6 rounded-3xl bg-gradient-to-b from-indigo-950/40 via-slate-900/40 to-slate-900/60 border border-indigo-900/40 space-y-4\">\n        <div>\n          <span className=\"text-[10px] font-bold uppercase tracking-wider text-indigo-400 bg-indigo-950 px-2.5 py-0.5 rounded-md border border-indigo-800\">\n            Platform Roadmap\n          </span>\n          <h3 className=\"text-base font-bold text-white mt-1\">\n            Upcoming Features & Architecture\n          </h3>\n          <p className=\"text-xs text-slate-400\">\n            CaptionDrive is architected to expand into a full social media command center\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2\">\n          {futureRoadmap.map((item, idx) => {\n            const Icon = item.icon;\n            return (\n              <div key={idx} className=\"p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1\">\n                <div className=\"flex items-center gap-2 text-indigo-400\">\n                  <Icon className=\"w-4 h-4\" />\n                  <span className=\"text-xs font-bold text-white\">{item.title}</span>\n                </div>\n                <p className=\"text-[11px] text-slate-400 leading-snug\">{item.desc}</p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { \n  User as UserIcon, \n  HardDrive, \n  Sparkles, \n  Sliders, \n  CheckCircle2, \n  Calendar, \n  BarChart2, \n  Users, \n  Cloud, \n  ExternalLink,\n  Moon,\n  Sun\n} from \'lucide-react\';\nimport { User } from \'../types\';\n\ninterface SettingsViewProps {\n  user: User;\n  onConnectDrive: () => void;\n  onDisconnectDrive: () => void;\n  darkMode: boolean;\n  onToggleDarkMode: () => void;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({\n  user,\n  onConnectDrive,\n  onDisconnectDrive,\n  darkMode,\n  onToggleDarkMode\n}) => {\n  const futureRoadmap = [\n    { title: \'Brand Voice Learning\', desc: \'Train AI on your previous top-performing posts to replicate your exact tone\', icon: Sparkles },\n    { title: \'Direct Auto-Posting\', desc: \'Publish approved captions and media directly to Instagram & LinkedIn without leaving\', icon: ExternalLink },\n    { title: \'Content Calendar & Scheduling\', desc: \'Plan weekly content schedules and queue automated post releases\', icon: Calendar },\n    { title: \'Social Analytics Dashboard\', desc: \'Track engagement rates, reach, and conversion performance per caption style\', icon: BarChart2 },\n    { title: \'Team Collaboration\', desc: \'Share caption drafts, assign approvals, and manage brand workspaces\', icon: Users },\n    { title: \'Multi-Cloud Integration\', desc: \'Connect Dropbox, OneDrive, and Google Photos alongside Google Drive\', icon: Cloud }\n  ];\n\n  return (\n    <div className=\"space-y-6 max-w-4xl mx-auto animate-fadeIn\">\n      \n      {/* Title */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card\">\n        <h1 className=\"text-2xl font-bold tracking-tight text-gray-900 dark:text-white\">\n          Account & Workspace Settings\n        </h1>\n        <p className=\"text-xs text-gray-500 dark:text-slate-400 mt-1\">\n          Manage integrations, team preferences, and appearance\n        </p>\n      </div>\n\n      {/* User Profile Card */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\">\n        <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n          <UserIcon className=\"w-4 h-4 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n          <span>User Profile</span>\n        </h3>\n\n        <div className=\"flex items-center gap-4\">\n          <img src={user.avatar} alt={user.name} className=\"w-14 h-14 rounded-full ring-2 ring-blue-600/20 object-cover\" />\n          <div>\n            <h4 className=\"text-base font-bold text-gray-900 dark:text-white\">{user.name}</h4>\n            <p className=\"text-xs text-gray-500 dark:text-slate-400\">{user.email}</p>\n            <span className=\"inline-block mt-1 text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-blue-50 text-blue-600 dark:bg-blue-950 dark:text-blue-300 border border-blue-100 dark:border-blue-900/40\">\n              Pro Creator Tier\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Google Drive Connection Card */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n            <HardDrive className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" strokeWidth={1.75} />\n            <span>Google Drive Integration</span>\n          </h3>\n\n          <span className={`text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1 ${\n            user.isDriveConnected \n              ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-900/40\' \n              : \'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-100 dark:border-amber-900/40\'\n          }`}>\n            <CheckCircle2 className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n            <span>{user.isDriveConnected ? \'Connected\' : \'Not Connected\'}</span>\n          </span>\n        </div>\n\n        <p className=\"text-xs text-gray-600 dark:text-slate-300 leading-relaxed\">\n          CaptionDrive requests read-only permission to scan media files in your Google Drive folders. Your files stay safely stored inside your Google Account.\n        </p>\n\n        {user.isDriveConnected ? (\n          <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs\">\n            <div>\n              <p className=\"font-semibold text-gray-900 dark:text-white\">Active Connected Account:</p>\n              <p className=\"text-gray-500 dark:text-slate-400\">{user.connectedDriveEmail || user.email}</p>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={onConnectDrive}\n                className=\"px-3 h-8 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 font-semibold text-gray-700 dark:text-slate-200 hover:bg-gray-100 transition-colors cursor-pointer\"\n              >\n                Re-Sync Files\n              </button>\n              <button\n                onClick={onDisconnectDrive}\n                className=\"px-3 h-8 rounded-lg bg-rose-50 text-rose-600 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-100 dark:border-rose-900/40 font-semibold hover:bg-rose-100 transition-colors cursor-pointer\"\n              >\n                Disconnect\n              </button>\n            </div>\n          </div>\n        ) : (\n          <button\n            onClick={onConnectDrive}\n            className=\"px-5 h-9 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs flex items-center gap-2 cursor-pointer transition-transform active:scale-95\"\n          >\n            <HardDrive className=\"w-4 h-4\" strokeWidth={1.75} />\n            <span>Connect Google Drive</span>\n          </button>\n        )}\n      </div>\n\n      {/* Preferences & Appearance */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\">\n        <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n          <Sliders className=\"w-4 h-4 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n          <span>Appearance & Preferences</span>\n        </h3>\n\n        <div className=\"flex items-center justify-between p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 text-xs\">\n          <div>\n            <p className=\"font-bold text-gray-900 dark:text-white\">Interface Theme</p>\n            <p className=\"text-gray-500 dark:text-slate-400\">Switch between dark mode and light mode</p>\n          </div>\n\n          <button\n            onClick={onToggleDarkMode}\n            className=\"px-3 h-8 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 font-semibold text-gray-700 dark:text-slate-200 flex items-center gap-2 cursor-pointer transition-colors\"\n          >\n            {darkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4 text-blue-600\" />}\n            <span>{darkMode ? \'Dark Mode\' : \'Light Mode\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Future Roadmap Section */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\">\n        <div>\n          <span className=\"text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-2.5 py-0.5 rounded-md border border-blue-100 dark:border-blue-900/40\">\n            Platform Roadmap\n          </span>\n          <h3 className=\"text-base font-bold text-gray-900 dark:text-white mt-2\">\n            Upcoming Features\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n            CaptionDrive is expanding into a full social media command center\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\">\n          {futureRoadmap.map((item, idx) => {\n            const Icon = item.icon;\n            return (\n              <div key={idx} className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-1\">\n                <div className=\"flex items-center gap-2 text-blue-600 dark:text-blue-400\">\n                  <Icon className=\"w-4 h-4\" strokeWidth={1.75} />\n                  <span className=\"text-xs font-bold text-gray-900 dark:text-white\">{item.title}</span>\n                </div>\n                <p className=\"text-[11px] text-gray-500 dark:text-slate-400 leading-snug\">{item.desc}</p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
