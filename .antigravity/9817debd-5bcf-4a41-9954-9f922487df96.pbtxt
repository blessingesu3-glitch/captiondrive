assName=\"w-3 h-3 text-gray-400\" />\n                <span className=\"truncate max-w-[120px]\">{item.folder}</span>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3 h-3 text-gray-400\" />\n                <span>{new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}</span>\n              </span>\n              {item.size_formatted && (\n                <span className=\"text-gray-400 text-[11px]\">\342\200\242 {item.size_formatted}</span>\n              )}\n            </div>\n\n            {/* AI Summary snippet */}\n            {item.ai_analysis?.overall_summary && (\n              <p className=\"text-xs text-gray-600 dark:text-slate-300 line-clamp-1 mt-1 font-normal\">\n                <span className=\"font-semibold text-gray-800 dark:text-slate-200\">AI:</span> {item.ai_analysis.overall_summary}\n              </p>\n            )}\n          </div>\n        </div>\n\n        {/* Action buttons */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-lg transition-colors cursor-pointer ${\n              item.is_favorite \n                ? \'text-rose-500 bg-rose-50 dark:bg-rose-950/50\' \n                : \'text-gray-400 hover:text-rose-500 hover:bg-gray-100 dark:hover:bg-slate-700\'\n            }`}\n            title=\"Toggle favorite\"\n          >\n            <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-colors cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // Grid view layout\n  return (\n    <div \n      onClick={() => onSelectMedia(item)}\n      className=\"group relative flex flex-col rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 shadow-xs hover:shadow-md transition-all cursor-pointer overflow-hidden\"\n    >\n      {/* Thumbnail Container */}\n      <div className=\"relative aspect-video w-full overflow-hidden bg-gray-100 dark:bg-slate-900\">\n        <img \n          src={item.thumbnail} \n          alt={item.filename}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between\">\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-xs text-white text-[10px] font-bold\">\n            {isVideo ? (\n              <>\n                <Video className=\"w-3 h-3 text-amber-400\" />\n                <span>Video</span>\n              </>\n            ) : (\n              <>\n                <FileImage className=\"w-3 h-3 text-indigo-400\" />\n                <span>Image</span>\n              </>\n            )}\n          </span>\n\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-1.5 rounded-full backdrop-blur-xs transition-all cursor-pointer ${\n              item.is_favorite \n                ? \'bg-rose-500 text-white shadow-xs\' \n                : \'bg-black/40 text-white hover:bg-black/60 hover:text-rose-400\'\n            }`}\n            title=\"Favorite\"\n          >\n            <Heart className={`w-3.5 h-3.5 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n         