  file_change {
    absolute_path_uri: "file:///src/components/CaptionHistoryView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  History, \n  Search, \n  Copy, \n  Check, \n  Trash2, \n  Filter, \n  ExternalLink,\n  Share2,\n  FileImage,\n  Video\n} from \'lucide-react\';\nimport { CaptionHistoryItem, SocialPlatform } from \'../types\';\n\ninterface CaptionHistoryViewProps {\n  history: CaptionHistoryItem[];\n  onDeleteHistoryItem: (id: string) => void;\n}\n\nexport const CaptionHistoryView: React.FC<CaptionHistoryViewProps> = ({\n  history,\n  onDeleteHistoryItem\n}) => {\n  const [selectedPlatform, setSelectedPlatform] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const platforms = [\'all\', \'Instagram\', \'LinkedIn\', \'Facebook\', \'X\'];\n\n  const filteredHistory = history.filter((item) => {\n    if (selectedPlatform !== \'all\' && item.platform !== selectedPlatform) {\n      return false;\n    }\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const matchesHook = item.caption_variation.hook.toLowerCase().includes(q);\n      const matchesBody = item.caption_variation.body.toLowerCase().includes(q);\n      const matchesFile = item.media_filename.toLowerCase().includes(q);\n      return matchesHook || matchesBody || matchesFile;\n    }\n    return true;\n  });\n\n  const handleCopy = (item: CaptionHistoryItem) => {\n    const text = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta}\\n\\n${item.caption_variation.hashtags.join(\' \')}`;\n    navigator.clipboard.writeText(text);\n    setCopiedId(item.id);\n    setTimeout(() => setCopiedId(null), 2500);\n  };\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-indigo-500\" />\n            <span>Recent Generated Captions ({history.length})</span>\n          </h2>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n            Review, copy, or manage your previously AI-generated captions\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Toolbar */}\n      <div className=\"p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n        \n        {/* Search */}\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search generated text or filename...\"\n            className=\"w-full pl-10 pr-4 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30\"\n          />\n        </div>\n\n        {/* Platform Filter Tabs */}\n        <div className=\"flex items-center gap-1 p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 w-full sm:w-auto overflow-x-auto\">\n          {platforms.map((p) => (\n            <button\n              key={p}\n              onClick={() => setSelectedPlatform(p)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-all ${\n                selectedPlatform === p\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              {p === \'all\' ? \'All Platforms\' : p}\n            </button>\n          ))}\n        </div>\n\n      </div>\n\n      {/* History Grid */}\n      {filteredHistory.length > 0 ? (\n        <div className=\"space-y-4\">\n          {filteredHistory.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-5 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 space-y-3 shadow-xs hover:border-indigo-300 dark:hover:border-indigo-600/50 transition-all\"\n            >\n              <div className=\"flex items-center justify-between gap-3 flex-wrap border-b border-slate-100 dark:border-slate-800/80 pb-3\">\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"w-10 h-10 rounded-xl overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700\">\n                    <img src={item.media_thumbnail} alt={item.media_filename} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-xs font-bold text-slate-900 dark:text-white truncate\">\n                      {item.media_filename}\n                    </h4>\n                    <div className=\"flex items-center gap-2 mt-0.5 text-[11px] text-slate-500\">\n                      <span className=\"font-semibold text-indigo-600 dark:text-indigo-400\">{item.platform}</span>\n                      <span>\342\200\242</span>\n                      <span>{item.tone} Tone</span>\n                      <span>\342\200\242</span>\n                      <span>{item.length}</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopy(item)}\n                    className=\"px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center gap-1.5 transition-transform active:scale-95\"\n                  >\n                    {copiedId === item.id ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-emerald-300\" />\n                        <span>Copied!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-3.5 h-3.5\" />\n                        <span>Copy Caption</span>\n                      </>\n                    )}\n                  </button>\n\n                  <button\n                    onClick={() => onDeleteHistoryItem(item.id)}\n                    className=\"p-2 rounded-xl text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors\"\n                    title=\"Delete caption history item\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Caption Content */}\n              <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200/60 dark:border-slate-800 space-y-2\">\n                <p className=\"text-xs font-bold text-slate-900 dark:text-slate-100\">\n                  \360\237\252\235 {item.caption_variation.hook}\n                </p>\n                <p className=\"text-xs text-slate-700 dark:text-slate-300 font-sans whitespace-pre-wrap leading-relaxed\">\n                  {item.caption_variation.body}\n                </p>\n                {item.caption_variation.cta && (\n                  <p className=\"text-xs font-medium text-indigo-600 dark:text-indigo-400 pt-1\">\n                    \360\237\221\211 {item.caption_variation.cta}\n                  </p>\n                )}\n                {item.caption_variation.hashtags?.length > 0 && (\n                  <div className=\"flex flex-wrap gap-1 pt-1\">\n                    {item.caption_variation.hashtags.map((h, idx) => (\n                      <span key={idx} className=\"text-[10px] font-medium text-slate-500 dark:text-slate-400\">\n                        {h}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              <div className=\"text-[10px] text-slate-400 text-right\">\n                Created: {new Date(item.created_at).toLocaleString()}\n              </div>\n\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-3xl bg-white dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 p-8 space-y-3\">\n          <div className=\"w-14 h-14 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto\">\n            <History className=\"w-7 h-7\" />\n          </div>\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            No generated captions found\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Select a photo or video from your media library and click Generate Caption to save your first caption here.\n          </p>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
