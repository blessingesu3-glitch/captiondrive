         className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <span>Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n"
      }
