    instruction: "Integrate SocialPublishView, SocialPublishModal, real Google Drive OAuth sync, and social accounts handlers in App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { MediaGrid } from \'./components/MediaGrid\';\nimport { FavoritesView } from \'./components/FavoritesView\';\nimport { CaptionHistoryView } from \'./components/CaptionHistoryView\';\nimport { SettingsView } from \'./components/SettingsView\';\nimport { MediaDetailModal } from \'./components/MediaDetailModal\';\nimport { CaptionGeneratorModal } from \'./components/CaptionGeneratorModal\';\nimport { OnboardingModal } from \'./components/OnboardingModal\';\nimport { SmartSearchModal } from \'./components/SmartSearchModal\';\nimport { ImportMediaModal } from \'./components/ImportMediaModal\';\n\nimport { ActiveTab, MediaItem, CaptionHistoryItem, User } from \'./types\';\nimport { INITIAL_SAMPLE_MEDIA } from \'./data/sampleDriveMedia\';\n\nexport default function App() {\n  // Theme State\n  const [darkMode, setDarkMode] = useState<boolean>(true);\n\n  // User & Drive State\n  const [user, setUser] = useState<User>({\n    id: \'usr_default_01\',\n    name: \'Blessing Esu\',\n    email: \'blessingesu3@gmail.com\',\n    avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80\',\n    isDriveConnected: true,\n    connectedDriveEmail: \'blessingesu3@gmail.com\'\n  });\n\n  // Data Stores\n  const [mediaItems, setMediaItems] = useState<MediaItem[]>(INITIAL_SAMPLE_MEDIA);\n  const [captionHistory, setCaptionHistory] = useState<CaptionHistoryItem[]>([]);\n\n  // Navigation & UI State\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\'dashboard\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  // Modals\n  const [selectedMedia, setSelectedMedia] = useState<MediaItem | null>(null);\n  const [captionMedia, setCaptionMedia] = useState<MediaItem | null>(null);\n  const [showOnboarding, setShowOnboarding] = useState<boolean>(false);\n  const [showSmartSearch, setShowSmartSearch] = useState<boolean>(false);\n  const [showImportModal, setShowImportModal] = useState<boolean>(false);\n  const [isAnalyzing, setIsAnalyzing] = useState<boolean>(false);\n\n  // Apply dark mode class to root\n  useEffect(() => {\n    if (darkMode) {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }, [darkMode]);\n\n  // Load User & Media on mount\n  useEffect(() => {\n    fetch(\'/api/auth/me\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.user) {\n          setUser(data.user);\n        }\n      })\n      .catch((err) => console.log(\'Auth check error:\', err));\n\n    fetch(\'/api/drive/files\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.files && data.files.length > 0) {\n          // Merge fetched files with initial sample media if needed\n          const mergedMap = new Map<string, MediaItem>();\n          INITIAL_SAMPLE_MEDIA.forEach((item) => mergedMap.set(item.id, item));\n          data.files.forEach((file: MediaItem) => mergedMap.set(file.id, file));\n          setMediaItems(Array.from(mergedMap.values()));\n        }\n      })\n      .catch((err) => console.log(\'Fetch Drive files error:\', err));\n\n    fetch(\'/api/captions/history\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.history) {\n          setCaptionHistory(data.history);\n        }\n      })\n      .catch((err) => console.log(\'Fetch captions history error:\', err));\n  }, []);\n\n  // Connect Drive handler\n  const handleConnectDrive = async () => {\n    try {\n      const res = await fetch(\'/api/drive/connect\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ connectedEmail: user.email })\n      });\n      const data = await res.json();\n      if (data.success) {\n        setUser((prev) => ({\n          ...prev,\n          isDriveConnected: true,\n          connectedDriveEmail: prev.email\n        }));\n      }\n    } catch (err) {\n      console.error(\'Failed to connect Drive:\', err);\n    }\n  };\n\n  const handleDisconnectDrive = async () => {\n    try {\n      await fetch(\'/api/drive/disconnect\', { method: \'POST\' });\n      setUser((prev) => ({\n        ...prev,\n        isDriveConnected: false,\n        connectedDriveEmail: undefined\n      }));\n    } catch (err) {\n      console.error(\'Disconnect error:\', err);\n    }\n  };\n\n  // Toggle Favorite\n  const handleToggleFavorite = async (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setMediaItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, is_favorite: !item.is_favorite } : item))\n    );\n\n    try {\n      await fetch(\'/api/favorites/toggle\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ mediaId: id })\n      });\n    } catch (err) {\n      console.error(\'Favorite toggle error:\', err);\n    }\n  };\n\n  // Run AI Analysis for a file\n  const handleAnalyzeWithAI = async (item: MediaItem) => {\n    setIsAnalyzing(true);\n    try {\n      const res = await fetch(\'/api/ai/analyze\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          filename: item.filename,\n          file_type: item.file_type,\n          preview_url: item.preview_url || item.thumbnail,\n          folder: item.folder\n        })\n      });\n\n      const data = await res.json();\n      if (data.success && data.analysis) {\n        setMediaItems((prev) =>\n          prev.map((m) => (m.id === item.id ? { ...m, ai_analysis: data.analysis } : m))\n        );\n        if (selectedMedia?.id === item.id) {\n          setSelectedMedia((prev) => (prev ? { ...prev, ai_analysis: data.analysis } : null));\n        }\n      }\n    } catch (err) {\n      console.error(\'Analysis error:\', err);\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  // Save generated caption to history\n  const handleSaveToHistory = async (media: MediaItem, settings: any, variation: any) => {\n    const newItem: CaptionHistoryItem = {\n      id: `hist_${Date.now()}`,\n      media_id: media.id,\n      media_filename: media.filename,\n      media_thumbnail: media.thumbnail,\n      media_type: media.file_type,\n      platform: settings.platform,\n      tone: settings.tone,\n      length: settings.length,\n      target_audience: settings.target_audience,\n      caption_variation: variation,\n      created_at: new Date().toISOString()\n    };\n\n    setCaptionHistory((prev) => [newItem, ...prev]);\n\n    try {\n      await fetch(\'/api/captions/history\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ item: newItem })\n      });\n    } catch (err) {\n      console.error(\'Save caption history error:\', err);\n    }\n  };\n\n  // Delete caption history\n  const handleDeleteHistoryItem = async (id: string) => {\n    setCaptionHistory((prev) => prev.filter((i) => i.id !== id));\n    try {\n      await fetch(`/api/captions/history/${id}`, { method: \'DELETE\' });\n    } catch (err) {\n      console.error(\'Delete history item error:\', err);\n    }\n  };\n\n  // Custom Media Import\n  const handleImportMedia = async (mediaData: any) => {\n    try {\n      const res = await fetch(\'/api/drive/import\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(mediaData)\n      });\n      const data = await res.json();\n      if (data.success && data.media) {\n        setMediaItems((prev) => [data.media, ...prev]);\n        setActiveTab(\'media\');\n      }\n    } catch (err) {\n      console.error(\'Import error:\', err);\n    }\n  };\n\n  const handleApplySmartSearchMatches = (matchedList: MediaItem[]) => {\n    setActiveTab(\'media\');\n  };\n\n  const favoritesCount = mediaItems.filter((i) => i.is_favorite).length;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans transition-colors\">\n      \n      {/* Top Navbar */}\n      <Navbar\n        user={user}\n        onConnectDrive={handleConnectDrive}\n        darkMode={darkMode}\n        onToggleDarkMode={() => setDarkMode(!darkMode)}\n        searchQuery={searchQuery}\n        onSearchChange={setSearchQuery}\n        onOpenImportModal={() => setShowImportModal(true)}\n        onOpenSmartSearch={() => setShowSmartSearch(true)}\n        activeTab={activeTab}\n      />\n\n      {/* Main Layout */}\n      <div className=\"max-w-7xl mx-auto flex\">\n        \n        {/* Sidebar Navigation */}\n        <Sidebar\n          activeTab={activeTab}\n          onSelectTab={setActiveTab}\n          user={user}\n          onConnectDrive={handleConnectDrive}\n          favoritesCount={favoritesCount}\n          captionsCount={captionHistory.length}\n        />\n\n        {/* Content Area */}\n        <main className=\"flex-1 p-4 sm:p-6 md:p-8 min-w-0\">\n          \n          {/* Mobile Tab Pills Bar */}\n          <div className=\"flex md:hidden items-center gap-1.5 p-1 mb-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-x-auto\">\n            {([\'dashboard\', \'media\', \'favorites\', \'captions\', \'settings\'] as ActiveTab[]).map((tab) => (\n              <button\n                key={tab}\n                onClick={() => setActiveTab(tab)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-all ${\n                  activeTab === tab\n                    ? \'bg-indigo-600 text-white shadow-2xs\'\n                    : \'text-slate-600 dark:text-slate-400\'\n                }`}\n              >\n                {tab}\n              </button>\n            ))}\n          </div>\n\n          {/* Tab Views */}\n          {activeTab === \'dashboard\' && (\n            <DashboardView\n              mediaItems={mediaItems}\n              captionHistory={captionHistory}\n              user={user}\n              onConnectDrive={handleConnectDrive}\n              onOpenMediaLibrary={() => setActiveTab(\'media\')}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onOpenImportModal={() => setShowImportModal(true)}\n            />\n          )}\n\n          {activeTab === \'media\' && (\n            <MediaGrid\n              items={mediaItems}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onToggleFavorite={handleToggleFavorite}\n              onRunSmartSearch={(prompt) => setShowSmartSearch(true)}\n            />\n          )}\n\n          {activeTab === \'favorites\' && (\n            <FavoritesView\n              items={mediaItems}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onToggleFavorite={handleToggleFavorite}\n              onOpenLibrary={() => setActiveTab(\'media\')}\n            />\n          )}\n\n          {activeTab === \'captions\' && (\n            <CaptionHistoryView\n              history={captionHistory}\n              onDeleteHistoryItem={handleDeleteHistoryItem}\n            />\n          )}\n\n          {activeTab === \'settings\' && (\n            <SettingsView\n              user={user}\n              onConnectDrive={handleConnectDrive}\n              onDisconnectDrive={handleDisconnectDrive}\n              darkMode={darkMode}\n              onToggleDarkMode={() => setDarkMode(!darkMode)}\n            />\n          )}\n\n        </main>\n\n      </div>\n\n      {/* Modals */}\n      {selectedMedia && (\n        <MediaDetailModal\n          item={selectedMedia}\n          onClose={() => setSelectedMedia(null)}\n          onGenerateCaption={(item) => setCaptionMedia(item)}\n          onToggleFavorite={handleToggleFavorite}\n          onAnalyzeWithAI={handleAnalyzeWithAI}\n          isAnalyzing={isAnalyzing}\n        />\n      )}\n\n      {captionMedia && (\n        <CaptionGeneratorModal\n          media={captionMedia}\n          onClose={() => setCaptionMedia(null)}\n          onSaveToHistory={handleSaveToHistory}\n        />\n      )}\n\n      {showOnboarding && (\n        <OnboardingModal\n          onClose={() => setShowOnboarding(false)}\n          onConnectDrive={handleConnectDrive}\n        />\n      )}\n\n      {showSmartSearch && (\n        <SmartSearchModal\n          mediaList={mediaItems}\n          onClose={() => setShowSmartSearch(false)}\n          onSelectMatchedMedia={handleApplySmartSearchMatches}\n        />\n      )}\n\n      {showImportModal && (\n        <ImportMediaModal\n          onClose={() => setShowImportModal(false)}\n          onImportMedia={handleImportMedia}\n        />\n      )}\n\n    </div>\n  );\n}"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { MediaGrid } from \'./components/MediaGrid\';\nimport { FavoritesView } from \'./components/FavoritesView\';\nimport { CaptionHistoryView } from \'./components/CaptionHistoryView\';\nimport { SettingsView } from \'./components/SettingsView\';\nimport { SocialPublishView } from \'./components/SocialPublishView\';\nimport { SocialPublishModal } from \'./components/SocialPublishModal\';\nimport { MediaDetailModal } from \'./components/MediaDetailModal\';\nimport { CaptionGeneratorModal } from \'./components/CaptionGeneratorModal\';\nimport { OnboardingModal } from \'./components/OnboardingModal\';\nimport { SmartSearchModal } from \'./components/SmartSearchModal\';\nimport { ImportMediaModal } from \'./components/ImportMediaModal\';\n\nimport { ActiveTab, MediaItem, CaptionHistoryItem, User, SocialAccount, SocialPost, SocialPlatform } from \'./types\';\nimport { INITIAL_SAMPLE_MEDIA } from \'./data/sampleDriveMedia\';\n\ndeclare const google: any;\n\nexport default function App() {\n  // Theme State\n  const [darkMode, setDarkMode] = useState<boolean>(true);\n\n  // User & Drive State\n  const [user, setUser] = useState<User>({\n    id: \'usr_default_01\',\n    name: \'Blessing Esu\',\n    email: \'blessingesu3@gmail.com\',\n    avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80\',\n    isDriveConnected: true,\n    connectedDriveEmail: \'blessingesu3@gmail.com\'\n  });\n\n  // Data Stores\n  const [mediaItems, setMediaItems] = useState<MediaItem[]>(INITIAL_SAMPLE_MEDIA);\n  const [captionHistory, setCaptionHistory] = useState<CaptionHistoryItem[]>([]);\n  const [socialAccounts, setSocialAccounts] = useState<SocialAccount[]>([]);\n  const [socialPosts, setSocialPosts] = useState<SocialPost[]>([]);\n\n  // Navigation & UI State\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\'dashboard\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  // Modals\n  const [selectedMedia, setSelectedMedia] = useState<MediaItem | null>(null);\n  const [captionMedia, setCaptionMedia] = useState<MediaItem | null>(null);\n  const [showOnboarding, setShowOnboarding] = useState<boolean>(false);\n  const [showSmartSearch, setShowSmartSearch] = useState<boolean>(false);\n  const [showImportModal, setShowImportModal] = useState<boolean>(false);\n  const [isAnalyzing, setIsAnalyzing] = useState<boolean>(false);\n\n  // Social Publish Modal State\n  const [publishModalData, setPublishModalData] = useState<{\n    isOpen: boolean;\n    mediaFilename: string;\n    mediaThumbnail: string;\n    captionText: string;\n    platform: SocialPlatform;\n  } | null>(null);\n\n  // Apply dark mode class to root\n  useEffect(() => {\n    if (darkMode) {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  }, [darkMode]);\n\n  const loadSocialData = async () => {\n    try {\n      const [accRes, postRes] = await Promise.all([\n        fetch(\'/api/social/accounts\'),\n        fetch(\'/api/social/posts\')\n      ]);\n      const accData = await accRes.json();\n      const postData = await postRes.json();\n      if (accData.accounts) setSocialAccounts(accData.accounts);\n      if (postData.posts) setSocialPosts(postData.posts);\n    } catch (err) {\n      console.error(\'Failed to load social data:\', err);\n    }\n  };\n\n  // Load User, Media, Captions & Social Data on mount\n  useEffect(() => {\n    fetch(\'/api/auth/me\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.user) {\n          setUser(data.user);\n        }\n      })\n      .catch((err) => console.log(\'Auth check error:\', err));\n\n    fetch(\'/api/drive/files\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.files && data.files.length > 0) {\n          const mergedMap = new Map<string, MediaItem>();\n          INITIAL_SAMPLE_MEDIA.forEach((item) => mergedMap.set(item.id, item));\n          data.files.forEach((file: MediaItem) => mergedMap.set(file.id, file));\n          setMediaItems(Array.from(mergedMap.values()));\n        }\n      })\n      .catch((err) => console.log(\'Fetch Drive files error:\', err));\n\n    fetch(\'/api/captions/history\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.history) {\n          setCaptionHistory(data.history);\n        }\n      })\n      .catch((err) => console.log(\'Fetch captions history error:\', err));\n\n    loadSocialData();\n  }, []);\n\n  // Connect Google Drive handler with OAuth Token Client\n  const handleConnectDrive = async () => {\n    try {\n      if (typeof google !== \'undefined\' && google.accounts?.oauth2) {\n        const client = google.accounts.oauth2.initTokenClient({\n          client_id: \'\',\n          scope: \'https://www.googleapis.com/auth/drive.readonly\',\n          callback: async (response: any) => {\n            if (response.access_token) {\n              const res = await fetch(\'/api/drive/connect\', {\n                method: \'POST\',\n                headers: { \'Content-Type\': \'application/json\' },\n                body: JSON.stringify({ \n                  connectedEmail: user.email, \n                  accessToken: response.access_token \n                })\n              });\n              const data = await res.json();\n              if (data.success) {\n                setUser((prev) => ({\n                  ...prev,\n                  isDriveConnected: true,\n                  connectedDriveEmail: prev.email\n                }));\n                // Refetch Drive files from Google Drive API\n                const driveRes = await fetch(\'/api/drive/files\');\n                const driveData = await driveRes.json();\n                if (driveData.files) {\n                  setMediaItems(driveData.files);\n                }\n              }\n            }\n          },\n        });\n        client.requestAccessToken();\n      } else {\n        // Fallback simulation / server connect\n        const res = await fetch(\'/api/drive/connect\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ connectedEmail: user.email })\n        });\n        const data = await res.json();\n        if (data.success) {\n          setUser((prev) => ({\n            ...prev,\n            isDriveConnected: true,\n            connectedDriveEmail: prev.email\n          }));\n        }\n      }\n    } catch (err) {\n      console.error(\'Failed to connect Drive:\', err);\n    }\n  };\n\n  const handleDisconnectDrive = async () => {\n    try {\n      await fetch(\'/api/drive/disconnect\', { method: \'POST\' });\n      setUser((prev) => ({\n        ...prev,\n        isDriveConnected: false,\n        connectedDriveEmail: undefined\n      }));\n    } catch (err) {\n      console.error(\'Disconnect error:\', err);\n    }\n  };\n\n  // Social Account Handlers\n  const handleConnectAccount = async (platform: SocialPlatform, handle?: string, account_name?: string) => {\n    try {\n      const res = await fetch(\'/api/social/connect\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ platform, handle, account_name })\n      });\n      const data = await res.json();\n      if (data.accounts) setSocialAccounts(data.accounts);\n    } catch (err) {\n      console.error(\'Connect social account error:\', err);\n    }\n  };\n\n  const handleDisconnectAccount = async (platform: SocialPlatform) => {\n    try {\n      const res = await fetch(\'/api/social/disconnect\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ platform })\n      });\n      const data = await res.json();\n      if (data.accounts) setSocialAccounts(data.accounts);\n    } catch (err) {\n      console.error(\'Disconnect social account error:\', err);\n    }\n  };\n\n  const handleApproveAndPublishPost = async (postData: any) => {\n    const res = await fetch(\'/api/social/publish\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(postData)\n    });\n    const data = await res.json();\n    if (!res.ok) {\n      throw new Error(data.error || \'Failed to publish post\');\n    }\n    await loadSocialData();\n    return data;\n  };\n\n  // Toggle Favorite\n  const handleToggleFavorite = async (id: string, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setMediaItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, is_favorite: !item.is_favorite } : item))\n    );\n\n    try {\n      await fetch(\'/api/favorites/toggle\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ mediaId: id })\n      });\n    } catch (err) {\n      console.error(\'Favorite toggle error:\', err);\n    }\n  };\n\n  // Run AI Analysis for a file\n  const handleAnalyzeWithAI = async (item: MediaItem) => {\n    setIsAnalyzing(true);\n    try {\n      const res = await fetch(\'/api/ai/analyze\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          filename: item.filename,\n          file_type: item.file_type,\n          preview_url: item.preview_url || item.thumbnail,\n          folder: item.folder\n        })\n      });\n\n      const data = await res.json();\n      if (data.success && data.analysis) {\n        setMediaItems((prev) =>\n          prev.map((m) => (m.id === item.id ? { ...m, ai_analysis: data.analysis } : m))\n        );\n        if (selectedMedia?.id === item.id) {\n          setSelectedMedia((prev) => (prev ? { ...prev, ai_analysis: data.analysis } : null));\n        }\n      }\n    } catch (err) {\n      console.error(\'Analysis error:\', err);\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  // Save generated caption to history\n  const handleSaveToHistory = async (media: MediaItem, settings: any, variation: any) => {\n    const newItem: CaptionHistoryItem = {\n      id: `hist_${Date.now()}`,\n      media_id: media.id,\n      media_filename: media.filename,\n      media_thumbnail: media.thumbnail,\n      media_type: media.file_type,\n      platform: settings.platform,\n      tone: settings.tone,\n      length: settings.length,\n      target_audience: settings.target_audience,\n      caption_variation: variation,\n      created_at: new Date().toISOString()\n    };\n\n    setCaptionHistory((prev) => [newItem, ...prev]);\n\n    try {\n      await fetch(\'/api/captions/history\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ item: newItem })\n      });\n    } catch (err) {\n      console.error(\'Save caption history error:\', err);\n    }\n  };\n\n  // Delete caption history\n  const handleDeleteHistoryItem = async (id: string) => {\n    setCaptionHistory((prev) => prev.filter((i) => i.id !== id));\n    try {\n      await fetch(`/api/captions/history/${id}`, { method: \'DELETE\' });\n    } catch (err) {\n      console.error(\'Delete history item error:\', err);\n    }\n  };\n\n  // Custom Media Import\n  const handleImportMedia = async (mediaData: any) => {\n    try {\n      const res = await fetch(\'/api/drive/import\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(mediaData)\n      });\n      const data = await res.json();\n      if (data.success && data.media) {\n        setMediaItems((prev) => [data.media, ...prev]);\n        setActiveTab(\'media\');\n      }\n    } catch (err) {\n      console.error(\'Import error:\', err);\n    }\n  };\n\n  const handleApplySmartSearchMatches = (matchedList: MediaItem[]) => {\n    setActiveTab(\'media\');\n  };\n\n  const favoritesCount = mediaItems.filter((i) => i.is_favorite).length;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans transition-colors\">\n      \n      {/* Top Navbar */}\n      <Navbar\n        user={user}\n        onConnectDrive={handleConnectDrive}\n        darkMode={darkMode}\n        onToggleDarkMode={() => setDarkMode(!darkMode)}\n        searchQuery={searchQuery}\n        onSearchChange={setSearchQuery}\n        onOpenImportModal={() => setShowImportModal(true)}\n        onOpenSmartSearch={() => setShowSmartSearch(true)}\n        activeTab={activeTab}\n      />\n\n      {/* Main Layout */}\n      <div className=\"max-w-7xl mx-auto flex\">\n        \n        {/* Sidebar Navigation */}\n        <Sidebar\n          activeTab={activeTab}\n          onSelectTab={setActiveTab}\n          user={user}\n          onConnectDrive={handleConnectDrive}\n          favoritesCount={favoritesCount}\n          captionsCount={captionHistory.length}\n        />\n\n        {/* Content Area */}\n        <main className=\"flex-1 p-4 sm:p-6 md:p-8 min-w-0\">\n          \n          {/* Mobile Tab Pills Bar */}\n          <div className=\"flex md:hidden items-center gap-1.5 p-1 mb-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-x-auto\">\n            {([\'dashboard\', \'media\', \'social\', \'favorites\', \'captions\', \'settings\'] as ActiveTab[]).map((tab) => (\n              <button\n                key={tab}\n                onClick={() => setActiveTab(tab)}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-all ${\n                  activeTab === tab\n                    ? \'bg-indigo-600 text-white shadow-2xs\'\n                    : \'text-slate-600 dark:text-slate-400\'\n                }`}\n              >\n                {tab === \'social\' ? \'Social\' : tab}\n              </button>\n            ))}\n          </div>\n\n          {/* Tab Views */}\n          {activeTab === \'dashboard\' && (\n            <DashboardView\n              mediaItems={mediaItems}\n              captionHistory={captionHistory}\n              user={user}\n              onConnectDrive={handleConnectDrive}\n              onOpenMediaLibrary={() => setActiveTab(\'media\')}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onOpenImportModal={() => setShowImportModal(true)}\n            />\n          )}\n\n          {activeTab === \'media\' && (\n            <MediaGrid\n              items={mediaItems}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onToggleFavorite={handleToggleFavorite}\n              onRunSmartSearch={(prompt) => setShowSmartSearch(true)}\n            />\n          )}\n\n          {activeTab === \'social\' && (\n            <SocialPublishView\n              socialAccounts={socialAccounts}\n              socialPosts={socialPosts}\n              onConnectAccount={handleConnectAccount}\n              onDisconnectAccount={handleDisconnectAccount}\n              onApproveAndPublishPost={handleApproveAndPublishPost}\n              onRefreshPosts={loadSocialData}\n            />\n          )}\n\n          {activeTab === \'favorites\' && (\n            <FavoritesView\n              items={mediaItems}\n              onSelectMedia={(item) => setSelectedMedia(item)}\n              onGenerateCaption={(item) => setCaptionMedia(item)}\n              onToggleFavorite={handleToggleFavorite}\n              onOpenLibrary={() => setActiveTab(\'media\')}\n            />\n          )}\n\n          {activeTab === \'captions\' && (\n            <CaptionHistoryView\n              history={captionHistory}\n              onDeleteHistoryItem={handleDeleteHistoryItem}\n              onOpenPublishModal={(data) => setPublishModalData({ ...data, isOpen: true })}\n            />\n          )}\n\n          {activeTab === \'settings\' && (\n            <SettingsView\n              user={user}\n              onConnectDrive={handleConnectDrive}\n              onDisconnectDrive={handleDisconnectDrive}\n              darkMode={darkMode}\n              onToggleDarkMode={() => setDarkMode(!darkMode)}\n            />\n          )}\n\n        </main>\n\n      </div>\n\n      {/* Modals */}\n      {selectedMedia && (\n        <MediaDetailModal\n          item={selectedMedia}\n          onClose={() => setSelectedMedia(null)}\n          onGenerateCaption={(item) => setCaptionMedia(item)}\n          onToggleFavorite={handleToggleFavorite}\n          onAnalyzeWithAI={handleAnalyzeWithAI}\n          isAnalyzing={isAnalyzing}\n        />\n      )}\n\n      {captionMedia && (\n        <CaptionGeneratorModal\n          media={captionMedia}\n          onClose={() => setCaptionMedia(null)}\n          onSaveToHistory={handleSaveToHistory}\n          onOpenPublishModal={(data) => setPublishModalData({ ...data, isOpen: true })}\n        />\n      )}\n\n      {publishModalData && publishModalData.isOpen && (\n        <SocialPublishModal\n          isOpen={publishModalData.isOpen}\n          onClose={() => setPublishModalData(null)}\n          mediaFilename={publishModalData.mediaFilename}\n          mediaThumbnail={publishModalData.mediaThumbnail}\n          captionText={publishModalData.captionText}\n          platform={publishModalData.platform}\n          connectedAccounts={socialAccounts}\n          onPublish={handleApproveAndPublishPost}\n        />\n      )}\n\n      {showOnboarding && (\n        <OnboardingModal\n          onClose={() => setShowOnboarding(false)}\n          onConnectDrive={handleConnectDrive}\n        />\n      )}\n\n      {showSmartSearch && (\n        <SmartSearchModal\n          mediaList={mediaItems}\n          onClose={() => setShowSmartSearch(false)}\n          onSelectMatchedMedia={handleApplySmartSearchMatches}\n        />\n      )}\n\n      {showImportModal && (\n        <ImportMediaModal\n          onClose={() => setShowImportModal(false)}\n          onImportMedia={handleImportMedia}\n        />\n      )}\n\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
