    instruction: "Update SocialPublishView.tsx to use #2563EB accent blue, 18px rounded cards, 12px rounded buttons, and Linear design principles."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Send, \n  CheckCircle2, \n  ShieldCheck, \n  Clock, \n  PlusCircle, \n  ExternalLink, \n  Instagram, \n  Linkedin, \n  Twitter, \n  Facebook,\n  RefreshCw,\n  Sparkles,\n  Key,\n  Info,\n  SlidersHorizontal,\n  Lock\n} from \'lucide-react\';\nimport { SocialAccount, SocialPost, SocialPlatform } from \'../types\';\n\ninterface SocialPublishViewProps {\n  socialAccounts: SocialAccount[];\n  socialPosts: SocialPost[];\n  onConnectAccount: (platform: SocialPlatform, handle?: string, account_name?: string) => Promise<void>;\n  onDisconnectAccount: (platform: SocialPlatform) => Promise<void>;\n  onApproveAndPublishPost: (postData: any) => Promise<void>;\n  onRefreshPosts: () => Promise<void>;\n}\n\nexport const SocialPublishView: React.FC<SocialPublishViewProps> = ({\n  socialAccounts,\n  socialPosts,\n  onConnectAccount,\n  onDisconnectAccount,\n  onApproveAndPublishPost,\n  onRefreshPosts\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<\'accounts\' | \'queue\' | \'history\' | \'oauth_guide\'>(\'accounts\');\n  const [isConnecting, setIsConnecting] = useState<string | null>(null);\n  const [connectModalPlatform, setConnectModalPlatform] = useState<SocialPlatform | null>(null);\n  const [showCredentialsModal, setShowCredentialsModal] = useState<boolean>(false);\n  const [customHandle, setCustomHandle] = useState<string>(\'\');\n  const [customPageName, setCustomPageName] = useState<string>(\'\');\n  const [publishingPostId, setPublishingPostId] = useState<string | null>(null);\n\n  // Credentials State\n  const [apiKeys, setApiKeys] = useState<Record<string, { clientId: string; clientSecret: string }>>({\n    Instagram: { clientId: \'\', clientSecret: \'\' },\n    LinkedIn: { clientId: \'\', clientSecret: \'\' },\n    X: { clientId: \'\', clientSecret: \'\' },\n    Facebook: { clientId: \'\', clientSecret: \'\' }\n  });\n  const [selectedCredPlatform, setSelectedCredPlatform] = useState<SocialPlatform>(\'LinkedIn\');\n  const [savedKeyStatus, setSavedKeyStatus] = useState<boolean>(false);\n\n  // Fetch credentials on mount\n  useEffect(() => {\n    fetch(\'/api/social/accounts\')\n      .then(r => r.json())\n      .then(data => {\n        if (data.credentials) setApiKeys(data.credentials);\n      })\n      .catch(console.error);\n  }, []);\n\n  // OAuth postMessage event listener per oauth-integration skill\n  useEffect(() => {\n    const handleMessage = (event: MessageEvent) => {\n      const origin = event.origin;\n      if (!origin.endsWith(\'.run.app\') && !origin.includes(\'localhost\')) {\n        return;\n      }\n      if (event.data?.type === \'OAUTH_AUTH_SUCCESS\') {\n        const plat = (event.data.platform as SocialPlatform) || \'LinkedIn\';\n        onConnectAccount(plat, `@${plat.toLowerCase()}_official`, `${plat} Creator Page`);\n      }\n    };\n    window.addEventListener(\'message\', handleMessage);\n    return () => window.removeEventListener(\'message\', handleMessage);\n  }, [onConnectAccount]);\n\n  const getPlatformIcon = (plat: SocialPlatform) => {\n    switch (plat) {\n      case \'Instagram\': return <Instagram className=\"w-5 h-5 text-gray-900 dark:text-white\" />;\n      case \'LinkedIn\': return <Linkedin className=\"w-5 h-5 text-gray-900 dark:text-white\" />;\n      case \'X\': return <Twitter className=\"w-5 h-5 text-gray-900 dark:text-white\" />;\n      case \'Facebook\': return <Facebook className=\"w-5 h-5 text-gray-900 dark:text-white\" />;\n      default: return <Send className=\"w-5 h-5 text-indigo-600\" />;\n    }\n  };\n\n  // Launch Real OAuth Authorization Popup\n  const handleLaunchOAuthPopup = async (plat: SocialPlatform) => {\n    setIsConnecting(plat);\n    try {\n      const res = await fetch(`/api/social/oauth/url?platform=${plat}`);\n      const data = await res.json();\n      \n      if (data.url) {\n        const popup = window.open(\n          data.url,\n          \'social_oauth_popup\',\n          \'width=600,height=700,scrollbars=yes,resizable=yes\'\n        );\n        if (!popup) {\n          alert(\'Popup was blocked. Please allow popups to authorize your social media account.\');\n        }\n      }\n    } catch (err) {\n      console.error(\'OAuth URL error:\', err);\n    } finally {\n      setIsConnecting(null);\n    }\n  };\n\n  const handleOpenConnect = (plat: SocialPlatform) => {\n    setConnectModalPlatform(plat);\n    setCustomHandle(`@${plat.toLowerCase()}_creator`);\n    setCustomPageName(`${plat} Creator Page`);\n  };\n\n  const handleConfirmConnect = async () => {\n    if (!connectModalPlatform) return;\n    setIsConnecting(connectModalPlatform);\n    try {\n      await onConnectAccount(connectModalPlatform, customHandle, customPageName);\n      setConnectModalPlatform(null);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsConnecting(null);\n    }\n  };\n\n  const handleSaveCredentials = async () => {\n    try {\n      const current = apiKeys[selectedCredPlatform];\n      await fetch(\'/api/social/credentials\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          platform: selectedCredPlatform,\n          clientId: current.clientId,\n          clientSecret: current.clientSecret\n        })\n      });\n      setSavedKeyStatus(true);\n      setTimeout(() => setSavedKeyStatus(false), 2000);\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  const handlePublishQueuedPost = async (post: SocialPost) => {\n    setPublishingPostId(post.id);\n    try {\n      await onApproveAndPublishPost({\n        media_filename: post.media_filename,\n        media_thumbnail: post.media_thumbnail,\n        platform: post.platform,\n        account_handle: post.account_handle,\n        caption_text: post.caption_text,\n        user_approved: true\n      });\n      await onRefreshPosts();\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setPublishingPostId(null);\n    }\n  };\n\n  const pendingPosts = socialPosts.filter(p => p.status === \'pending_approval\' || p.status === \'draft\');\n  const publishedPosts = socialPosts.filter(p => p.status === \'published\' || p.status === \'approved\');\n  const currentDevUrl = typeof window !== \'undefined\' ? `${window.location.origin}/api/social/oauth/callback` : \'\';\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Monochromatic Header Banner */}\n      <div className=\"p-6 rounded-2xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n          <div className=\"space-y-1.5 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 text-[11px] font-semibold border border-indigo-100 dark:border-indigo-900/50 uppercase tracking-wider\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400\" />\n              <span>User-Approved Social Publishing</span>\n            </div>\n            <h1 className=\"text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white\">\n              Social Media Accounts & Publishing\n            </h1>\n            <p className=\"text-xs text-gray-600 dark:text-slate-400 leading-relaxed\">\n              Connect real social media accounts via OAuth or API credentials. Captions are only published live after your explicit review and approval.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => setShowCredentialsModal(true)}\n              className=\"px-3.5 py-2 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Key className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400\" />\n              <span>OAuth API Keys</span>\n            </button>\n\n            <button\n              onClick={onRefreshPosts}\n              className=\"px-3.5 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white flex items-center gap-1.5 shadow-xs transition-transform active:scale-95 cursor-pointer\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span>Sync Posts</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Clean Navigation Sub Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-gray-200 dark:border-slate-800 pb-3\">\n        <button\n          onClick={() => setActiveSubTab(\'accounts\')}\n          className={`px-4 py-2 rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'accounts\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Send className=\"w-4 h-4\" />\n          <span>Connected Accounts ({socialAccounts.filter(a => a.is_connected).length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'queue\')}\n          className={`px-4 py-2 rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'queue\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Clock className=\"w-4 h-4\" />\n          <span>Approval Queue ({pendingPosts.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'history\')}\n          className={`px-4 py-2 rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'history\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <CheckCircle2 className=\"w-4 h-4\" />\n          <span>Published Posts ({publishedPosts.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'oauth_guide\')}\n          className={`px-4 py-2 rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'oauth_guide\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-900 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Info className=\"w-4 h-4\" />\n          <span>OAuth Requirements & Guide</span>\n        </button>\n      </div>\n\n      {/* SUB TAB 1: CONNECTED ACCOUNTS */}\n      {activeSubTab === \'accounts\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {([\'Instagram\', \'LinkedIn\', \'X\', \'Facebook\'] as SocialPlatform[]).map((plat) => {\n            const acc = socialAccounts.find(a => a.platform === plat);\n            const isConnected = acc?.is_connected;\n            const hasKeys = Boolean(apiKeys[plat]?.clientId);\n\n            return (\n              <div\n                key={plat}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 shadow-xs flex flex-col justify-between space-y-4\"\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-3 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700\">\n                      {getPlatformIcon(plat)}\n                    </div>\n                    <div>\n                      <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                        <span>{plat}</span>\n                        <span className={`text-[10px] font-semibold px-2 py-0.5 rounded ${\n                          isConnected \n                            ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800\' \n                            : \'bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-slate-400 border border-gray-200 dark:border-slate-700\'\n                        }`}>\n                          {isConnected ? \'Connected\' : \'Not Connected\'}\n                        </span>\n                      </h3>\n                      <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                        {acc?.page_type || `${plat} Developer API Page`}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {isConnected && acc ? (\n                  <div className=\"p-3.5 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <img src={acc.avatar} alt={acc.account_name} className=\"w-8 h-8 rounded-full object-cover\" />\n                      <div>\n                        <p className=\"text-xs font-bold text-gray-900 dark:text-white\">{acc.account_name}</p>\n                        <p className=\"text-[10px] text-gray-500 dark:text-slate-400\">{acc.handle}</p>\n                      </div>\n                    </div>\n                    <button\n                      onClick={() => onDisconnectAccount(plat)}\n                      className=\"px-3 py-1 rounded text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer\"\n                    >\n                      Disconnect\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"p-3.5 rounded-lg bg-gray-50 dark:bg-slate-800/40 border border-dashed border-gray-300 dark:border-slate-700 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n                    <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                      {hasKeys ? \'Custom Client ID configured\' : \'Connect via OAuth popup or custom handle\'}\n                    </p>\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => handleLaunchOAuthPopup(plat)}\n                        disabled={isConnecting === plat}\n                        className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center gap-1 transition-transform active:scale-95 cursor-pointer disabled:opacity-50\"\n                      >\n                        <Lock className=\"w-3 h-3\" />\n                        <span>OAuth Popup</span>\n                      </button>\n                      \n                      <button\n                        onClick={() => handleOpenConnect(plat)}\n                        className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-200 dark:bg-slate-700 hover:bg-gray-300 dark:hover:bg-slate-600 text-gray-800 dark:text-slate-200 flex items-center gap-1 cursor-pointer\"\n                      >\n                        <PlusCircle className=\"w-3 h-3\" />\n                        <span>Link Account</span>\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* SUB TAB 2: APPROVAL QUEUE */}\n      {activeSubTab === \'queue\' && (\n        <div className=\"space-y-4\">\n          {pendingPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 space-y-3\">\n              <div className=\"w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 mx-auto flex items-center justify-center\">\n                <CheckCircle2 className=\"w-6 h-6\" />\n              </div>\n              <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">No Pending Approvals</h3>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-md mx-auto\">\n                Generate captions from your Drive media library and click \"Post to Social\" to queue posts here for review and authorization.\n              </p>\n            </div>\n          ) : (\n            pendingPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 shadow-xs space-y-4\"\n              >\n                <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 text-[10px] font-semibold border border-amber-200 dark:border-amber-900/50 flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3\" />\n                      Awaiting Approval\n                    </span>\n                    <span className=\"text-xs font-bold text-gray-900 dark:text-white flex items-center gap-1\">\n                      {getPlatformIcon(post.platform)}\n                      <span>{post.platform}</span>\n                    </span>\n                    <span className=\"text-xs text-gray-400\">\342\200\242</span>\n                    <span className=\"text-xs text-gray-500 dark:text-slate-400\">{post.account_handle}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => handlePublishQueuedPost(post)}\n                      disabled={publishingPostId === post.id}\n                      className=\"px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold flex items-center gap-1.5 shadow-xs cursor-pointer disabled:opacity-50\"\n                    >\n                      {publishingPostId === post.id ? (\n                        <>\n                          <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                          <span>Publishing...</span>\n                        </>\n                      ) : (\n                        <>\n                          <Send className=\"w-3.5 h-3.5\" />\n                          <span>Approve & Post Now</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-16 h-16 rounded-lg object-cover shrink-0\"\n                  />\n                  <div className=\"flex-1 min-w-0 space-y-1\">\n                    <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                      {post.media_filename}\n                    </p>\n                    <p className=\"text-xs text-gray-700 dark:text-slate-300 whitespace-pre-wrap line-clamp-3 leading-relaxed\">\n                      {post.caption_text}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* SUB TAB 3: PUBLISHED HISTORY */}\n      {activeSubTab === \'history\' && (\n        <div className=\"space-y-4\">\n          {publishedPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 text-xs text-gray-500\">\n              No published posts yet.\n            </div>\n          ) : (\n            publishedPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 shadow-xs space-y-3\"\n              >\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-semibold text-[10px] flex items-center gap-1\">\n                      <CheckCircle2 className=\"w-3 h-3\" />\n                      Published\n                    </span>\n                    <span className=\"text-gray-300\">\342\200\242</span>\n                    <span className=\"font-bold text-gray-900 dark:text-white\">{post.platform} ({post.account_handle})</span>\n                  </div>\n\n                  {post.post_url && (\n                    <a\n                      href={post.post_url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1\"\n                    >\n                      <span>View Post</span>\n                      <ExternalLink className=\"w-3.5 h-3.5\" />\n                    </a>\n                  )}\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-14 h-14 rounded-lg object-cover shrink-0\"\n                  />\n                  <p className=\"text-xs text-gray-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed line-clamp-3\">\n                    {post.caption_text}\n                  </p>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* SUB TAB 4: OAUTH REQUIREMENTS GUIDE */}\n      {activeSubTab === \'oauth_guide\' && (\n        <div className=\"p-6 rounded-xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 space-y-5\">\n          <div>\n            <h2 className=\"text-base font-bold text-gray-900 dark:text-white mb-1\">\n              Requirements for Connecting Real Social Media Accounts\n            </h2>\n            <p className=\"text-xs text-gray-600 dark:text-slate-400\">\n              To publish posts directly to your actual social accounts via official developer APIs, you need to register a Developer Application on each platform console:\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n            <div className=\"p-4 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Instagram className=\"w-4 h-4 text-pink-600\" />\n                <span>Meta / Instagram Graph API</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400\">\n                Create an app on <a href=\"https://developers.facebook.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-indigo-600 underline\">developers.facebook.com</a> with Instagram Content Publishing permissions.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Linkedin className=\"w-4 h-4 text-blue-600\" />\n                <span>LinkedIn Developer Portal</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400\">\n                Register an app on <a href=\"https://www.linkedin.com/developers\" target=\"_blank\" rel=\"noreferrer\" className=\"text-indigo-600 underline\">linkedin.com/developers</a> and request Share on LinkedIn access (`w_member_social`).\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Twitter className=\"w-4 h-4 text-gray-900 dark:text-white\" />\n                <span>X / Twitter Developer Portal</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400\">\n                Create a project in <a href=\"https://developer.twitter.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-indigo-600 underline\">developer.twitter.com</a> with Read and Write permissions enabled.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Facebook className=\"w-4 h-4 text-blue-700\" />\n                <span>Facebook Pages API</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400\">\n                Obtain a Page Access Token with `pages_manage_posts` permission.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* API KEYS / CREDENTIALS MODAL */}\n      {showCredentialsModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl w-full max-w-lg p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between border-b border-gray-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <Key className=\"w-4 h-4 text-indigo-600 dark:text-indigo-400\" />\n                <span>Configure Social OAuth Client Keys</span>\n              </h3>\n              <button onClick={() => setShowCredentialsModal(false)} className=\"text-gray-400 hover:text-gray-600 cursor-pointer text-sm\">\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-1.5 p-1 bg-gray-100 dark:bg-slate-800 rounded-lg\">\n                {([\'LinkedIn\', \'Instagram\', \'X\', \'Facebook\'] as SocialPlatform[]).map(plat => (\n                  <button\n                    key={plat}\n                    onClick={() => setSelectedCredPlatform(plat)}\n                    className={`flex-1 py-1.5 text-xs font-semibold rounded-md transition-colors cursor-pointer ${\n                      selectedCredPlatform === plat \n                        ? \'bg-white dark:bg-slate-900 text-gray-900 dark:text-white shadow-xs\'\n                        : \'text-gray-600 dark:text-slate-400\'\n                    }`}\n                  >\n                    {plat}\n                  </button>\n                ))}\n              </div>\n\n              <div className=\"space-y-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                    {selectedCredPlatform} Client ID / App ID\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder={`Enter ${selectedCredPlatform} Client ID`}\n                    value={apiKeys[selectedCredPlatform]?.clientId || \'\'}\n                    onChange={(e) => setApiKeys({\n                      ...apiKeys,\n                      [selectedCredPlatform]: {\n                        ...apiKeys[selectedCredPlatform],\n                        clientId: e.target.value\n                      }\n                    })}\n                    className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                    {selectedCredPlatform} Client Secret\n                  </label>\n                  <input\n                    type=\"password\"\n                    placeholder={`Enter ${selectedCredPlatform} Client Secret`}\n                    value={apiKeys[selectedCredPlatform]?.clientSecret || \'\'}\n                    onChange={(e) => setApiKeys({\n                      ...apiKeys,\n                      [selectedCredPlatform]: {\n                        ...apiKeys[selectedCredPlatform],\n                        clientSecret: e.target.value\n                      }\n                    })}\n                    className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                  />\n                </div>\n\n                <div className=\"p-3 rounded-lg bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 text-[11px] text-gray-600 dark:text-slate-400 space-y-1\">\n                  <p className=\"font-semibold text-gray-900 dark:text-white\">Redirect URI for developer console:</p>\n                  <code className=\"block p-1.5 bg-gray-100 dark:bg-slate-900 rounded font-mono break-all\">{currentDevUrl}</code>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-between pt-2 border-t border-gray-200 dark:border-slate-800\">\n              <span className=\"text-xs text-emerald-600 font-semibold\">\n                {savedKeyStatus ? \'Credentials Saved!\' : \'\'}\n              </span>\n              <div className=\"flex gap-2\">\n                <button\n                  onClick={() => setShowCredentialsModal(false)}\n                  className=\"px-4 py-2 rounded-lg text-xs font-semibold text-gray-600 dark:text-slate-300 cursor-pointer\"\n                >\n                  Close\n                </button>\n                <button\n                  onClick={handleSaveCredentials}\n                  className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer\"\n                >\n                  Save Keys\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* LINK PAGE MODAL */}\n      {connectModalPlatform && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between border-b border-gray-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                {getPlatformIcon(connectModalPlatform)}\n                <span>Link {connectModalPlatform} Page</span>\n              </h3>\n              <button onClick={() => setConnectModalPlatform(null)} className=\"text-gray-400 hover:text-gray-600 cursor-pointer text-sm\">\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Page / Profile Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={customPageName}\n                  onChange={(e) => setCustomPageName(e.target.value)}\n                  className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Handle / Username\n                </label>\n                <input\n                  type=\"text\"\n                  value={customHandle}\n                  onChange={(e) => setCustomHandle(e.target.value)}\n                  className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2 pt-2 border-t border-gray-200 dark:border-slate-800\">\n              <button\n                onClick={() => setConnectModalPlatform(null)}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold text-gray-600 dark:text-slate-300 cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmConnect}\n                disabled={isConnecting !== null}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer\"\n              >\n                {isConnecting ? \'Connecting...\' : \'Authorize & Connect\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Send, \n  CheckCircle2, \n  ShieldCheck, \n  Clock, \n  PlusCircle, \n  ExternalLink, \n  Instagram, \n  Linkedin, \n  Twitter, \n  Facebook,\n  RefreshCw,\n  Sparkles,\n  Key,\n  Info,\n  Lock\n} from \'lucide-react\';\nimport { SocialAccount, SocialPost, SocialPlatform } from \'../types\';\n\ninterface SocialPublishViewProps {\n  socialAccounts: SocialAccount[];\n  socialPosts: SocialPost[];\n  onConnectAccount: (platform: SocialPlatform, handle?: string, account_name?: string) => Promise<void>;\n  onDisconnectAccount: (platform: SocialPlatform) => Promise<void>;\n  onApproveAndPublishPost: (postData: any) => Promise<void>;\n  onRefreshPosts: () => Promise<void>;\n}\n\nexport const SocialPublishView: React.FC<SocialPublishViewProps> = ({\n  socialAccounts,\n  socialPosts,\n  onConnectAccount,\n  onDisconnectAccount,\n  onApproveAndPublishPost,\n  onRefreshPosts\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<\'accounts\' | \'queue\' | \'history\' | \'oauth_guide\'>(\'accounts\');\n  const [isConnecting, setIsConnecting] = useState<string | null>(null);\n  const [connectModalPlatform, setConnectModalPlatform] = useState<SocialPlatform | null>(null);\n  const [showCredentialsModal, setShowCredentialsModal] = useState<boolean>(false);\n  const [customHandle, setCustomHandle] = useState<string>(\'\');\n  const [customPageName, setCustomPageName] = useState<string>(\'\');\n  const [publishingPostId, setPublishingPostId] = useState<string | null>(null);\n\n  // Credentials State\n  const [apiKeys, setApiKeys] = useState<Record<string, { clientId: string; clientSecret: string }>>({\n    Instagram: { clientId: \'\', clientSecret: \'\' },\n    LinkedIn: { clientId: \'\', clientSecret: \'\' },\n    X: { clientId: \'\', clientSecret: \'\' },\n    Facebook: { clientId: \'\', clientSecret: \'\' }\n  });\n  const [selectedCredPlatform, setSelectedCredPlatform] = useState<SocialPlatform>(\'LinkedIn\');\n  const [savedKeyStatus, setSavedKeyStatus] = useState<boolean>(false);\n\n  // Fetch credentials on mount\n  useEffect(() => {\n    fetch(\'/api/social/accounts\')\n      .then(r => r.json())\n      .then(data => {\n        if (data.credentials) setApiKeys(data.credentials);\n      })\n      .catch(console.error);\n  }, []);\n\n  // OAuth postMessage event listener\n  useEffect(() => {\n    const handleMessage = (event: MessageEvent) => {\n      const origin = event.origin;\n      if (!origin.endsWith(\'.run.app\') && !origin.includes(\'localhost\')) {\n        return;\n      }\n      if (event.data?.type === \'OAUTH_AUTH_SUCCESS\') {\n        const plat = (event.data.platform as SocialPlatform) || \'LinkedIn\';\n        onConnectAccount(plat, `@${plat.toLowerCase()}_official`, `${plat} Creator Page`);\n      }\n    };\n    window.addEventListener(\'message\', handleMessage);\n    return () => window.removeEventListener(\'message\', handleMessage);\n  }, [onConnectAccount]);\n\n  const getPlatformIcon = (plat: SocialPlatform) => {\n    switch (plat) {\n      case \'Instagram\': return <Instagram className=\"w-5 h-5 text-gray-900 dark:text-white\" strokeWidth={1.75} />;\n      case \'LinkedIn\': return <Linkedin className=\"w-5 h-5 text-gray-900 dark:text-white\" strokeWidth={1.75} />;\n      case \'X\': return <Twitter className=\"w-5 h-5 text-gray-900 dark:text-white\" strokeWidth={1.75} />;\n      case \'Facebook\': return <Facebook className=\"w-5 h-5 text-gray-900 dark:text-white\" strokeWidth={1.75} />;\n      default: return <Send className=\"w-5 h-5 text-blue-600\" strokeWidth={1.75} />;\n    }\n  };\n\n  // Launch Real OAuth Authorization Popup\n  const handleLaunchOAuthPopup = async (plat: SocialPlatform) => {\n    setIsConnecting(plat);\n    try {\n      const res = await fetch(`/api/social/oauth/url?platform=${plat}`);\n      const data = await res.json();\n      \n      if (data.url) {\n        const popup = window.open(\n          data.url,\n          \'social_oauth_popup\',\n          \'width=600,height=700,scrollbars=yes,resizable=yes\'\n        );\n        if (!popup) {\n          alert(\'Popup was blocked. Please allow popups to authorize your social media account.\');\n        }\n      }\n    } catch (err) {\n      console.error(\'OAuth URL error:\', err);\n    } finally {\n      setIsConnecting(null);\n    }\n  };\n\n  const handleOpenConnect = (plat: SocialPlatform) => {\n    setConnectModalPlatform(plat);\n    setCustomHandle(`@${plat.toLowerCase()}_creator`);\n    setCustomPageName(`${plat} Creator Page`);\n  };\n\n  const handleConfirmConnect = async () => {\n    if (!connectModalPlatform) return;\n    setIsConnecting(connectModalPlatform);\n    try {\n      await onConnectAccount(connectModalPlatform, customHandle, customPageName);\n      setConnectModalPlatform(null);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsConnecting(null);\n    }\n  };\n\n  const handleSaveCredentials = async () => {\n    try {\n      const current = apiKeys[selectedCredPlatform];\n      await fetch(\'/api/social/credentials\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          platform: selectedCredPlatform,\n          clientId: current.clientId,\n          clientSecret: current.clientSecret\n        })\n      });\n      setSavedKeyStatus(true);\n      setTimeout(() => setSavedKeyStatus(false), 2000);\n    } catch (err) {\n      console.error(err);\n    }\n  };\n\n  const handlePublishQueuedPost = async (post: SocialPost) => {\n    setPublishingPostId(post.id);\n    try {\n      await onApproveAndPublishPost({\n        media_filename: post.media_filename,\n        media_thumbnail: post.media_thumbnail,\n        platform: post.platform,\n        account_handle: post.account_handle,\n        caption_text: post.caption_text,\n        user_approved: true\n      });\n      await onRefreshPosts();\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setPublishingPostId(null);\n    }\n  };\n\n  const pendingPosts = socialPosts.filter(p => p.status === \'pending_approval\' || p.status === \'draft\');\n  const publishedPosts = socialPosts.filter(p => p.status === \'published\' || p.status === \'approved\');\n  const currentDevUrl = typeof window !== \'undefined\' ? `${window.location.origin}/api/social/oauth/callback` : \'\';\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header Banner */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n          <div className=\"space-y-1.5 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 text-[11px] font-semibold border border-blue-100 dark:border-blue-900/50 uppercase tracking-wider\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n              <span>Verified Publishing</span>\n            </div>\n            <h1 className=\"text-2xl font-bold tracking-tight text-gray-900 dark:text-white\">\n              Social Media Accounts\n            </h1>\n            <p className=\"text-xs text-gray-500 dark:text-slate-400 leading-relaxed\">\n              Connect real social media channels via OAuth or API credentials. Review and approve captions before live publication.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => setShowCredentialsModal(true)}\n              className=\"px-3.5 h-9 rounded-xl text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <Key className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n              <span>OAuth API Keys</span>\n            </button>\n\n            <button\n              onClick={onRefreshPosts}\n              className=\"px-3.5 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white flex items-center gap-1.5 shadow-xs transition-transform active:scale-95 cursor-pointer\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n              <span>Sync Posts</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Clean Navigation Sub Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-gray-200 dark:border-slate-800 pb-3\">\n        <button\n          onClick={() => setActiveSubTab(\'accounts\')}\n          className={`px-4 py-2 rounded-xl text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'accounts\'\n              ? \'bg-blue-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Send className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n          <span>Connected Channels ({socialAccounts.filter(a => a.is_connected).length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'queue\')}\n          className={`px-4 py-2 rounded-xl text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'queue\'\n              ? \'bg-blue-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Clock className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n          <span>Approval Queue ({pendingPosts.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'history\')}\n          className={`px-4 py-2 rounded-xl text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'history\'\n              ? \'bg-blue-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <CheckCircle2 className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n          <span>Published Posts ({publishedPosts.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'oauth_guide\')}\n          className={`px-4 py-2 rounded-xl text-xs font-semibold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'oauth_guide\'\n              ? \'bg-blue-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n          }`}\n        >\n          <Info className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n          <span>OAuth Guide</span>\n        </button>\n      </div>\n\n      {/* SUB TAB 1: CONNECTED ACCOUNTS */}\n      {activeSubTab === \'accounts\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {([\'Instagram\', \'LinkedIn\', \'X\', \'Facebook\'] as SocialPlatform[]).map((plat) => {\n            const acc = socialAccounts.find(a => a.platform === plat);\n            const isConnected = acc?.is_connected;\n            const hasKeys = Boolean(apiKeys[plat]?.clientId);\n\n            return (\n              <div\n                key={plat}\n                className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex flex-col justify-between space-y-4\"\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-3 rounded-xl bg-gray-50 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-700\">\n                      {getPlatformIcon(plat)}\n                    </div>\n                    <div>\n                      <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                        <span>{plat}</span>\n                        <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${\n                          isConnected \n                            ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800\' \n                            : \'bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-slate-400 border border-gray-200 dark:border-slate-700\'\n                        }`}>\n                          {isConnected ? \'Connected\' : \'Not Connected\'}\n                        </span>\n                      </h3>\n                      <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                        {acc?.page_type || `${plat} Developer API Channel`}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {isConnected && acc ? (\n                  <div className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <img src={acc.avatar} alt={acc.account_name} className=\"w-8 h-8 rounded-full object-cover\" />\n                      <div>\n                        <p className=\"text-xs font-bold text-gray-900 dark:text-white\">{acc.account_name}</p>\n                        <p className=\"text-[10px] text-gray-500 dark:text-slate-400\">{acc.handle}</p>\n                      </div>\n                    </div>\n                    <button\n                      onClick={() => onDisconnectAccount(plat)}\n                      className=\"px-3 py-1 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer\"\n                    >\n                      Disconnect\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/40 border border-dashed border-gray-300 dark:border-slate-700 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n                    <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                      {hasKeys ? \'Custom Client ID configured\' : \'Connect via OAuth popup or custom handle\'}\n                    </p>\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => handleLaunchOAuthPopup(plat)}\n                        disabled={isConnecting === plat}\n                        className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center gap-1.5 transition-all cursor-pointer disabled:opacity-50\"\n                      >\n                        <Lock className=\"w-3 h-3\" />\n                        <span>OAuth Popup</span>\n                      </button>\n                      \n                      <button\n                        onClick={() => handleOpenConnect(plat)}\n                        className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                      >\n                        <PlusCircle className=\"w-3 h-3\" />\n                        <span>Link Account</span>\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* SUB TAB 2: APPROVAL QUEUE */}\n      {activeSubTab === \'queue\' && (\n        <div className=\"space-y-4\">\n          {pendingPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 space-y-3\">\n              <div className=\"w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 mx-auto flex items-center justify-center\">\n                <CheckCircle2 className=\"w-6 h-6\" strokeWidth={1.75} />\n              </div>\n              <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">No Pending Approvals</h3>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-md mx-auto leading-relaxed\">\n                Generate captions from your media library and click \"Post to Social\" to queue posts here for review and authorization.\n              </p>\n            </div>\n          ) : (\n            pendingPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\"\n              >\n                <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 text-[10px] font-semibold border border-amber-200 dark:border-amber-900/50 flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3\" />\n                      Awaiting Approval\n                    </span>\n                    <span className=\"text-xs font-bold text-gray-900 dark:text-white flex items-center gap-1\">\n                      {getPlatformIcon(post.platform)}\n                      <span>{post.platform}</span>\n                    </span>\n                    <span className=\"text-xs text-gray-400\">\342\200\242</span>\n                    <span className=\"text-xs text-gray-500 dark:text-slate-400\">{post.account_handle}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => handlePublishQueuedPost(post)}\n                      disabled={publishingPostId === post.id}\n                      className=\"px-4 h-9 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold flex items-center gap-1.5 shadow-xs cursor-pointer disabled:opacity-50\"\n                    >\n                      {publishingPostId === post.id ? (\n                        <>\n                          <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                          <span>Publishing...</span>\n                        </>\n                      ) : (\n                        <>\n                          <Send className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                          <span>Approve & Post Now</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-16 h-16 rounded-xl object-cover shrink-0\"\n                  />\n                  <div className=\"flex-1 min-w-0 space-y-1\">\n                    <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                      {post.media_filename}\n                    </p>\n                    <p className=\"text-xs text-gray-700 dark:text-slate-300 whitespace-pre-wrap line-clamp-3 leading-relaxed\">\n                      {post.caption_text}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* SUB TAB 3: PUBLISHED HISTORY */}\n      {activeSubTab === \'history\' && (\n        <div className=\"space-y-4\">\n          {publishedPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 text-xs text-gray-500\">\n              No published posts yet.\n            </div>\n          ) : (\n            publishedPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-3\"\n              >\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-semibold text-[10px] flex items-center gap-1\">\n                      <CheckCircle2 className=\"w-3 h-3\" />\n                      Published\n                    </span>\n                    <span className=\"text-gray-300\">\342\200\242</span>\n                    <span className=\"font-bold text-gray-900 dark:text-white\">{post.platform} ({post.account_handle})</span>\n                  </div>\n\n                  {post.post_url && (\n                    <a\n                      href={post.post_url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1\"\n                    >\n                      <span>View Post</span>\n                      <ExternalLink className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                    </a>\n                  )}\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3.5 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-14 h-14 rounded-xl object-cover shrink-0\"\n                  />\n                  <p className=\"text-xs text-gray-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed line-clamp-3\">\n                    {post.caption_text}\n                  </p>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* SUB TAB 4: OAUTH REQUIREMENTS GUIDE */}\n      {activeSubTab === \'oauth_guide\' && (\n        <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 space-y-5\">\n          <div>\n            <h2 className=\"text-base font-bold text-gray-900 dark:text-white mb-1\">\n              Requirements for Connecting Real Social Media Accounts\n            </h2>\n            <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n              To publish posts directly to your actual social accounts via official developer APIs, register a Developer Application on each platform console:\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n            <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Instagram className=\"w-4 h-4 text-pink-600\" />\n                <span>Meta / Instagram Graph API</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400 leading-relaxed\">\n                Create an app on <a href=\"https://developers.facebook.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-blue-600 underline\">developers.facebook.com</a> with Instagram Content Publishing permissions.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded-lg text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Linkedin className=\"w-4 h-4 text-blue-600\" />\n                <span>LinkedIn Developer Portal</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400 leading-relaxed\">\n                Register an app on <a href=\"https://www.linkedin.com/developers\" target=\"_blank\" rel=\"noreferrer\" className=\"text-blue-600 underline\">linkedin.com/developers</a> and request Share on LinkedIn access (`w_member_social`).\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded-lg text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Twitter className=\"w-4 h-4 text-gray-900 dark:text-white\" />\n                <span>X / Twitter Developer Portal</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400 leading-relaxed\">\n                Create a project in <a href=\"https://developer.twitter.com\" target=\"_blank\" rel=\"noreferrer\" className=\"text-blue-600 underline\">developer.twitter.com</a> with Read and Write permissions enabled.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded-lg text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n              <div className=\"flex items-center gap-2 font-bold text-gray-900 dark:text-white\">\n                <Facebook className=\"w-4 h-4 text-blue-700\" />\n                <span>Facebook Pages API</span>\n              </div>\n              <p className=\"text-gray-600 dark:text-slate-400 leading-relaxed\">\n                Obtain a Page Access Token with `pages_manage_posts` permission.\n              </p>\n              <div className=\"text-[11px] font-mono bg-gray-100 dark:bg-slate-900 p-2 rounded-lg text-gray-700 dark:text-slate-300 break-all\">\n                Callback: {currentDevUrl}\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* API KEYS / CREDENTIALS MODAL */}\n      {showCredentialsModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 rounded-[24px] w-full max-w-lg p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between border-b border-gray-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <Key className=\"w-4 h-4 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n                <span>Configure OAuth Keys</span>\n              </h3>\n              <button onClick={() => setShowCredentialsModal(false)} className=\"text-gray-400 hover:text-gray-600 cursor-pointer text-sm font-semibold\">\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center gap-1.5 p-1 bg-gray-100 dark:bg-slate-800 rounded-xl\">\n                {([\'LinkedIn\', \'Instagram\', \'X\', \'Facebook\'] as SocialPlatform[]).map(plat => (\n                  <button\n                    key={plat}\n                    onClick={() => setSelectedCredPlatform(plat)}\n                    className={`flex-1 py-1.5 text-xs font-semibold rounded-lg transition-colors cursor-pointer ${\n                      selectedCredPlatform === plat \n                        ? \'bg-white dark:bg-[#111622] text-gray-900 dark:text-white shadow-xs\'\n                        : \'text-gray-600 dark:text-slate-400\'\n                    }`}\n                  >\n                    {plat}\n                  </button>\n                ))}\n              </div>\n\n              <div className=\"space-y-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                    {selectedCredPlatform} Client ID / App ID\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder={`Enter ${selectedCredPlatform} Client ID`}\n                    value={apiKeys[selectedCredPlatform]?.clientId || \'\'}\n                    onChange={(e) => setApiKeys({\n                      ...apiKeys,\n                      [selectedCredPlatform]: {\n                        ...apiKeys[selectedCredPlatform],\n                        clientId: e.target.value\n                      }\n                    })}\n                    className=\"w-full h-10 px-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                    {selectedCredPlatform} Client Secret\n                  </label>\n                  <input\n                    type=\"password\"\n                    placeholder={`Enter ${selectedCredPlatform} Client Secret`}\n                    value={apiKeys[selectedCredPlatform]?.clientSecret || \'\'}\n                    onChange={(e) => setApiKeys({\n                      ...apiKeys,\n                      [selectedCredPlatform]: {\n                        ...apiKeys[selectedCredPlatform],\n                        clientSecret: e.target.value\n                      }\n                    })}\n                    className=\"w-full h-10 px-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                  />\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 text-[11px] text-gray-600 dark:text-slate-400 space-y-1\">\n                  <p className=\"font-semibold text-gray-900 dark:text-white\">Redirect URI for developer console:</p>\n                  <code className=\"block p-2 bg-gray-100 dark:bg-slate-900 rounded-lg font-mono break-all\">{currentDevUrl}</code>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-between pt-2 border-t border-gray-200 dark:border-slate-800\">\n              <span className=\"text-xs text-emerald-600 font-semibold\">\n                {savedKeyStatus ? \'Credentials Saved!\' : \'\'}\n              </span>\n              <div className=\"flex gap-2\">\n                <button\n                  onClick={() => setShowCredentialsModal(false)}\n                  className=\"px-4 h-9 rounded-xl text-xs font-semibold text-gray-600 dark:text-slate-300 cursor-pointer\"\n                >\n                  Close\n                </button>\n                <button\n                  onClick={handleSaveCredentials}\n                  className=\"px-4 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white cursor-pointer shadow-xs\"\n                >\n                  Save Keys\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* LINK PAGE MODAL */}\n      {connectModalPlatform && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 rounded-[24px] w-full max-w-md p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between border-b border-gray-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                {getPlatformIcon(connectModalPlatform)}\n                <span>Link {connectModalPlatform} Page</span>\n              </h3>\n              <button onClick={() => setConnectModalPlatform(null)} className=\"text-gray-400 hover:text-gray-600 cursor-pointer text-sm font-semibold\">\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Page / Profile Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={customPageName}\n                  onChange={(e) => setCustomPageName(e.target.value)}\n                  className=\"w-full h-10 px-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Handle / Username\n                </label>\n                <input\n                  type=\"text\"\n                  value={customHandle}\n                  onChange={(e) => setCustomHandle(e.target.value)}\n                  className=\"w-full h-10 px-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2 pt-2 border-t border-gray-200 dark:border-slate-800\">\n              <button\n                onClick={() => setConnectModalPlatform(null)}\n                className=\"px-4 h-9 rounded-xl text-xs font-semibold text-gray-600 dark:text-slate-300 cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmConnect}\n                disabled={isConnecting !== null}\n                className=\"px-4 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white cursor-pointer shadow-xs\"\n              >\n                {isConnecting ? \'Connecting...\' : \'Authorize & Connect\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
