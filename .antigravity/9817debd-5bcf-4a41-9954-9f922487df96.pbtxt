    instruction: "Update CaptionGeneratorModal.tsx styling with Linear aesthetics, #2563EB accent blue, 18px rounded cards, and 12px rounded buttons."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  X, \n  Sparkles, \n  Copy, \n  Check, \n  RefreshCw, \n  Edit3, \n  BookmarkCheck, \n  Send, \n  Folder, \n  FileImage, \n  Video, \n  Sliders,\n  ChevronDown,\n  Layers,\n  Flame,\n  MessageSquare,\n  ThumbsUp,\n  Share2\n} from \'lucide-react\';\nimport { \n  MediaItem, \n  SocialPlatform, \n  CaptionTone, \n  CaptionLength, \n  TargetAudience, \n  CaptionSettings, \n  CaptionVariation \n} from \'../types\';\n\ninterface CaptionGeneratorModalProps {\n  media: MediaItem;\n  onClose: () => void;\n  onSaveToHistory: (\n    media: MediaItem, \n    settings: CaptionSettings, \n    variation: CaptionVariation\n  ) => void;\n  onOpenPublishModal?: (data: {\n    mediaFilename: string;\n    mediaThumbnail: string;\n    captionText: string;\n    platform: SocialPlatform;\n  }) => void;\n}\n\nexport const CaptionGeneratorModal: React.FC<CaptionGeneratorModalProps> = ({\n  media,\n  onClose,\n  onSaveToHistory,\n  onOpenPublishModal\n}) => {\n  const isVideo = media.file_type === \'video\';\n\n  // Settings State\n  const [settings, setSettings] = useState<CaptionSettings>({\n    platform: \'Instagram\',\n    tone: \'Inspirational\',\n    length: \'Medium\',\n    target_audience: \'Creators\',\n    custom_notes: \'\'\n  });\n\n  const [isGenerating, setIsGenerating] = useState<boolean>(false);\n  const [variations, setVariations] = useState<CaptionVariation[]>([]);\n  const [activeVariationIdx, setActiveVariationIdx] = useState<number>(0);\n  const [copiedIdx, setCopiedIdx] = useState<number | null>(null);\n  const [savedIdx, setSavedIdx] = useState<number | null>(null);\n  \n  // Editable state for active variation\n  const [isEditing, setIsEditing] = useState<boolean>(false);\n  const [editedBody, setEditedBody] = useState<string>(\'\');\n\n  const platforms: SocialPlatform[] = [\'Instagram\', \'LinkedIn\', \'Facebook\', \'X\'];\n  const tones: CaptionTone[] = [\n    \'Storytelling\', \n    \'Educational\', \n    \'Promotional\', \n    \'Inspirational\', \n    \'Professional\', \n    \'Casual\', \n    \'Humorous\'\n  ];\n  const lengths: CaptionLength[] = [\'Short\', \'Medium\', \'Long\'];\n  const audiences: TargetAudience[] = [\n    \'Business owners\', \n    \'Entrepreneurs\', \n    \'Students\', \n    \'Creators\', \n    \'General audience\'\n  ];\n\n  // Call API to generate captions using Gemini\n  const handleGenerateCaptions = async () => {\n    setIsGenerating(true);\n    setVariations([]);\n    setIsEditing(false);\n    try {\n      const response = await fetch(\'/api/ai/generate-captions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ media, settings })\n      });\n\n      const data = await response.json();\n      if (data.success && data.variations?.length) {\n        setVariations(data.variations);\n        setActiveVariationIdx(0);\n        setEditedBody(data.variations[0]?.body || \'\');\n      } else {\n        alert(\'Failed to generate captions: \' + (data.error || \'Unknown error\'));\n      }\n    } catch (err: any) {\n      console.error(\'Error generating captions:\', err);\n      alert(\'Error connecting to caption server.\');\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  // Auto-generate captions when modal opens\n  useEffect(() => {\n    handleGenerateCaptions();\n  }, []);\n\n  const currentVar = variations[activeVariationIdx];\n\n  const handleCopy = (variation: CaptionVariation, idx: number) => {\n    const fullText = `${variation.hook}\\n\\n${isEditing && idx === activeVariationIdx ? editedBody : variation.body}\\n\\n${variation.cta}\\n\\n${variation.hashtags.join(\' \')}`;\n    navigator.clipboard.writeText(fullText);\n    setCopiedIdx(idx);\n    setTimeout(() => setCopiedIdx(null), 2500);\n  };\n\n  const handleSave = (variation: CaptionVariation, idx: number) => {\n    const varToSave = {\n      ...variation,\n      body: isEditing && idx === activeVariationIdx ? editedBody : variation.body\n    };\n    onSaveToHistory(media, settings, varToSave);\n    setSavedIdx(idx);\n    setTimeout(() => setSavedIdx(null), 2500);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-900/75 backdrop-blur-md animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-5xl max-h-[92vh] bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-[#EBECEF] dark:border-slate-800 flex items-center justify-between bg-white dark:bg-slate-900\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-xs\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <span>AI Caption Generator</span>\n                <span className=\"text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300\">\n                  Gemini AI\n                </span>\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                Tailor captions specifically for your target platform and brand tone\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body: Split view (Settings panel on left, Output panel on right) */}\n        <div className=\"flex-1 overflow-y-auto flex flex-col lg:flex-row\">\n          \n          {/* Left Column: Preferences Controls & Selected Media */}\n          <div className=\"w-full lg:w-5/12 p-5 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800 space-y-5 bg-slate-50/50 dark:bg-slate-950/40\">\n            \n            {/* Selected Media Preview Snippet */}\n            <div className=\"p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-3 shadow-2xs\">\n              <div className=\"relative w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-800\">\n                <img src={media.thumbnail} alt={media.filename} className=\"w-full h-full object-cover\" />\n                <div className=\"absolute top-1 left-1 p-0.5 rounded bg-black/60 text-white text-[9px]\">\n                  {isVideo ? <Video className=\"w-2.5 h-2.5 text-amber-400\" /> : <FileImage className=\"w-2.5 h-2.5 text-indigo-400\" />}\n                </div>\n              </div>\n              <div className=\"min-w-0 flex-1\">\n                <h4 className=\"text-xs font-bold text-slate-900 dark:text-white truncate\">\n                  {media.filename}\n                </h4>\n                <p className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5\">\n                  Folder: {media.folder}\n                </p>\n                {media.ai_analysis?.mood && (\n                  <span className=\"inline-block text-[10px] font-medium text-indigo-600 dark:text-indigo-400 mt-1\">\n                    Vibe: {media.ai_analysis.mood}\n                  </span>\n                )}\n              </div>\n            </div>\n\n            {/* Platform Selector Tabs */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block\">\n                1. Target Platform\n              </label>\n              <div className=\"grid grid-cols-4 gap-1.5\">\n                {platforms.map((p) => (\n                  <button\n                    key={p}\n                    onClick={() => setSettings((prev) => ({ ...prev, platform: p }))}\n                    className={`py-2 px-1 rounded-xl text-xs font-semibold text-center transition-all ${\n                      settings.platform === p\n                        ? \'bg-indigo-600 text-white shadow-md shadow-indigo-500/20\'\n                        : \'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800\'\n                    }`}\n                  >\n                    {p}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Tone Selector */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block\">\n                2. Caption Tone\n              </label>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-1.5\">\n                {tones.map((t) => (\n                  <button\n                    key={t}\n                    onClick={() => setSettings((prev) => ({ ...prev, tone: t }))}\n                    className={`py-1.5 px-2.5 rounded-xl text-xs font-medium text-left truncate transition-all ${\n                      settings.tone === t\n                        ? \'bg-indigo-50 text-indigo-700 border-indigo-300 dark:bg-indigo-950/80 dark:text-indigo-300 dark:border-indigo-800 border font-semibold\'\n                        : \'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800\'\n                    }`}\n                  >\n                    {t}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Length & Target Audience */}\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block\">\n                  Length\n                </label>\n                <select\n                  value={settings.length}\n                  onChange={(e) => setSettings((prev) => ({ ...prev, length: e.target.value as CaptionLength }))}\n                  className=\"w-full px-3 py-2 text-xs font-medium rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/30\"\n                >\n                  {lengths.map((l) => (\n                    <option key={l} value={l}>{l}</option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block\">\n                  Target Audience\n                </label>\n                <select\n                  value={settings.target_audience}\n                  onChange={(e) => setSettings((prev) => ({ ...prev, target_audience: e.target.value as TargetAudience }))}\n                  className=\"w-full px-3 py-2 text-xs font-medium rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500/30\"\n                >\n                  {audiences.map((a) => (\n                    <option key={a} value={a}>{a}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* Custom Notes optional */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block\">\n                Custom Angle / Specific Request (Optional)\n              </label>\n              <textarea\n                value={settings.custom_notes || \'\'}\n                onChange={(e) => setSettings((prev) => ({ ...prev, custom_notes: e.target.value }))}\n                placeholder=\"e.g. Mention our summer sale ends Sunday or focus on product launch discount...\"\n                rows={2}\n                className=\"w-full px-3 py-2 text-xs rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 resize-none\"\n              />\n            </div>\n\n            {/* Generate Action Button */}\n            <button\n              onClick={handleGenerateCaptions}\n              disabled={isGenerating}\n              className=\"w-full py-2.5 px-4 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center justify-center gap-2 transition-transform active:scale-95 disabled:opacity-50 cursor-pointer\"\n            >\n              {isGenerating ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                  <span>Gemini AI Crafting Captions...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>Generate Captions</span>\n                </>\n              )}\n            </button>\n\n          </div>\n\n          {/* Right Column: Generated Variations Output */}\n          <div className=\"w-full lg:w-7/12 p-5 flex flex-col justify-between bg-white dark:bg-slate-900 space-y-4 min-h-[400px]\">\n            \n            {variations.length > 0 ? (\n              <div className=\"space-y-4 flex-1 flex flex-col\">\n                \n                {/* Variations Tabs */}\n                <div className=\"flex items-center gap-2 p-1 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700\">\n                  {variations.map((v, idx) => (\n                    <button\n                      key={v.id || idx}\n                      onClick={() => {\n                        setActiveVariationIdx(idx);\n                        setEditedBody(v.body);\n                        setIsEditing(false);\n                      }}\n                      className={`flex-1 py-2 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${\n                        activeVariationIdx === idx\n                          ? \'bg-white dark:bg-slate-900 text-indigo-600 dark:text-indigo-400 shadow-sm\'\n                          : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n                      }`}\n                    >\n                      <Flame className=\"w-3.5 h-3.5 text-amber-500\" />\n                      <span>Option {idx + 1}</span>\n                    </button>\n                  ))}\n                </div>\n\n                {/* Active Caption Card */}\n                {currentVar && (\n                  <div className=\"flex-1 p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between space-y-4\">\n                    \n                    <div className=\"space-y-3\">\n                      \n                      {/* Variation Style Header */}\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-2.5 py-1 rounded-lg border border-indigo-200/60 dark:border-indigo-800\">\n                          {currentVar.style_title || `Variation ${activeVariationIdx + 1}`}\n                        </span>\n\n                        <div className=\"flex items-center gap-2\">\n                          <button\n                            onClick={() => {\n                              if (!isEditing) setEditedBody(currentVar.body);\n                              setIsEditing(!isEditing);\n                            }}\n                            className=\"text-xs font-semibold text-slate-500 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400 flex items-center gap-1 px-2 py-1 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-700 transition-colors\"\n                          >\n                            <Edit3 className=\"w-3.5 h-3.5\" />\n                            <span>{isEditing ? \'Done Editing\' : \'Edit Text\'}</span>\n                          </button>\n                        </div>\n                      </div>\n\n                      {/* Hook Spotlight Box */}\n                      <div className=\"p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/80 dark:border-amber-800/60 space-y-1\">\n                        <span className=\"text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 block\">\n                          \360\237\252\235 Scroll-Stopping Hook\n                        </span>\n                        <p className=\"text-xs font-bold text-slate-900 dark:text-slate-100 leading-snug\">\n                          {currentVar.hook}\n                        </p>\n                      </div>\n\n                      {/* Main Caption Body */}\n                      <div className=\"space-y-1\">\n                        <span className=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 block\">\n                          Main Post Body\n                        </span>\n                        \n                        {isEditing ? (\n                          <textarea\n                            value={editedBody}\n                            onChange={(e) => setEditedBody(e.target.value)}\n                            rows={6}\n                            className=\"w-full p-3 text-xs font-sans rounded-xl bg-white dark:bg-slate-900 border border-indigo-400 dark:border-indigo-500 text-slate-900 dark:text-slate-100 focus:outline-none resize-none leading-relaxed\"\n                          />\n                        ) : (\n                          <div className=\"p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs text-slate-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed max-h-[220px] overflow-y-auto\">\n                            {currentVar.body}\n                          </div>\n                        )}\n                      </div>\n\n                      {/* CTA Box */}\n                      {currentVar.cta && (\n                        <div className=\"p-2.5 rounded-xl bg-indigo-50/60 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/40 space-y-0.5\">\n                          <span className=\"text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 block\">\n                            Call To Action (CTA)\n                          </span>\n                          <p className=\"text-xs font-medium text-slate-800 dark:text-slate-200\">\n                            \360\237\221\211 {currentVar.cta}\n                          </p>\n                        </div>\n                      )}\n\n                      {/* Hashtag Badges */}\n                      {currentVar.hashtags && currentVar.hashtags.length > 0 && (\n                        <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                          {currentVar.hashtags.map((h, i) => (\n                            <span key={i} className=\"px-2 py-0.5 rounded-md bg-slate-200/70 dark:bg-slate-800 text-[11px] font-medium text-indigo-600 dark:text-indigo-400\">\n                              {h}\n                            </span>\n                          ))}\n                        </div>\n                      )}\n\n                    </div>\n\n                    {/* Bottom Action Toolbar */}\n                    <div className=\"pt-3 border-t border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-2 mt-4\">\n                      \n                      <button\n                        onClick={handleGenerateCaptions}\n                        disabled={isGenerating}\n                        className=\"px-3 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white flex items-center gap-1.5 hover:bg-slate-200/60 dark:hover:bg-slate-700 transition-colors\"\n                      >\n                        <RefreshCw className=\"w-3.5 h-3.5\" />\n                        <span>Regenerate</span>\n                      </button>\n\n                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <button\n                          onClick={() => handleSave(currentVar, activeVariationIdx)}\n                          className=\"px-3 py-2 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                        >\n                          {savedIdx === activeVariationIdx ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                              <span>Saved!</span>\n                            </>\n                          ) : (\n                            <>\n                              <BookmarkCheck className=\"w-3.5 h-3.5 text-indigo-500\" />\n                              <span>Save</span>\n                            </>\n                          )}\n                        </button>\n\n                        <button\n                          onClick={() => handleCopy(currentVar, activeVariationIdx)}\n                          className=\"px-3.5 py-2 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                        >\n                          {copiedIdx === activeVariationIdx ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                              <span>Copied!</span>\n                            </>\n                          ) : (\n                            <>\n                              <Copy className=\"w-3.5 h-3.5\" />\n                              <span>Copy Text</span>\n                            </>\n                          )}\n                        </button>\n\n                        {onOpenPublishModal && (\n                          <button\n                            onClick={() => {\n                              const fullText = `${currentVar.hook}\\n\\n${currentVar.body}${currentVar.cta ? `\\n\\n${currentVar.cta}` : \'\'}${currentVar.hashtags ? `\\n\\n${currentVar.hashtags.join(\' \')}` : \'\'}`;\n                              onOpenPublishModal({\n                                mediaFilename: media.filename,\n                                mediaThumbnail: media.thumbnail,\n                                captionText: fullText,\n                                platform: settings.platform\n                              });\n                            }}\n                            className=\"px-4 py-2 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center gap-1.5 transition-transform active:scale-95 cursor-pointer\"\n                          >\n                            <Send className=\"w-3.5 h-3.5\" />\n                            <span>Post to Social</span>\n                          </button>\n                        )}\n                      </div>\n\n                    </div>\n\n                  </div>\n                )}\n\n              </div>\n            ) : (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center p-8 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-2xl space-y-3\">\n                <div className=\"w-14 h-14 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shadow-inner\">\n                  <Sparkles className=\"w-7 h-7\" />\n                </div>\n                <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n                  Ready to Generate Captions\n                </h3>\n                <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm\">\n                  Choose your target platform (Instagram, LinkedIn, etc.), set your tone and length, then click <strong className=\"text-indigo-600 dark:text-indigo-400\">Generate 3 Captions Now</strong>.\n                </p>\n                <button\n                  onClick={handleGenerateCaptions}\n                  disabled={isGenerating}\n                  className=\"mt-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md\"\n                >\n                  Generate First Caption\n                </button>\n              </div>\n            )}\n\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  X, \n  Sparkles, \n  Copy, \n  Check, \n  RefreshCw, \n  Edit3, \n  BookmarkCheck, \n  Send, \n  FileImage, \n  Video, \n  Flame,\n  Zap\n} from \'lucide-react\';\nimport { \n  MediaItem, \n  SocialPlatform, \n  CaptionTone, \n  CaptionLength, \n  TargetAudience, \n  CaptionSettings, \n  CaptionVariation \n} from \'../types\';\n\ninterface CaptionGeneratorModalProps {\n  media: MediaItem;\n  onClose: () => void;\n  onSaveToHistory: (\n    media: MediaItem, \n    settings: CaptionSettings, \n    variation: CaptionVariation\n  ) => void;\n  onOpenPublishModal?: (data: {\n    mediaFilename: string;\n    mediaThumbnail: string;\n    captionText: string;\n    platform: SocialPlatform;\n  }) => void;\n}\n\nexport const CaptionGeneratorModal: React.FC<CaptionGeneratorModalProps> = ({\n  media,\n  onClose,\n  onSaveToHistory,\n  onOpenPublishModal\n}) => {\n  const isVideo = media.file_type === \'video\';\n\n  // Settings State\n  const [settings, setSettings] = useState<CaptionSettings>({\n    platform: \'Instagram\',\n    tone: \'Inspirational\',\n    length: \'Medium\',\n    target_audience: \'Creators\',\n    custom_notes: \'\'\n  });\n\n  const [isGenerating, setIsGenerating] = useState<boolean>(false);\n  const [variations, setVariations] = useState<CaptionVariation[]>([]);\n  const [activeVariationIdx, setActiveVariationIdx] = useState<number>(0);\n  const [copiedIdx, setCopiedIdx] = useState<number | null>(null);\n  const [savedIdx, setSavedIdx] = useState<number | null>(null);\n  \n  // Editable state for active variation\n  const [isEditing, setIsEditing] = useState<boolean>(false);\n  const [editedBody, setEditedBody] = useState<string>(\'\');\n\n  const platforms: SocialPlatform[] = [\'Instagram\', \'LinkedIn\', \'Facebook\', \'X\'];\n  const tones: CaptionTone[] = [\n    \'Storytelling\', \n    \'Educational\', \n    \'Promotional\', \n    \'Inspirational\', \n    \'Professional\', \n    \'Casual\', \n    \'Humorous\'\n  ];\n  const lengths: CaptionLength[] = [\'Short\', \'Medium\', \'Long\'];\n  const audiences: TargetAudience[] = [\n    \'Business owners\', \n    \'Entrepreneurs\', \n    \'Students\', \n    \'Creators\', \n    \'General audience\'\n  ];\n\n  // Call API to generate captions using Gemini\n  const handleGenerateCaptions = async () => {\n    setIsGenerating(true);\n    setVariations([]);\n    setIsEditing(false);\n    try {\n      const response = await fetch(\'/api/ai/generate-captions\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ media, settings })\n      });\n\n      const data = await response.json();\n      if (data.success && data.variations?.length) {\n        setVariations(data.variations);\n        setActiveVariationIdx(0);\n        setEditedBody(data.variations[0]?.body || \'\');\n      } else {\n        alert(\'Failed to generate captions: \' + (data.error || \'Unknown error\'));\n      }\n    } catch (err: any) {\n      console.error(\'Error generating captions:\', err);\n      alert(\'Error connecting to caption server.\');\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  // Auto-generate captions when modal opens\n  useEffect(() => {\n    handleGenerateCaptions();\n  }, []);\n\n  const currentVar = variations[activeVariationIdx];\n\n  const handleCopy = (variation: CaptionVariation, idx: number) => {\n    const fullText = `${variation.hook}\\n\\n${isEditing && idx === activeVariationIdx ? editedBody : variation.body}\\n\\n${variation.cta}\\n\\n${variation.hashtags.join(\' \')}`;\n    navigator.clipboard.writeText(fullText);\n    setCopiedIdx(idx);\n    setTimeout(() => setCopiedIdx(null), 2500);\n  };\n\n  const handleSave = (variation: CaptionVariation, idx: number) => {\n    const varToSave = {\n      ...variation,\n      body: isEditing && idx === activeVariationIdx ? editedBody : variation.body\n    };\n    onSaveToHistory(media, settings, varToSave);\n    setSavedIdx(idx);\n    setTimeout(() => setSavedIdx(null), 2500);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-900/75 backdrop-blur-md animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-5xl max-h-[92vh] bg-white dark:bg-[#111622] rounded-[24px] border border-gray-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between bg-white dark:bg-[#111622]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-xs\">\n              <Sparkles className=\"w-4 h-4 fill-current\" strokeWidth={1.75} />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <span>AI Caption Studio</span>\n                <span className=\"text-[11px] font-semibold tracking-wide px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 border border-blue-100 dark:border-blue-900\">\n                  Gemini Vision\n                </span>\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                Tailor platform-native captions based on visual media context\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-xl flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" strokeWidth={1.75} />\n          </button>\n        </div>\n\n        {/* Modal Body: Split view */}\n        <div className=\"flex-1 overflow-y-auto flex flex-col lg:flex-row\">\n          \n          {/* Left Column: Preferences Controls */}\n          <div className=\"w-full lg:w-5/12 p-6 border-b lg:border-b-0 lg:border-r border-gray-200 dark:border-slate-800 space-y-5 bg-gray-50/50 dark:bg-slate-950/40\">\n            \n            {/* Selected Media Preview Snippet */}\n            <div className=\"p-3.5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 flex items-center gap-3.5 shadow-card\">\n              <div className=\"relative w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-800\">\n                <img src={media.thumbnail} alt={media.filename} className=\"w-full h-full object-cover\" />\n                <div className=\"absolute top-1 left-1 p-0.5 rounded bg-black/60 text-white text-[9px]\">\n                  {isVideo ? <Video className=\"w-2.5 h-2.5 text-white\" strokeWidth={1.75} /> : <FileImage className=\"w-2.5 h-2.5 text-white\" strokeWidth={1.75} />}\n                </div>\n              </div>\n              <div className=\"min-w-0 flex-1\">\n                <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                  {media.filename}\n                </h4>\n                <p className=\"text-[11px] text-gray-500 dark:text-slate-400 truncate mt-0.5\">\n                  Folder: {media.folder}\n                </p>\n                {media.ai_analysis?.mood && (\n                  <span className=\"inline-block text-[10px] font-medium text-blue-600 dark:text-blue-400 mt-0.5\">\n                    Mood: {media.ai_analysis.mood}\n                  </span>\n                )}\n              </div>\n            </div>\n\n            {/* Platform Selector Tabs */}\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider block\">\n                1. Target Platform\n              </label>\n              <div className=\"grid grid-cols-4 gap-1.5\">\n                {platforms.map((p) => (\n                  <button\n                    key={p}\n                    onClick={() => setSettings((prev) => ({ ...prev, platform: p }))}\n                    className={`py-2 px-1 rounded-xl text-xs font-semibold text-center transition-all cursor-pointer ${\n                      settings.platform === p\n                        ? \'bg-blue-600 text-white shadow-xs\'\n                        : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n                    }`}\n                  >\n                    {p}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Tone Selector */}\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider block\">\n                2. Caption Tone\n              </label>\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-1.5\">\n                {tones.map((t) => (\n                  <button\n                    key={t}\n                    onClick={() => setSettings((prev) => ({ ...prev, tone: t }))}\n                    className={`py-2 px-3 rounded-xl text-xs font-medium text-left truncate transition-all cursor-pointer ${\n                      settings.tone === t\n                        ? \'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-900 border font-semibold\'\n                        : \'bg-white dark:bg-[#111622] text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-800\'\n                    }`}\n                  >\n                    {t}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Length & Target Audience */}\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider block\">\n                  Length\n                </label>\n                <select\n                  value={settings.length}\n                  onChange={(e) => setSettings((prev) => ({ ...prev, length: e.target.value as CaptionLength }))}\n                  className=\"w-full px-3 h-10 text-xs font-medium rounded-xl bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                >\n                  {lengths.map((l) => (\n                    <option key={l} value={l}>{l}</option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider block\">\n                  Audience\n                </label>\n                <select\n                  value={settings.target_audience}\n                  onChange={(e) => setSettings((prev) => ({ ...prev, target_audience: e.target.value as TargetAudience }))}\n                  className=\"w-full px-3 h-10 text-xs font-medium rounded-xl bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n                >\n                  {audiences.map((a) => (\n                    <option key={a} value={a}>{a}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* Custom Notes optional */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider block\">\n                Custom Instructions (Optional)\n              </label>\n              <textarea\n                value={settings.custom_notes || \'\'}\n                onChange={(e) => setSettings((prev) => ({ ...prev, custom_notes: e.target.value }))}\n                placeholder=\"e.g. Include launch offer discount code or keep call to action brief...\"\n                rows={2}\n                className=\"w-full p-3 text-xs rounded-xl bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 text-gray-800 dark:text-slate-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-600/20 resize-none\"\n              />\n            </div>\n\n            {/* Generate Action Button */}\n            <button\n              onClick={handleGenerateCaptions}\n              disabled={isGenerating}\n              className=\"w-full h-11 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center justify-center gap-2 transition-all active:scale-[0.98] disabled:opacity-50 cursor-pointer\"\n            >\n              {isGenerating ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                  <span>Generating Captions...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-4 h-4 fill-current\" strokeWidth={1.75} />\n                  <span>Generate Captions</span>\n                </>\n              )}\n            </button>\n\n          </div>\n\n          {/* Right Column: Generated Variations Output */}\n          <div className=\"w-full lg:w-7/12 p-6 flex flex-col justify-between bg-white dark:bg-[#111622] space-y-4 min-h-[400px]\">\n            \n            {variations.length > 0 ? (\n              <div className=\"space-y-4 flex-1 flex flex-col\">\n                \n                {/* Variations Tabs */}\n                <div className=\"flex items-center gap-2 p-1 rounded-xl bg-gray-100 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-700\">\n                  {variations.map((v, idx) => (\n                    <button\n                      key={v.id || idx}\n                      onClick={() => {\n                        setActiveVariationIdx(idx);\n                        setEditedBody(v.body);\n                        setIsEditing(false);\n                      }}\n                      className={`flex-1 py-2 px-3 rounded-lg text-xs font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                        activeVariationIdx === idx\n                          ? \'bg-white dark:bg-[#111622] text-blue-600 dark:text-blue-400 shadow-xs\'\n                          : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n                      }`}\n                    >\n                      <Zap className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n                      <span>Variation {idx + 1}</span>\n                    </button>\n                  ))}\n                </div>\n\n                {/* Active Caption Card */}\n                {currentVar && (\n                  <div className=\"flex-1 p-6 rounded-[18px] bg-gray-50 dark:bg-slate-800/50 border border-gray-200 dark:border-slate-700/60 flex flex-col justify-between space-y-4\">\n                    \n                    <div className=\"space-y-3\">\n                      \n                      {/* Variation Style Header */}\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950 px-3 py-1 rounded-full border border-blue-100 dark:border-blue-900\">\n                          {currentVar.style_title || `Variation ${activeVariationIdx + 1}`}\n                        </span>\n\n                        <div className=\"flex items-center gap-2\">\n                          <button\n                            onClick={() => {\n                              if (!isEditing) setEditedBody(currentVar.body);\n                              setIsEditing(!isEditing);\n                            }}\n                            className=\"text-xs font-medium text-gray-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 flex items-center gap-1 px-2.5 py-1 rounded-lg hover:bg-gray-200/60 dark:hover:bg-slate-700 transition-colors cursor-pointer\"\n                          >\n                            <Edit3 className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                            <span>{isEditing ? \'Save Text\' : \'Edit Text\'}</span>\n                          </button>\n                        </div>\n                      </div>\n\n                      {/* Hook Box */}\n                      <div className=\"p-3.5 rounded-xl bg-amber-50/80 dark:bg-amber-950/40 border border-amber-200/80 dark:border-amber-800/60 space-y-1\">\n                        <span className=\"text-[10px] font-semibold uppercase tracking-wider text-amber-700 dark:text-amber-400 block\">\n                          Scroll-Stopping Hook\n                        </span>\n                        <p className=\"text-xs font-bold text-gray-900 dark:text-slate-100 leading-snug\">\n                          {currentVar.hook}\n                        </p>\n                      </div>\n\n                      {/* Main Caption Body */}\n                      <div className=\"space-y-1\">\n                        <span className=\"text-[10px] font-semibold uppercase tracking-wider text-gray-400 block\">\n                          Main Body\n                        </span>\n                        \n                        {isEditing ? (\n                          <textarea\n                            value={editedBody}\n                            onChange={(e) => setEditedBody(e.target.value)}\n                            rows={6}\n                            className=\"w-full p-3.5 text-xs font-sans rounded-xl bg-white dark:bg-[#111622] border border-blue-500 text-gray-900 dark:text-slate-100 focus:outline-none resize-none leading-relaxed\"\n                          />\n                        ) : (\n                          <div className=\"p-4 rounded-xl bg-white dark:bg-[#111622] border border-gray-200/80 dark:border-slate-800 text-xs text-gray-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed max-h-[220px] overflow-y-auto\">\n                            {currentVar.body}\n                          </div>\n                        )}\n                      </div>\n\n                      {/* CTA Box */}\n                      {currentVar.cta && (\n                        <div className=\"p-3 rounded-xl bg-blue-50/60 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/40 space-y-0.5\">\n                          <span className=\"text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 block\">\n                            Call To Action\n                          </span>\n                          <p className=\"text-xs font-medium text-gray-800 dark:text-slate-200\">\n                            \360\237\221\211 {currentVar.cta}\n                          </p>\n                        </div>\n                      )}\n\n                      {/* Hashtag Badges */}\n                      {currentVar.hashtags && currentVar.hashtags.length > 0 && (\n                        <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                          {currentVar.hashtags.map((h, i) => (\n                            <span key={i} className=\"px-2.5 py-1 rounded-md bg-gray-200/70 dark:bg-slate-800 text-[11px] font-medium text-blue-600 dark:text-blue-400\">\n                              {h}\n                            </span>\n                          ))}\n                        </div>\n                      )}\n\n                    </div>\n\n                    {/* Bottom Action Toolbar */}\n                    <div className=\"pt-3 border-t border-gray-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-2 mt-4\">\n                      \n                      <button\n                        onClick={handleGenerateCaptions}\n                        disabled={isGenerating}\n                        className=\"px-3 h-9 rounded-xl text-xs font-medium text-gray-600 hover:text-gray-900 dark:text-slate-400 dark:hover:text-white flex items-center gap-1.5 hover:bg-gray-200/60 dark:hover:bg-slate-700 transition-colors cursor-pointer\"\n                      >\n                        <RefreshCw className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                        <span>Regenerate</span>\n                      </button>\n\n                      <div className=\"flex flex-wrap items-center gap-2\">\n                        <button\n                          onClick={() => handleSave(currentVar, activeVariationIdx)}\n                          className=\"px-3.5 h-9 rounded-xl text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                        >\n                          {savedIdx === activeVariationIdx ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                              <span>Saved</span>\n                            </>\n                          ) : (\n                            <>\n                              <BookmarkCheck className=\"w-3.5 h-3.5 text-blue-600\" strokeWidth={1.75} />\n                              <span>Save</span>\n                            </>\n                          )}\n                        </button>\n\n                        <button\n                          onClick={() => handleCopy(currentVar, activeVariationIdx)}\n                          className=\"px-3.5 h-9 rounded-xl text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                        >\n                          {copiedIdx === activeVariationIdx ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                              <span>Copied</span>\n                            </>\n                          ) : (\n                            <>\n                              <Copy className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                              <span>Copy Text</span>\n                            </>\n                          )}\n                        </button>\n\n                        {onOpenPublishModal && (\n                          <button\n                            onClick={() => {\n                              const fullText = `${currentVar.hook}\\n\\n${currentVar.body}${currentVar.cta ? `\\n\\n${currentVar.cta}` : \'\'}${currentVar.hashtags ? `\\n\\n${currentVar.hashtags.join(\' \')}` : \'\'}`;\n                              onOpenPublishModal({\n                                mediaFilename: media.filename,\n                                mediaThumbnail: media.thumbnail,\n                                captionText: fullText,\n                                platform: settings.platform\n                              });\n                            }}\n                            className=\"px-4 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center gap-1.5 transition-all cursor-pointer\"\n                          >\n                            <Send className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                            <span>Post / Schedule</span>\n                          </button>\n                        )}\n                      </div>\n\n                    </div>\n\n                  </div>\n                )}\n\n              </div>\n            ) : (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center p-8 border border-dashed border-gray-200 dark:border-slate-800 rounded-[18px] space-y-3\">\n                <div className=\"w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center\">\n                  <Sparkles className=\"w-6 h-6 fill-current\" strokeWidth={1.75} />\n                </div>\n                <h3 className=\"text-base font-bold text-gray-900 dark:text-white\">\n                  Ready to Generate Captions\n                </h3>\n                <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm leading-relaxed\">\n                  Select your target platform and tone, then click <strong className=\"text-blue-600 dark:text-blue-400\">Generate Captions</strong>.\n                </p>\n              </div>\n            )}\n\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
