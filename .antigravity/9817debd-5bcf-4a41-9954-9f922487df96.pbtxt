        }
        lines {
          text: "                        acc ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300\' : \'bg-[#FAF8F5] text-gray-500 dark:bg-[#0D0E12] dark:text-slate-400\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
