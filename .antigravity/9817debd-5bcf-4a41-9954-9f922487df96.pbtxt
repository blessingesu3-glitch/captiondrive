    instruction: "Update MediaGrid.tsx styling to use #2563EB accent blue, 18px rounded cards, and 12px rounded buttons."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { \n  Grid, \n  List, \n  Search, \n  Filter, \n  Folder, \n  FileImage, \n  Video, \n  Sparkles, \n  Zap,\n  ArrowUpDown\n} from \'lucide-react\';\nimport { MediaItem, FilterState } from \'../types\';\nimport { MediaCard } from \'./MediaCard\';\n\ninterface MediaGridProps {\n  items: MediaItem[];\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onRunSmartSearch: (promptText: string) => void;\n  isLoadingSmartSearch?: boolean;\n}\n\nexport const MediaGrid: React.FC<MediaGridProps> = ({\n  items,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n  onRunSmartSearch,\n  isLoadingSmartSearch = false\n}) => {\n  const [filterState, setFilterState] = useState<FilterState>({\n    searchQuery: \'\',\n    mediaType: \'all\',\n    folder: \'all\',\n    sortBy: \'newest\',\n    viewMode: \'grid\'\n  });\n\n  // Extract unique folders\n  const folders = Array.from(new Set(items.map((i) => i.folder)));\n\n  // Filter & Sort Logic\n  const filteredItems = items\n    .filter((item) => {\n      // Type filter\n      if (filterState.mediaType !== \'all\' && item.file_type !== filterState.mediaType) {\n        return false;\n      }\n      // Folder filter\n      if (filterState.folder !== \'all\' && item.folder !== filterState.folder) {\n        return false;\n      }\n      // Search filter\n      if (filterState.searchQuery.trim()) {\n        const query = filterState.searchQuery.toLowerCase();\n        const matchesName = item.filename.toLowerCase().includes(query);\n        const matchesFolder = item.folder.toLowerCase().includes(query);\n        const matchesSummary = item.ai_analysis?.overall_summary?.toLowerCase().includes(query);\n        const matchesSubject = item.ai_analysis?.main_subject?.toLowerCase().includes(query);\n        return matchesName || matchesFolder || matchesSummary || matchesSubject;\n      }\n      return true;\n    })\n    .sort((a, b) => {\n      if (filterState.sortBy === \'newest\') {\n        return new Date(b.uploaded_at).getTime() - new Date(a.uploaded_at).getTime();\n      }\n      if (filterState.sortBy === \'oldest\') {\n        return new Date(a.uploaded_at).getTime() - new Date(b.uploaded_at).getTime();\n      }\n      return a.filename.localeCompare(b.filename);\n    });\n\n  // Smart Search sample pill prompts\n  const samplePills = [\n    \'Show my beach photos\',\n    \'Find videos about AI\',\n    \'Find pictures with laptops\',\n    \'Show speaking event photos\'\n  ];\n\n  return (\n    <div className=\"space-y-5\">\n      \n      {/* Header Controls & Filter Bar */}\n      <div className=\"p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs space-y-3\">\n        \n        <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n          \n          {/* Search input */}\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              value={filterState.searchQuery}\n              onChange={(e) => setFilterState((prev) => ({ ...prev, searchQuery: e.target.value }))}\n              placeholder=\"Search by filename, subject, or AI summary...\"\n              className=\"w-full pl-10 pr-4 py-2 text-sm rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30\"\n            />\n          </div>\n\n          {/* Quick Type Tabs */}\n          <div className=\"flex items-center gap-1 p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800\">\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'all\' }))}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n                filterState.mediaType === \'all\'\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              All ({items.length})\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'image\' }))}\n              className={`flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n                filterState.mediaType === \'image\'\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              <FileImage className=\"w-3.5 h-3.5\" />\n              <span>Images</span>\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'video\' }))}\n              className={`flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${\n                filterState.mediaType === \'video\'\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              <Video className=\"w-3.5 h-3.5\" />\n              <span>Videos</span>\n            </button>\n          </div>\n\n        </div>\n\n        {/* Secondary dropdown filters */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100 dark:border-slate-800\">\n          \n          <div className=\"flex flex-wrap items-center gap-2\">\n            \n            {/* Folder Dropdown */}\n            <div className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300\">\n              <Folder className=\"w-3.5 h-3.5 text-slate-400\" />\n              <select\n                value={filterState.folder}\n                onChange={(e) => setFilterState((prev) => ({ ...prev, folder: e.target.value }))}\n                className=\"bg-transparent text-slate-800 dark:text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                <option value=\"all\">All Folders</option>\n                {folders.map((f) => (\n                  <option key={f} value={f}>{f}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Sort Dropdown */}\n            <div className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300\">\n              <ArrowUpDown className=\"w-3.5 h-3.5 text-slate-400\" />\n              <select\n                value={filterState.sortBy}\n                onChange={(e) => setFilterState((prev) => ({ ...prev, sortBy: e.target.value as any }))}\n                className=\"bg-transparent text-slate-800 dark:text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                <option value=\"newest\">Sort: Newest Uploads</option>\n                <option value=\"oldest\">Sort: Oldest Uploads</option>\n                <option value=\"name\">Sort: Filename (A-Z)</option>\n              </select>\n            </div>\n\n          </div>\n\n          {/* View Mode Switcher */}\n          <div className=\"flex items-center gap-1 p-0.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800\">\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, viewMode: \'grid\' }))}\n              className={`p-1.5 rounded-md transition-all ${\n                filterState.viewMode === \'grid\'\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\'\n              }`}\n              title=\"Grid View\"\n            >\n              <Grid className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, viewMode: \'list\' }))}\n              className={`p-1.5 rounded-md transition-all ${\n                filterState.viewMode === \'list\'\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\'\n              }`}\n              title=\"List View\"\n            >\n              <List className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Smart Search Quick Sample Prompts */}\n      <div className=\"flex flex-wrap items-center gap-2 px-1\">\n        <span className=\"text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center gap-1\">\n          <Zap className=\"w-3.5 h-3.5 text-amber-500\" />\n          <span>Smart AI Prompts:</span>\n        </span>\n        {samplePills.map((pill) => (\n          <button\n            key={pill}\n            onClick={() => onRunSmartSearch(pill)}\n            disabled={isLoadingSmartSearch}\n            className=\"px-3 py-1 rounded-full text-xs font-medium bg-indigo-50/80 dark:bg-indigo-950/40 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/40 transition-all active:scale-95 disabled:opacity-50\"\n          >\n            \"{pill}\"\n          </button>\n        ))}\n      </div>\n\n      {/* Media Grid or List Output */}\n      {filteredItems.length > 0 ? (\n        <div className={\n          filterState.viewMode === \'grid\'\n            ? \'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\'\n            : \'space-y-3\'\n        }>\n          {filteredItems.map((item) => (\n            <MediaCard\n              key={item.id}\n              item={item}\n              viewMode={filterState.viewMode}\n              onSelectMedia={onSelectMedia}\n              onGenerateCaption={onGenerateCaption}\n              onToggleFavorite={onToggleFavorite}\n            />\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-16 text-center rounded-2xl bg-white dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 p-8 space-y-3\">\n          <div className=\"w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto\">\n            <Filter className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"text-base font-semibold text-slate-900 dark:text-white\">\n            No media files match your filters\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Try adjusting your search query, switching folder selections, or importing new media from Google Drive.\n          </p>\n          <button\n            onClick={() => setFilterState({ searchQuery: \'\', mediaType: \'all\', folder: \'all\', sortBy: \'newest\', viewMode: \'grid\' })}\n            className=\"mt-2 px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white transition-colors\"\n          >\n            Reset Filters\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { \n  Grid, \n  List, \n  Search, \n  Filter, \n  Folder, \n  FileImage, \n  Video, \n  Sparkles, \n  Zap,\n  ArrowUpDown\n} from \'lucide-react\';\nimport { MediaItem, FilterState } from \'../types\';\nimport { MediaCard } from \'./MediaCard\';\n\ninterface MediaGridProps {\n  items: MediaItem[];\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onRunSmartSearch: (promptText: string) => void;\n  isLoadingSmartSearch?: boolean;\n}\n\nexport const MediaGrid: React.FC<MediaGridProps> = ({\n  items,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n  onRunSmartSearch,\n  isLoadingSmartSearch = false\n}) => {\n  const [filterState, setFilterState] = useState<FilterState>({\n    searchQuery: \'\',\n    mediaType: \'all\',\n    folder: \'all\',\n    sortBy: \'newest\',\n    viewMode: \'grid\'\n  });\n\n  // Extract unique folders\n  const folders = Array.from(new Set(items.map((i) => i.folder)));\n\n  // Filter & Sort Logic\n  const filteredItems = items\n    .filter((item) => {\n      // Type filter\n      if (filterState.mediaType !== \'all\' && item.file_type !== filterState.mediaType) {\n        return false;\n      }\n      // Folder filter\n      if (filterState.folder !== \'all\' && item.folder !== filterState.folder) {\n        return false;\n      }\n      // Search filter\n      if (filterState.searchQuery.trim()) {\n        const query = filterState.searchQuery.toLowerCase();\n        const matchesName = item.filename.toLowerCase().includes(query);\n        const matchesFolder = item.folder.toLowerCase().includes(query);\n        const matchesSummary = item.ai_analysis?.overall_summary?.toLowerCase().includes(query);\n        const matchesSubject = item.ai_analysis?.main_subject?.toLowerCase().includes(query);\n        return matchesName || matchesFolder || matchesSummary || matchesSubject;\n      }\n      return true;\n    })\n    .sort((a, b) => {\n      if (filterState.sortBy === \'newest\') {\n        return new Date(b.uploaded_at).getTime() - new Date(a.uploaded_at).getTime();\n      }\n      if (filterState.sortBy === \'oldest\') {\n        return new Date(a.uploaded_at).getTime() - new Date(b.uploaded_at).getTime();\n      }\n      return a.filename.localeCompare(b.filename);\n    });\n\n  // Smart Search sample pill prompts\n  const samplePills = [\n    \'Show my beach photos\',\n    \'Find videos about AI\',\n    \'Find pictures with laptops\',\n    \'Show speaking event photos\'\n  ];\n\n  return (\n    <div className=\"space-y-6 max-w-6xl mx-auto\">\n      \n      {/* Header Controls & Filter Bar */}\n      <div className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-4\">\n        \n        <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n          \n          {/* Search input */}\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400\" strokeWidth={1.75} />\n            <input\n              type=\"text\"\n              value={filterState.searchQuery}\n              onChange={(e) => setFilterState((prev) => ({ ...prev, searchQuery: e.target.value }))}\n              placeholder=\"Search by filename, subject, or AI summary...\"\n              className=\"w-full pl-10 pr-4 h-11 text-sm rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-600/20 focus:border-blue-600 transition-all\"\n            />\n          </div>\n\n          {/* Quick Type Tabs */}\n          <div className=\"flex items-center gap-1 p-1 rounded-xl bg-gray-100 dark:bg-slate-800/80 border border-gray-200/80 dark:border-slate-700/80\">\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'all\' }))}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                filterState.mediaType === \'all\'\n                  ? \'bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              All ({items.length})\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'image\' }))}\n              className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                filterState.mediaType === \'image\'\n                  ? \'bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              <FileImage className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n              <span>Images</span>\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, mediaType: \'video\' }))}\n              className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                filterState.mediaType === \'video\'\n                  ? \'bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              <Video className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n              <span>Videos</span>\n            </button>\n          </div>\n\n        </div>\n\n        {/* Secondary dropdown filters */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-gray-100 dark:border-slate-800\">\n          \n          <div className=\"flex flex-wrap items-center gap-2\">\n            \n            {/* Folder Dropdown */}\n            <div className=\"flex items-center gap-1.5 px-3 h-9 rounded-xl bg-gray-50 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-700 text-xs text-gray-700 dark:text-slate-300\">\n              <Folder className=\"w-3.5 h-3.5 text-gray-400\" strokeWidth={1.75} />\n              <select\n                value={filterState.folder}\n                onChange={(e) => setFilterState((prev) => ({ ...prev, folder: e.target.value }))}\n                className=\"bg-transparent text-gray-800 dark:text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                <option value=\"all\">All Folders</option>\n                {folders.map((f) => (\n                  <option key={f} value={f}>{f}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Sort Dropdown */}\n            <div className=\"flex items-center gap-1.5 px-3 h-9 rounded-xl bg-gray-50 dark:bg-slate-800/80 border border-gray-200 dark:border-slate-700 text-xs text-gray-700 dark:text-slate-300\">\n              <ArrowUpDown className=\"w-3.5 h-3.5 text-gray-400\" strokeWidth={1.75} />\n              <select\n                value={filterState.sortBy}\n                onChange={(e) => setFilterState((prev) => ({ ...prev, sortBy: e.target.value as any }))}\n                className=\"bg-transparent text-gray-800 dark:text-slate-200 focus:outline-none cursor-pointer\"\n              >\n                <option value=\"newest\">Sort: Newest Uploads</option>\n                <option value=\"oldest\">Sort: Oldest Uploads</option>\n                <option value=\"name\">Sort: Filename (A-Z)</option>\n              </select>\n            </div>\n\n          </div>\n\n          {/* View Mode Switcher */}\n          <div className=\"flex items-center gap-1 p-1 rounded-xl bg-gray-100 dark:bg-slate-800/80 border border-gray-200/80 dark:border-slate-700/80\">\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, viewMode: \'grid\' }))}\n              className={`p-1.5 rounded-lg transition-all cursor-pointer ${\n                filterState.viewMode === \'grid\'\n                  ? \'bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-400 hover:text-gray-700 dark:hover:text-slate-200\'\n              }`}\n              title=\"Grid View\"\n            >\n              <Grid className=\"w-4 h-4\" strokeWidth={1.75} />\n            </button>\n            <button\n              onClick={() => setFilterState((prev) => ({ ...prev, viewMode: \'list\' }))}\n              className={`p-1.5 rounded-lg transition-all cursor-pointer ${\n                filterState.viewMode === \'list\'\n                  ? \'bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-400 hover:text-gray-700 dark:hover:text-slate-200\'\n              }`}\n              title=\"List View\"\n            >\n              <List className=\"w-4 h-4\" strokeWidth={1.75} />\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Smart Search Quick Sample Prompts */}\n      <div className=\"flex flex-wrap items-center gap-2 px-1\">\n        <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400 flex items-center gap-1.5\">\n          <Zap className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n          <span>Smart AI Prompts:</span>\n        </span>\n        {samplePills.map((pill) => (\n          <button\n            key={pill}\n            onClick={() => onRunSmartSearch(pill)}\n            disabled={isLoadingSmartSearch}\n            className=\"px-3 py-1.5 rounded-full text-xs font-medium bg-blue-50/80 dark:bg-blue-950/40 hover:bg-blue-100 dark:hover:bg-blue-900/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40 transition-all cursor-pointer disabled:opacity-50\"\n          >\n            \"{pill}\"\n          </button>\n        ))}\n      </div>\n\n      {/* Media Grid or List Output */}\n      {filteredItems.length > 0 ? (\n        <div className={\n          filterState.viewMode === \'grid\'\n            ? \'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\'\n            : \'space-y-3\'\n        }>\n          {filteredItems.map((item) => (\n            <MediaCard\n              key={item.id}\n              item={item}\n              viewMode={filterState.viewMode}\n              onSelectMedia={onSelectMedia}\n              onGenerateCaption={onGenerateCaption}\n              onToggleFavorite={onToggleFavorite}\n            />\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-16 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-dashed border-gray-300 dark:border-slate-800 p-8 space-y-3 shadow-card\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gray-50 dark:bg-slate-800 text-gray-400 flex items-center justify-center mx-auto\">\n            <Filter className=\"w-6 h-6\" strokeWidth={1.75} />\n          </div>\n          <h3 className=\"text-base font-semibold text-gray-900 dark:text-white\">\n            No media files match your filters\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Try adjusting your search query, switching folder selections, or importing new media from Google Drive.\n          </p>\n          <button\n            onClick={() => setFilterState({ searchQuery: \'\', mediaType: \'all\', folder: \'all\', sortBy: \'newest\', viewMode: \'grid\' })}\n            className=\"mt-2 px-4 h-10 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-colors cursor-pointer\"\n          >\n            Reset Filters\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
