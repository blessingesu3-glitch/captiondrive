  file_change {
    absolute_path_uri: "file:///src/components/SocialPublishView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Send, \n  CheckCircle2, \n  ShieldCheck, \n  Clock, \n  PlusCircle, \n  ExternalLink, \n  Trash2, \n  Instagram, \n  Linkedin, \n  Twitter, \n  Facebook,\n  RefreshCw,\n  Sparkles,\n  AlertCircle\n} from \'lucide-react\';\nimport { SocialAccount, SocialPost, SocialPlatform } from \'../types\';\n\ninterface SocialPublishViewProps {\n  socialAccounts: SocialAccount[];\n  socialPosts: SocialPost[];\n  onConnectAccount: (platform: SocialPlatform, handle?: string, account_name?: string) => Promise<void>;\n  onDisconnectAccount: (platform: SocialPlatform) => Promise<void>;\n  onApproveAndPublishPost: (postData: any) => Promise<void>;\n  onRefreshPosts: () => Promise<void>;\n}\n\nexport const SocialPublishView: React.FC<SocialPublishViewProps> = ({\n  socialAccounts,\n  socialPosts,\n  onConnectAccount,\n  onDisconnectAccount,\n  onApproveAndPublishPost,\n  onRefreshPosts\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<\'queue\' | \'accounts\' | \'history\'>(\'queue\');\n  const [isConnecting, setIsConnecting] = useState<string | null>(null);\n  const [connectModalPlatform, setConnectModalPlatform] = useState<SocialPlatform | null>(null);\n  const [customHandle, setCustomHandle] = useState<string>(\'\');\n  const [customPageName, setCustomPageName] = useState<string>(\'\');\n  const [publishingPostId, setPublishingPostId] = useState<string | null>(null);\n\n  const getPlatformIcon = (plat: SocialPlatform) => {\n    switch (plat) {\n      case \'Instagram\': return <Instagram className=\"w-5 h-5 text-pink-600\" />;\n      case \'LinkedIn\': return <Linkedin className=\"w-5 h-5 text-blue-600\" />;\n      case \'X\': return <Twitter className=\"w-5 h-5 text-slate-900 dark:text-white\" />;\n      case \'Facebook\': return <Facebook className=\"w-5 h-5 text-blue-700\" />;\n      default: return <Send className=\"w-5 h-5 text-indigo-600\" />;\n    }\n  };\n\n  const handleOpenConnect = (plat: SocialPlatform) => {\n    setConnectModalPlatform(plat);\n    setCustomHandle(`@${plat.toLowerCase()}_creator`);\n    setCustomPageName(`${plat} Creator Page`);\n  };\n\n  const handleConfirmConnect = async () => {\n    if (!connectModalPlatform) return;\n    setIsConnecting(connectModalPlatform);\n    try {\n      await onConnectAccount(connectModalPlatform, customHandle, customPageName);\n      setConnectModalPlatform(null);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setIsConnecting(null);\n    }\n  };\n\n  const handlePublishQueuedPost = async (post: SocialPost) => {\n    setPublishingPostId(post.id);\n    try {\n      await onApproveAndPublishPost({\n        media_filename: post.media_filename,\n        media_thumbnail: post.media_thumbnail,\n        platform: post.platform,\n        account_handle: post.account_handle,\n        caption_text: post.caption_text,\n        user_approved: true\n      });\n      await onRefreshPosts();\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setPublishingPostId(null);\n    }\n  };\n\n  const pendingPosts = socialPosts.filter(p => p.status === \'pending_approval\' || p.status === \'draft\');\n  const publishedPosts = socialPosts.filter(p => p.status === \'published\' || p.status === \'approved\');\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-6 rounded-2xl bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 text-white shadow-md\">\n        <div className=\"space-y-1 max-w-xl\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-white/10 text-indigo-300 text-[11px] font-bold uppercase tracking-wider\">\n            <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Authorized Social Publishing</span>\n          </div>\n          <h1 className=\"text-2xl font-extrabold tracking-tight\">\n            Social Media Accounts & Approval Queue\n          </h1>\n          <p className=\"text-xs text-indigo-200/90 leading-relaxed\">\n            Connect your Instagram, LinkedIn, X, and Facebook pages. Posts are published strictly upon explicit user approval.\n          </p>\n        </div>\n\n        <button\n          onClick={onRefreshPosts}\n          className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/15 backdrop-blur-md flex items-center gap-1.5 transition-colors cursor-pointer\"\n        >\n          <RefreshCw className=\"w-3.5 h-3.5\" />\n          <span>Refresh Queue</span>\n        </button>\n      </div>\n\n      {/* Sub Tabs */}\n      <div className=\"flex items-center gap-2 border-b border-gray-200 dark:border-slate-800 pb-3\">\n        <button\n          onClick={() => setActiveSubTab(\'queue\')}\n          className={`px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'queue\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700\'\n          }`}\n        >\n          <Clock className=\"w-4 h-4\" />\n          <span>Approval Queue ({pendingPosts.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'accounts\')}\n          className={`px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'accounts\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700\'\n          }`}\n        >\n          <Send className=\"w-4 h-4\" />\n          <span>Connected Pages ({socialAccounts.filter(a => a.is_connected).length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveSubTab(\'history\')}\n          className={`px-4 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center gap-2 ${\n            activeSubTab === \'history\'\n              ? \'bg-indigo-600 text-white shadow-xs\'\n              : \'bg-white dark:bg-slate-800 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700\'\n          }`}\n        >\n          <CheckCircle2 className=\"w-4 h-4\" />\n          <span>Published Posts ({publishedPosts.length})</span>\n        </button>\n      </div>\n\n      {/* SUB TAB 1: CONNECTED ACCOUNTS */}\n      {activeSubTab === \'accounts\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {([\'Instagram\', \'LinkedIn\', \'X\', \'Facebook\'] as SocialPlatform[]).map((plat) => {\n            const acc = socialAccounts.find(a => a.platform === plat);\n            const isConnected = acc?.is_connected;\n\n            return (\n              <div\n                key={plat}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 shadow-xs flex flex-col justify-between space-y-4\"\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700\">\n                      {getPlatformIcon(plat)}\n                    </div>\n                    <div>\n                      <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                        <span>{plat}</span>\n                        <span className={`text-[10px] font-bold px-2 py-0.5 rounded ${\n                          isConnected \n                            ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300\' \n                            : \'bg-gray-100 text-gray-500\'\n                        }`}>\n                          {isConnected ? \'Sync Active\' : \'Disconnected\'}\n                        </span>\n                      </h3>\n                      <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                        {acc?.page_type || `${plat} Creator / Business Page`}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {isConnected && acc ? (\n                  <div className=\"p-3 rounded-lg bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2.5\">\n                      <img src={acc.avatar} alt={acc.account_name} className=\"w-8 h-8 rounded-full object-cover\" />\n                      <div>\n                        <p className=\"text-xs font-bold text-gray-900 dark:text-white\">{acc.account_name}</p>\n                        <p className=\"text-[10px] text-gray-500 dark:text-slate-400\">{acc.handle}</p>\n                      </div>\n                    </div>\n                    <button\n                      onClick={() => onDisconnectAccount(plat)}\n                      className=\"px-3 py-1 rounded text-xs font-semibold text-red-600 hover:bg-red-50 dark:hover:bg-red-950 transition-colors cursor-pointer\"\n                    >\n                      Disconnect\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"p-3 rounded-lg bg-gray-50 dark:bg-slate-900/60 border border-dashed border-gray-300 dark:border-slate-700 flex items-center justify-between\">\n                    <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                      Connect your page to post with user approval\n                    </p>\n                    <button\n                      onClick={() => handleOpenConnect(plat)}\n                      className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center gap-1 transition-transform active:scale-95 cursor-pointer\"\n                    >\n                      <PlusCircle className=\"w-3.5 h-3.5\" />\n                      <span>Connect Page</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* SUB TAB 2: APPROVAL QUEUE */}\n      {activeSubTab === \'queue\' && (\n        <div className=\"space-y-4\">\n          {pendingPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 space-y-3\">\n              <div className=\"w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950 text-indigo-600 mx-auto flex items-center justify-center\">\n                <CheckCircle2 className=\"w-6 h-6\" />\n              </div>\n              <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">All Clear! No Pending Approvals</h3>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-md mx-auto\">\n                Generate captions from your Drive media library and click \"Post to Social Media\" to queue posts here for review and authorization.\n              </p>\n            </div>\n          ) : (\n            pendingPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border-l-4 border-amber-500 border border-gray-200 dark:border-slate-700 shadow-xs space-y-4\"\n              >\n                <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded bg-amber-50 text-amber-800 dark:bg-amber-950 dark:text-amber-300 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3\" />\n                      Awaiting User Approval\n                    </span>\n                    <span className=\"text-xs font-bold text-gray-900 dark:text-white flex items-center gap-1\">\n                      {getPlatformIcon(post.platform)}\n                      <span>{post.platform}</span>\n                    </span>\n                    <span className=\"text-xs text-gray-400\">\342\200\242</span>\n                    <span className=\"text-xs text-gray-500 dark:text-slate-400\">{post.account_handle}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => handlePublishQueuedPost(post)}\n                      disabled={publishingPostId === post.id}\n                      className=\"px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs cursor-pointer disabled:opacity-50\"\n                    >\n                      {publishingPostId === post.id ? (\n                        <>\n                          <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                          <span>Publishing...</span>\n                        </>\n                      ) : (\n                        <>\n                          <Send className=\"w-3.5 h-3.5\" />\n                          <span>Approve & Post Now</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3 rounded-lg bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-16 h-16 rounded-lg object-cover border border-gray-200 dark:border-slate-700 shrink-0\"\n                  />\n                  <div className=\"flex-1 min-w-0 space-y-1\">\n                    <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                      {post.media_filename}\n                    </p>\n                    <p className=\"text-xs text-gray-700 dark:text-slate-300 font-sans whitespace-pre-wrap line-clamp-3 leading-relaxed\">\n                      {post.caption_text}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* SUB TAB 3: PUBLISHED HISTORY */}\n      {activeSubTab === \'history\' && (\n        <div className=\"space-y-4\">\n          {publishedPosts.length === 0 ? (\n            <div className=\"p-12 text-center rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-xs text-gray-500\">\n              No published posts yet.\n            </div>\n          ) : (\n            publishedPosts.map((post) => (\n              <div\n                key={post.id}\n                className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border-l-4 border-emerald-500 border border-gray-200 dark:border-slate-700 shadow-xs space-y-3\"\n              >\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold uppercase text-[10px] flex items-center gap-1\">\n                      <CheckCircle2 className=\"w-3 h-3\" />\n                      Published Live\n                    </span>\n                    <span className=\"text-gray-300\">\342\200\242</span>\n                    <span className=\"font-bold text-gray-900 dark:text-white\">{post.platform} ({post.account_handle})</span>\n                  </div>\n\n                  {post.post_url && (\n                    <a\n                      href={post.post_url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1\"\n                    >\n                      <span>View Live Post</span>\n                      <ExternalLink className=\"w-3.5 h-3.5\" />\n                    </a>\n                  )}\n                </div>\n\n                <div className=\"flex items-start gap-4 p-3 rounded-lg bg-gray-50 dark:bg-slate-900\">\n                  <img\n                    src={post.media_thumbnail}\n                    alt={post.media_filename}\n                    className=\"w-14 h-14 rounded-lg object-cover shrink-0\"\n                  />\n                  <p className=\"text-xs text-gray-800 dark:text-slate-200 whitespace-pre-wrap leading-relaxed line-clamp-3\">\n                    {post.caption_text}\n                  </p>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n      )}\n\n      {/* CONNECT PAGE MODAL */}\n      {connectModalPlatform && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs\">\n          <div className=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl w-full max-w-md p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                {getPlatformIcon(connectModalPlatform)}\n                <span>Connect {connectModalPlatform} Page</span>\n              </h3>\n              <button onClick={() => setConnectModalPlatform(null)} className=\"text-gray-400 hover:text-gray-600 cursor-pointer\">\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Page / Profile Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={customPageName}\n                  onChange={(e) => setCustomPageName(e.target.value)}\n                  className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-bold text-gray-700 dark:text-slate-300 block mb-1\">\n                  Handle / Username\n                </label>\n                <input\n                  type=\"text\"\n                  value={customHandle}\n                  onChange={(e) => setCustomHandle(e.target.value)}\n                  className=\"w-full p-2.5 text-xs rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2 pt-2\">\n              <button\n                onClick={() => setConnectModalPlatform(null)}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold text-gray-600 dark:text-slate-300 cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                onClick={handleConfirmConnect}\n                disabled={isConnecting !== null}\n                className=\"px-4 py-2 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer\"\n              >\n                {isConnecting ? \'Connecting...\' : \'Authorize & Connect\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
