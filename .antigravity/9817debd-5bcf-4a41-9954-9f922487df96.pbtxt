    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { \n  Sparkles, \n  FolderOpen, \n  History, \n  HardDrive, \n  PlusCircle, \n  ArrowRight, \n  Flame, \n  Zap, \n  Copy, \n  Check, \n  FileImage, \n  Video,\n  CheckCircle2\n} from \'lucide-react\';\nimport { MediaItem, CaptionHistoryItem, User } from \'../types\';\n\ninterface DashboardViewProps {\n  mediaItems: MediaItem[];\n  captionHistory: CaptionHistoryItem[];\n  user: User;\n  onConnectDrive: () => void;\n  onOpenMediaLibrary: () => void;\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onOpenImportModal: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  mediaItems,\n  captionHistory,\n  user,\n  onConnectDrive,\n  onOpenMediaLibrary,\n  onSelectMedia,\n  onGenerateCaption,\n  onOpenImportModal,\n}) => {\n  const recentMedia = mediaItems.slice(0, 4);\n  const recentCaptions = captionHistory.slice(0, 3);\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Welcome Banner */}\n      <div className=\"p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-100 dark:bg-slate-800 text-gray-800 dark:text-slate-200 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 uppercase tracking-wider\">\n              <Sparkles className=\"w-3.5 h-3.5 text-gray-900 dark:text-white\" />\n              <span>AI Media Analysis & Social Publisher</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white\">\n              Hello, {user.name.split(\' \')[0]} \360\237\221\213\n            </h1>\n            \n            <p className=\"text-xs sm:text-sm text-gray-600 dark:text-slate-400 leading-relaxed\">\n              Scan Google Drive media, analyze photos or videos using Gemini multimodal vision, generate platform-specific captions, and schedule post approvals.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {user.isDriveConnected ? (\n              <button\n                onClick={onOpenImportModal}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-gray-900 hover:bg-black dark:bg-white dark:hover:bg-slate-100 text-white dark:text-gray-900 shadow-2xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>Import File</span>\n              </button>\n            ) : (\n              <button\n                onClick={onConnectDrive}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <span>Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        \n        {/* Metric 1 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <FolderOpen className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {mediaItems.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Synced Drive Assets\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {captionHistory.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Captions Generated\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <HardDrive className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-1.5\">\n              {user.isDriveConnected ? (\n                <>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500\" />\n                  <span>Sync Active</span>\n                </>\n              ) : (\n                <span>Action Needed</span>\n              )}\n            </span>\n            <span className=\"text-xs text-gray-500 dark:text-slate-400 truncate max-w-[150px] block\">\n              {user.isDriveConnected ? user.connectedDriveEmail : \'Drive Sync Inactive\'}\n            </span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Recently Synced Media */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-base font-bold text-gray-900 dark:text-white\">\n              Recent Media\n            </h3>\n            <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n              Select any photo or video to analyze or generate captions\n            </p>\n          </div>\n\n          <button\n            onClick={onOpenMediaLibrary}\n            className=\"text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 cursor-pointer\"\n          >\n            <span>View All</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {recentMedia.map((item) => (\n            <div\n              key={item.id}\n              onClick={() => onSelectMedia(item)}\n              className=\"group relative rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 overflow-hidden hover:border-gray-400 dark:hover:border-slate-600 cursor-pointer transition-all shadow-2xs\"\n            >\n              <div className=\"aspect-video w-full overflow-hidden relative bg-gray-100 dark:bg-slate-900\">\n                <img src={item.thumbnail} alt={item.filename} className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\" />\n                <div className=\"absolute top-2 left-2 px-2 py-0.5 rounded bg-black/60 backdrop-blur-xs text-white text-[10px] font-semibold flex items-center gap-1\">\n                  {item.file_type === \'video\' ? <Video className=\"w-3 h-3 text-white\" /> : <FileImage className=\"w-3 h-3 text-white\" />}\n                  <span className=\"capitalize\">{item.file_type}</span>\n                </div>\n              </div>\n\n              <div className=\"p-3 space-y-2\">\n                <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                  {item.filename}\n                </h4>\n\n                <button\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    onGenerateCaption(item);\n                  }}\n                  className=\"w-full py-1.5 px-3 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-900 hover:text-white dark:bg-slate-800 dark:hover:bg-white dark:hover:text-gray-900 text-gray-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5 cursor-pointer\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Generate Captions</span>\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Recent Captions Feed */}\n      {recentCaptions.length > 0 && (\n        <div className=\"space-y-4 pt-2\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n              <History className=\"w-4 h-4 text-gray-600 dark:text-slate-400\" />\n              <span>Recent Generated Captions</span>\n            </h3>\n          </div>\n\n          <div className=\"space-y-3\">\n            {recentCaptions.map((hist) => (\n              <div\n                key={hist.id}\n                className=\"p-4 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 space-y-2 shadow-2xs\"\n              >\n                <div className=\"flex items-center justify-between gap-2 text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-gray-100 text-gray-800 dark:bg-slate-800 dark:text-slate-200 font-semibold text-[10px] uppercase\">\n                      {hist.platform}\n                    </span>\n                    <span className=\"text-gray-300\">\342\200\242</span>\n                    <span className=\"text-gray-600 dark:text-slate-300 font-medium\">{hist.tone}</span>\n                    <span className=\"text-gray-300\">\342\200\242</span>\n                    <span className=\"text-gray-500 dark:text-slate-400 truncate max-w-[150px]\">{hist.media_filename}</span>\n                  </div>\n\n                  <span className=\"text-[11px] text-gray-400\">\n                    {new Date(hist.created_at).toLocaleDateString()}\n                  </span>\n                </div>\n\n                <div className=\"p-3 rounded-lg bg-gray-50 dark:bg-slate-800/80 text-xs text-gray-800 dark:text-slate-200 font-sans whitespace-pre-wrap leading-relaxed border border-gray-200/60 dark:border-slate-700/60\">\n                  <strong>{hist.caption_variation.hook}</strong>\n                  {\'\\n\\n\'}\n                  {hist.caption_variation.body}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { \n  Sparkles, \n  FolderOpen, \n  History, \n  HardDrive, \n  Plus, \n  ArrowRight, \n  Zap, \n  Copy, \n  Check, \n  FileImage, \n  Video,\n  CheckCircle2,\n  Calendar,\n  Send,\n  TrendingUp,\n  Bot\n} from \'lucide-react\';\nimport { MediaItem, CaptionHistoryItem, User } from \'../types\';\n\ninterface DashboardViewProps {\n  mediaItems: MediaItem[];\n  captionHistory: CaptionHistoryItem[];\n  user: User;\n  onConnectDrive: () => void;\n  onOpenMediaLibrary: () => void;\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onOpenImportModal: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  mediaItems,\n  captionHistory,\n  user,\n  onConnectDrive,\n  onOpenMediaLibrary,\n  onSelectMedia,\n  onGenerateCaption,\n  onOpenImportModal,\n}) => {\n  const [copiedId, setCopiedId] = React.useState<string | null>(null);\n  const recentMedia = mediaItems.slice(0, 4);\n  const recentCaptions = captionHistory.slice(0, 3);\n\n  const handleCopyText = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const aiPrompts = [\n    \"Generate Instagram Reel caption for latest video\",\n    \"Create 3 LinkedIn post variations with high hooks\",\n    \"Extract key quote summary from recent footage\",\n    \"Analyze visual mood and color tone for storytelling\"\n  ];\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn max-w-6xl mx-auto\">\n      \n      {/* Proactive AI Greeting Card */}\n      <div className=\"p-6 sm:p-8 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-5\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          <div className=\"space-y-2\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 text-xs font-semibold border border-blue-100 dark:border-blue-900/50\">\n              <Sparkles className=\"w-3.5 h-3.5 fill-current\" strokeWidth={1.75} />\n              <span>Proactive AI Studio</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white\">\n              What would you like to create today, {user.name ? user.name.split(\' \')[0] : \'Blessing\'}?\n            </h1>\n            \n            <p className=\"text-sm text-gray-500 dark:text-slate-400 max-w-2xl leading-relaxed\">\n              CaptionDrive analyzes your Google Drive photos and videos using multimodal AI to write high-converting social captions and schedule posts seamlessly.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            <button\n              onClick={onOpenImportModal}\n              className=\"px-4 h-11 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition-all active:scale-[0.98] flex items-center gap-2 cursor-pointer\"\n            >\n              <Plus className=\"w-4 h-4\" strokeWidth={2} />\n              <span>Upload Content</span>\n            </button>\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 h-11 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 hover:bg-gray-50 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-2 transition-colors cursor-pointer\"\n            >\n              <span>View Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5 text-gray-500\" strokeWidth={1.75} />\n            </button>\n          </div>\n        </div>\n\n        {/* AI Action Chips */}\n        <div className=\"pt-3 border-t border-gray-100 dark:border-slate-800/80\">\n          <p className=\"text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider mb-2.5\">\n            Quick AI Actions\n          </p>\n          <div className=\"flex flex-wrap gap-2\">\n            {aiPrompts.map((prompt, idx) => (\n              <button\n                key={idx}\n                onClick={onOpenMediaLibrary}\n                className=\"px-3 py-2 rounded-xl text-xs font-medium bg-gray-50 hover:bg-gray-100 dark:bg-slate-800/60 dark:hover:bg-slate-800 text-gray-700 dark:text-slate-300 border border-gray-200/80 dark:border-slate-700/80 transition-all cursor-pointer flex items-center gap-2\"\n              >\n                <Zap className=\"w-3 h-3 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n                <span>{prompt}</span>\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Clean Statistics Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        \n        {/* Metric 1 */}\n        <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-200/80 dark:border-slate-700/80 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <FolderOpen className=\"w-5 h-5 text-gray-700 dark:text-slate-300\" strokeWidth={1.75} />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {mediaItems.length}\n            </span>\n            <span className=\"text-xs font-medium text-gray-500 dark:text-slate-400\">\n              Content Assets\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/60 border border-blue-100 dark:border-blue-900/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-5 h-5 fill-current\" strokeWidth={1.75} />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {captionHistory.length}\n            </span>\n            <span className=\"text-xs font-medium text-gray-500 dark:text-slate-400\">\n              Captions Generated\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-100 dark:border-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0\">\n            <Send className=\"w-5 h-5\" strokeWidth={1.75} />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              4\n            </span>\n            <span className=\"text-xs font-medium text-gray-500 dark:text-slate-400\">\n              Social Channels\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 4 */}\n        <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-xl bg-purple-50 dark:bg-purple-950/60 border border-purple-100 dark:border-purple-900/60 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0\">\n            <Calendar className=\"w-5 h-5\" strokeWidth={1.75} />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              2 Scheduled\n            </span>\n            <span className=\"text-xs font-medium text-gray-500 dark:text-slate-400\">\n              Post Pipeline\n            </span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Content Library Grid Preview */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-lg font-bold text-gray-900 dark:text-white\">\n              Recent Assets\n            </h3>\n            <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n              Photos and videos synced from Google Drive\n            </p>\n          </div>\n\n          <button\n            onClick={onOpenMediaLibrary}\n            className=\"text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 cursor-pointer\"\n          >\n            <span>View All Assets</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {recentMedia.map((item) => (\n            <div\n              key={item.id}\n              onClick={() => onSelectMedia(item)}\n              className=\"group relative rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 overflow-hidden hover:border-gray-300 dark:hover:border-slate-700 cursor-pointer transition-all shadow-card\"\n            >\n              <div className=\"aspect-video w-full overflow-hidden relative bg-gray-100 dark:bg-slate-900\">\n                <img src={item.thumbnail} alt={item.filename} className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\" />\n                <div className=\"absolute top-3 left-3 px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-white text-[10px] font-semibold flex items-center gap-1\">\n                  {item.file_type === \'video\' ? <Video className=\"w-3 h-3 text-white\" strokeWidth={1.75} /> : <FileImage className=\"w-3 h-3 text-white\" strokeWidth={1.75} />}\n                  <span className=\"capitalize\">{item.file_type}</span>\n                </div>\n              </div>\n\n              <div className=\"p-4 space-y-3\">\n                <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                  {item.filename}\n                </h4>\n\n                <button\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    onGenerateCaption(item);\n                  }}\n                  className=\"w-full h-9 rounded-xl text-xs font-semibold bg-gray-50 hover:bg-blue-600 hover:text-white dark:bg-slate-800 dark:hover:bg-blue-600 text-gray-800 dark:text-slate-200 transition-all flex items-center justify-center gap-2 cursor-pointer border border-gray-200/80 dark:border-slate-700/80\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                  <span>Generate Caption</span>\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Recent Generated Captions History */}\n      {recentCaptions.length > 0 && (\n        <div className=\"space-y-4 pt-2\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n              <History className=\"w-4.5 h-4.5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n              <span>Latest AI Activity</span>\n            </h3>\n          </div>\n\n          <div className=\"space-y-3\">\n            {recentCaptions.map((hist) => (\n              <div\n                key={hist.id}\n                className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 space-y-3 shadow-card\"\n              >\n                <div className=\"flex items-center justify-between gap-2 text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300 font-semibold text-[11px] uppercase\">\n                      {hist.platform}\n                    </span>\n                    <span className=\"text-gray-300 dark:text-slate-700\">\342\200\242</span>\n                    <span className=\"text-gray-600 dark:text-slate-300 font-medium\">{hist.tone} Tone</span>\n                    <span className=\"text-gray-300 dark:text-slate-700\">\342\200\242</span>\n                    <span className=\"text-gray-500 dark:text-slate-400 truncate max-w-[180px]\">{hist.media_filename}</span>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      onClick={() => handleCopyText(`${hist.caption_variation.hook}\\n\\n${hist.caption_variation.body}`, hist.id)}\n                      className=\"px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-50 hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1 cursor-pointer\"\n                    >\n                      {copiedId === hist.id ? <Check className=\"w-3 h-3 text-emerald-600\" /> : <Copy className=\"w-3 h-3\" />}\n                      <span>{copiedId === hist.id ? \'Copied\' : \'Copy\'}</span>\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/50 text-xs text-gray-800 dark:text-slate-200 font-sans whitespace-pre-wrap leading-relaxed border border-gray-200/60 dark:border-slate-700/60\">\n                  <p className=\"font-semibold text-gray-900 dark:text-white mb-1\">{hist.caption_variation.hook}</p>\n                  <p>{hist.caption_variation.body}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
