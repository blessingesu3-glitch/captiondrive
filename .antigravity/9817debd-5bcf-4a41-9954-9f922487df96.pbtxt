rk:border-slate-700\" />\n          ) : (\n            <div className=\"w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 flex items-center justify-center font-bold text-xs\">\n              {user.name ? user.name.split(\' \').map(n => n[0]).join(\'\') : \'BE\'}\n            </div>\n          )}\n          <div className=\"flex-1 min-w-0\">\n            <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">{user.name || \'Blessing Esu\'}</p>\n            <p className=\"text-[11px] text-gray-500 dark:text-slate-400 truncate\">{user.email || \'blessingesu3@gmail.com\'}</p>\n          </div>\n        </div>\n      </div>\n\n    </aside>\n  );"
        replacement_content: "  return (\n    <aside className=\"w-[260px] shrink-0 hidden md:flex flex-col border-r border-[#E6E4DD] dark:border-[#22242F] bg-[#FAF8F5]/80 dark:bg-[#0D0E12] min-h-[calc(100vh-4rem)] p-4 transition-colors\">\n      \n      {/* Navigation section */}\n      <nav className=\"space-y-1 flex-1\">\n        <div className=\"px-3 py-2 text-[10px] font-mono tracking-widest text-[#121212]/50 dark:text-slate-500 uppercase\">\n          WORKSPACE // CREATIVE\n        </div>\n        \n        {mainNavItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => onSelectTab(item.id)}\n              className={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-xs font-semibold tracking-tight transition-all duration-150 cursor-pointer ${\n                isActive\n                  ? \'text-[#121212] bg-white dark:bg-[#1E202B] dark:text-white border border-[#E6E4DD] dark:border-[#2E3140] shadow-2xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:bg-gray-100/60 dark:hover:bg-[#151720] hover:text-[#121212] dark:hover:text-white\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <Icon \n                  className={`w-4 h-4 transition-colors ${\n                    isActive \n                      ? \'text-[#FF3B00]\' \n                      : \'text-gray-400 dark:text-slate-500\'\n                  }`} \n                  strokeWidth={1.75}\n                />\n                <span>{item.label}</span>\n              </div>\n              \n              {item.badge && (\n                <span className={`text-[10px] font-mono px-2 py-0.5 rounded ${\n                  isActive \n                    ? \'bg-[#FF3B00] text-white\' \n                    : \'bg-gray-100 text-gray-500 dark:bg-[#1E202B] dark:text-slate