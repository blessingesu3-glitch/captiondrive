  file_change {
    absolute_path_uri: "file:///src/components/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Sparkles, \n  FolderOpen, \n  History, \n  Plus, \n  ArrowRight, \n  Zap, \n  Copy, \n  Check, \n  FileImage, \n  Video, \n  HardDrive,\n  Eye,\n  Sliders,\n  Tag,\n  Clock,\n  Send,\n  Layers,\n  Film\n} from \'lucide-react\';\nimport { MediaItem, CaptionHistoryItem, User } from \'../types\';\n\ninterface DashboardViewProps {\n  mediaItems: MediaItem[];\n  captionHistory: CaptionHistoryItem[];\n  user: User;\n  onConnectDrive: () => void;\n  onOpenMediaLibrary: () => void;\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onOpenImportModal: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  mediaItems,\n  captionHistory,\n  user,\n  onConnectDrive,\n  onOpenMediaLibrary,\n  onSelectMedia,\n  onGenerateCaption,\n  onOpenImportModal,\n}) => {\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n  const [featuredIndex, setFeaturedIndex] = useState<number>(0);\n\n  const featuredMedia: MediaItem | undefined = mediaItems[featuredIndex] || mediaItems[0];\n  const secondaryMedia = mediaItems.filter((_, idx) => idx !== featuredIndex).slice(0, 5);\n  const recentCaptions = captionHistory.slice(0, 3);\n\n  const handleCopyText = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const aiPresets = [\n    { title: \"High-Converting Reel Hook\", channel: \"Instagram\", tag: \"VIRAL\" },\n    { title: \"Thought Leadership Story\", channel: \"LinkedIn\", tag: \"LONG-FORM\" },\n    { title: \"Punchy Product Teaser\", channel: \"X / Twitter\", tag: \"SHORT\" },\n    { title: \"Carousel Slide Summary\", channel: \"Facebook\", tag: \"ENGAGEMENT\" },\n  ];\n\n  const currentDateFormatted = new Date().toLocaleDateString(\'en-US\', {\n    weekday: \'short\',\n    month: \'short\',\n    day: \'numeric\',\n    year: \'numeric\'\n  }).toUpperCase();\n\n  return (\n    <div className=\"space-y-12 animate-fadeIn max-w-7xl mx-auto pb-12 font-sans\">\n      \n      {/* 1. TOP EDITORIAL META BANNER */}\n      <div className=\"border-b border-[#E6E4DD] dark:border-[#22242F] pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono uppercase tracking-widest text-[#121212]/60 dark:text-slate-400\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"inline-block w-2 h-2 rounded-full bg-[#FF3B00] animate-pulse\" />\n          <span>STUDIO WORKSPACE // VOL. 01</span>\n          <span>\342\200\242</span>\n          <span>DRIVE SYNC: {user.isDriveConnected ? \'ONLINE\' : \'LOCAL CACHE\'}</span>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <span>{currentDateFormatted}</span>\n          <span>\342\200\242</span>\n          <span className=\"text-[#FF3B00] font-bold\">{mediaItems.length} ASSETS READY</span>\n        </div>\n      </div>\n\n      {/* 2. OVERSIZED TYPOGRAPHIC GREETING & ASYMMETRIC HEADER */}\n      <div className=\"grid lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Column: Bold Typographic Statement */}\n        <div className=\"lg:col-span-8 space-y-4\">\n          <div className=\"inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#FF3B00]/10 text-[#FF3B00] text-[10px] font-mono tracking-widest uppercase font-bold\">\n            <Sparkles className=\"w-3 h-3 fill-current\" strokeWidth={2} />\n            <span>GEMINI VISION CAPTION STUDIO</span>\n          </div>\n\n          <h1 className=\"text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-[#121212] dark:text-white leading-[0.95] font-sans\">\n            Good morning, <br />\n            <span className=\"text-[#FF3B00]\">{user.name ? user.name.split(\' \')[0] : \'Creator\'}.</span>\n          </h1>\n\n          <p className=\"text-sm sm:text-base text-gray-600 dark:text-slate-300 max-w-2xl leading-relaxed pt-2 font-normal\">\n            Your studio content repository is connected. Select any asset below to trigger instant visual analysis, multi-platform narrative hooks, and publication-ready captions.\n          </p>\n        </div>\n\n        {/* Right Column: Studio Quick Actions & Metric Index */}\n        <div className=\"lg:col-span-4 p-6 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card space-y-6\">\n          <div className=\"flex items-center justify-between border-b border-[#E6E4DD] dark:border-[#22242F] pb-3\">\n            <span className=\"text-[10px] font-mono tracking-widest text-[#121212]/50 dark:text-slate-500 uppercase font-bold\">\n              STUDIO INDEX\n            </span>\n            <span className=\"text-[10px] font-mono text-[#FF3B00] font-bold\">LIVE</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 text-left\">\n            <div>\n              <span className=\"text-2xl sm:text-3xl font-extrabold text-[#121212] dark:text-white block font-sans\">\n                {mediaItems.length}\n              </span>\n              <span className=\"text-[10px] font-mono text-gray-500 dark:text-slate-400 uppercase tracking-widest block mt-0.5\">\n                Drive Assets\n              </span>\n            </div>\n\n            <div>\n              <span className=\"text-2xl sm:text-3xl font-extrabold text-[#121212] dark:text-white block font-sans\">\n                {captionHistory.length}\n              </span>\n              <span className=\"text-[10px] font-mono text-gray-500 dark:text-slate-400 uppercase tracking-widest block mt-0.5\">\n                Captions Built\n              </span>\n            </div>\n          </div>\n\n          <div className=\"pt-2 border-t border-[#E6E4DD] dark:border-[#22242F] space-y-2\">\n            <button\n              onClick={onOpenImportModal}\n              className=\"w-full h-10 rounded-lg text-xs font-bold bg-[#FF3B00] hover:bg-[#E03400] text-white transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer shadow-2xs\"\n            >\n              <Plus className=\"w-4 h-4\" strokeWidth={2.5} />\n              <span>IMPORT NEW MEDIA</span>\n            </button>\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"w-full h-10 rounded-lg text-xs font-bold font-mono bg-[#FAF8F5] dark:bg-[#1E202B] hover:bg-[#F0EDE6] dark:hover:bg-[#282B3A] text-[#121212] dark:text-slate-200 border border-[#E6E4DD] dark:border-[#2E3140] flex items-center justify-center gap-2 transition-all cursor-pointer\"\n            >\n              <span>EXPLORE ALL ASSETS</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" strokeWidth={2} />\n            </button>\n          </div>\n        </div>\n\n      </div>\n\n      <hr className=\"border-[#E6E4DD] dark:border-[#22242F]\" />\n\n      {/* 3. PROMINENT FEATURED MEDIA STAGE (ASYMMETRIC 8/4 COMPOSITION) */}\n      <div className=\"space-y-6\">\n        \n        <div className=\"flex items-center justify-between pb-2\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#121212] text-white dark:bg-white dark:text-[#121212] uppercase tracking-widest\">\n              SPOTLIGHT\n            </span>\n            <h2 className=\"text-xl sm:text-2xl font-extrabold text-[#121212] dark:text-white uppercase tracking-tight font-sans\">\n              FEATURED CREATIVE ASSET\n            </h2>\n          </div>\n\n          <span className=\"text-xs font-mono text-gray-500 dark:text-slate-400 hidden sm:block\">\n            ASSET {featuredIndex + 1} OF {mediaItems.length}\n          </span>\n        </div>\n\n        {featuredMedia ? (\n          <div className=\"grid lg:grid-cols-12 gap-8 items-stretch bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] rounded-2xl overflow-hidden shadow-card\">\n            \n            {/* Left 7 Columns: Prominent Media Stage Display */}\n            <div className=\"lg:col-span-7 bg-[#0D0E12] relative min-h-[360px] sm:min-h-[440px] flex items-center justify-center overflow-hidden group\">\n              <img \n                src={featuredMedia.preview_url || featuredMedia.thumbnail} \n                alt={featuredMedia.filename}\n                className=\"w-full h-full object-contain max-h-[500px]\"\n              />\n\n              {/* Top Badges Overlay */}\n              <div className=\"absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none\">\n                <span className=\"px-3 py-1 rounded bg-[#121212]/90 backdrop-blur-xs text-white text-[10px] font-mono tracking-widest uppercase flex items-center gap-1.5 border border-white/10\">\n                  {featuredMedia.file_type === \'video\' ? <Video className=\"w-3.5 h-3.5 text-[#FF3B00]\" /> : <FileImage className=\"w-3.5 h-3.5 text-[#FF3B00]\" />}\n                  <span>{featuredMedia.file_type} // {featuredMedia.duration || featuredMedia.size_formatted || \'4K\'}</span>\n                </span>\n\n                <span className=\"px-2.5 py-1 rounded bg-[#FF3B00] text-white text-[10px] font-mono font-bold uppercase tracking-widest shadow-2xs\">\n                  FOLDER: {featuredMedia.folder}\n                </span>\n              </div>\n\n              {/* Bottom Quick Inspect Bar */}\n              <div className=\"absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-[#121212]/85 backdrop-blur-md text-white border border-white/10 flex items-center justify-between text-xs font-mono\">\n                <span className=\"truncate max-w-[240px] font-bold text-slate-200\">\n                  {featuredMedia.filename}\n                </span>\n\n                <button\n                  onClick={() => onSelectMedia(featuredMedia)}\n                  className=\"px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-white transition-colors cursor-pointer flex items-center gap-1 text-[10px] font-mono uppercase\"\n                >\n                  <Eye className=\"w-3 h-3 text-[#FF3B00]\" />\n                  <span>Inspect Metadata</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Right 5 Columns: Editorial Asset Analysis & Caption Generator Prompt Stage */}\n            <div className=\"lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-6\">\n              \n              <div className=\"space-y-5\">\n                <div className=\"space-y-2 border-b border-[#E6E4DD] dark:border-[#22242F] pb-4\">\n                  <span className=\"text-[10px] font-mono tracking-widest text-[#FF3B00] uppercase font-bold block\">\n                    AI VISION ANALYSIS // READY\n                  </span>\n                  <h3 className=\"text-xl font-extrabold text-[#121212] dark:text-white leading-snug font-sans\">\n                    {featuredMedia.filename}\n                  </h3>\n                  <p className=\"text-xs font-mono text-gray-500 dark:text-slate-400\">\n                    Uploaded: {new Date(featuredMedia.uploaded_at).toLocaleDateString()} \342\200\242 {featuredMedia.size_formatted || \'1.4 MB\'}\n                  </p>\n                </div>\n\n                {/* AI Visual Tags Breakdown */}\n                {featuredMedia.ai_analysis ? (\n                  <div className=\"space-y-3\">\n                    <div className=\"p-3.5 rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] space-y-2\">\n                      <span className=\"text-[10px] font-mono text-[#121212]/60 dark:text-slate-400 uppercase tracking-widest block font-bold\">\n                        VISUAL MOOD & SUMMARY\n                      </span>\n                      <p className=\"text-xs text-[#121212] dark:text-slate-200 font-sans leading-relaxed\">\n                        \"{featuredMedia.ai_analysis.overall_summary || featuredMedia.ai_analysis.main_subject}\"\n                      </p>\n                    </div>\n\n                    <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                      {featuredMedia.ai_analysis.mood && (\n                        <span className=\"px-2.5 py-1 rounded bg-[#FF3B00]/10 text-[#FF3B00] text-[10px] font-mono font-bold uppercase\">\n                          MOOD: {featuredMedia.ai_analysis.mood}\n                        </span>\n                      )}\n                      {featuredMedia.ai_analysis.colors?.map((c, i) => (\n                        <span key={i} className=\"px-2.5 py-1 rounded bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] text-[10px] font-mono text-gray-600 dark:text-slate-300\">\n                          #{c}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"p-4 rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] text-xs text-gray-500 font-mono\">\n                    Visual Analysis ready for Gemini Studio processing.\n                  </div>\n                )}\n              </div>\n\n              {/* Primary Studio Action */}\n              <div className=\"space-y-3 pt-4 border-t border-[#E6E4DD] dark:border-[#22242F]\">\n                <button\n                  onClick={() => onGenerateCaption(featuredMedia)}\n                  className=\"w-full h-12 rounded-lg text-xs font-bold bg-[#FF3B00] hover:bg-[#E03400] text-white transition-all active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer shadow-2xs font-mono uppercase\"\n                >\n                  <Sparkles className=\"w-4 h-4 fill-current\" strokeWidth={2} />\n                  <span>GENERATE CAPTIONS FOR THIS ASSET</span>\n                </button>\n\n                <p className=\"text-[10px] font-mono text-center text-gray-400 dark:text-slate-500\">\n                  Generates Instagram, LinkedIn, X, and Facebook variations with hooks\n                </p>\n              </div>\n\n            </div>\n\n          </div>\n        ) : null}\n\n        {/* Secondary Media Selector Strip (Filmstrip High-Rhythm Index) */}\n        {secondaryMedia.length > 0 && (\n          <div className=\"pt-4 space-y-3\">\n            <span className=\"text-[10px] font-mono tracking-widest text-[#121212]/60 dark:text-slate-400 uppercase font-bold block\">\n              SWAP FEATURED ASSET // QUICK SELECT\n            </span>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3\">\n              {mediaItems.slice(0, 5).map((item, idx) => {\n                const isSelected = item.id === featuredMedia?.id;\n                return (\n                  <button\n                    key={item.id}\n                    onClick={() => setFeaturedIndex(idx)}\n                    className={`group p-2.5 rounded-xl text-left border transition-all cursor-pointer flex items-center gap-3 ${\n                      isSelected\n                        ? \'border-[#FF3B00] bg-[#FF3B00]/10 text-[#FF3B00]\'\n                        : \'border-[#E6E4DD] dark:border-[#22242F] bg-white dark:bg-[#151720] hover:border-gray-400\'\n                    }`}\n                  >\n                    <div className=\"w-10 h-10 rounded-lg overflow-hidden shrink-0 bg-[#0D0E12] relative border border-[#E6E4DD] dark:border-[#22242F]\">\n                      <img src={item.thumbnail} alt={item.filename} className=\"w-full h-full object-cover\" />\n                      <span className=\"absolute top-0.5 left-0.5 text-[8px] font-mono font-bold text-white px-1 bg-black/70 rounded\">\n                        0{idx + 1}\n                      </span>\n                    </div>\n\n                    <div className=\"min-w-0 flex-1\">\n                      <p className=\"text-xs font-bold truncate text-[#121212] dark:text-white group-hover:text-[#FF3B00]\">\n                        {item.filename}\n                      </p>\n                      <p className=\"text-[9px] font-mono text-gray-400 uppercase truncate\">\n                        {item.folder}\n                      </p>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        )}\n\n      </div>\n\n      <hr className=\"border-[#E6E4DD] dark:border-[#22242F]\" />\n\n      {/* 4. TEXT-HEAVY HIGH-RHYTHM EDITORIAL PRESETS & INDEX */}\n      <div className=\"grid lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left 7 Columns: Editorial Studio Presets Directory */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          \n          <div className=\"flex items-center justify-between pb-2 border-b border-[#E6E4DD] dark:border-[#22242F]\">\n            <div>\n              <span className=\"text-[10px] font-mono text-[#FF3B00] uppercase font-bold tracking-widest block\">\n                STRATEGY // PRESETS\n              </span>\n              <h2 className=\"text-xl font-extrabold text-[#121212] dark:text-white uppercase font-sans\">\n                CAPTION GENERATION DIRECTORY\n              </h2>\n            </div>\n\n            <span className=\"text-xs font-mono text-gray-400\">4 STRATEGIES</span>\n          </div>\n\n          <div className=\"divide-y divide-[#E6E4DD] dark:divide-[#22242F]\">\n            {aiPresets.map((preset, idx) => (\n              <div \n                key={idx}\n                onClick={onOpenMediaLibrary}\n                className=\"py-4 flex items-center justify-between gap-4 group cursor-pointer hover:bg-[#FAF8F5] dark:hover:bg-[#181A24] px-3 rounded-lg transition-colors\"\n              >\n                <div className=\"flex items-center gap-4 min-w-0\">\n                  <span className=\"text-sm font-mono font-bold text-[#FF3B00] shrink-0\">\n                    0{idx + 1} //\n                  </span>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-sm font-bold text-[#121212] dark:text-white group-hover:text-[#FF3B00] transition-colors truncate\">\n                      {preset.title}\n                    </h4>\n                    <p className=\"text-xs font-mono text-gray-500 dark:text-slate-400 mt-0.5\">\n                      Target Channel: <span className=\"font-bold text-[#121212] dark:text-slate-200\">{preset.channel}</span>\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-3 shrink-0\">\n                  <span className=\"text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] text-gray-600 dark:text-slate-300 uppercase\">\n                    {preset.tag}\n                  </span>\n                  <ArrowRight className=\"w-4 h-4 text-gray-400 group-hover:text-[#FF3B00] group-hover:translate-x-1 transition-all\" strokeWidth={2} />\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n\n        {/* Right 5 Columns: Studio Specs & Workflow Guidelines */}\n        <div className=\"lg:col-span-5 p-6 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card space-y-5\">\n          <div className=\"border-b border-[#E6E4DD] dark:border-[#22242F] pb-3 flex items-center justify-between\">\n            <h3 className=\"text-xs font-mono font-bold uppercase tracking-widest text-[#121212] dark:text-white flex items-center gap-2\">\n              <Layers className=\"w-4 h-4 text-[#FF3B00]\" />\n              <span>STUDIO WORKFLOW RULES</span>\n            </h3>\n            <span className=\"text-[10px] font-mono text-[#FF3B00] uppercase font-bold\">GUIDE</span>\n          </div>\n\n          <div className=\"space-y-4 text-xs font-sans text-gray-700 dark:text-slate-300 leading-relaxed\">\n            <div className=\"flex items-start gap-3\">\n              <span className=\"font-mono font-bold text-[#FF3B00] shrink-0\">A.</span>\n              <p>\n                <strong>Google Drive Integration:</strong> Auto-indexes high-res photos and video clips directly from your cloud folders without downloading locally.\n              </p>\n            </div>\n\n            <div className=\"flex items-start gap-3\">\n              <span className=\"font-mono font-bold text-[#FF3B00] shrink-0\">B.</span>\n              <p>\n                <strong>Multi-Tone Generation:</strong> Leverages Gemini Vision API to evaluate visual composition, tone, and colors before generating tailored hooks.\n              </p>\n            </div>\n\n            <div className=\"flex items-start gap-3\">\n              <span className=\"font-mono font-bold text-[#FF3B00] shrink-0\">C.</span>\n              <p>\n                <strong>Mandatory Explicit Approval:</strong> Every generated caption requires explicit human verification before social publishing.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"pt-2\">\n            <button\n              onClick={onConnectDrive}\n              className=\"w-full h-9 rounded text-xs font-bold font-mono bg-[#FAF8F5] dark:bg-[#0D0E12] hover:bg-gray-200 dark:hover:bg-[#1E202B] text-[#121212] dark:text-slate-200 border border-[#E6E4DD] dark:border-[#22242F] flex items-center justify-center gap-2 cursor-pointer transition-colors\"\n            >\n              <HardDrive className=\"w-3.5 h-3.5 text-[#FF3B00]\" />\n              <span>RE-SYNC DRIVE CONNECTION</span>\n            </button>\n          </div>\n        </div>\n\n      </div>\n\n      {/* 5. RECENT CAPTIONS EDITORIAL PROOF FEED */}\n      {recentCaptions.length > 0 && (\n        <>\n          <hr className=\"border-[#E6E4DD] dark:border-[#22242F]\" />\n\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center justify-between pb-2\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"p-1 rounded bg-[#FF3B00]/10 text-[#FF3B00]\">\n                  <History className=\"w-4 h-4\" strokeWidth={2} />\n                </span>\n                <h2 className=\"text-xl sm:text-2xl font-extrabold text-[#121212] dark:text-white uppercase tracking-tight font-sans\">\n                  STUDIO ARCHIVE // RECENT CAPTIONS\n                </h2>\n              </div>\n\n              <span className=\"text-xs font-mono text-[#FF3B00] font-bold\">\n                {recentCaptions.length} PROOFS SAVED\n              </span>\n            </div>\n\n            <div className=\"space-y-4\">\n              {recentCaptions.map((item, idx) => (\n                <div \n                  key={item.id}\n                  className=\"p-6 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card space-y-4\"\n                >\n                  <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-[#E6E4DD] dark:border-[#22242F] pb-3 text-xs\">\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"font-mono font-bold text-[#FF3B00]\">\n                        0{idx + 1} //\n                      </span>\n                      <span className=\"px-2.5 py-0.5 rounded bg-[#FF3B00] text-white font-mono text-[10px] font-bold uppercase\">\n                        {item.platform}\n                      </span>\n                      <span className=\"font-mono text-gray-500 uppercase\">{item.tone} TONE</span>\n                      <span className=\"text-gray-300 dark:text-slate-700\">\342\200\242</span>\n                      <span className=\"font-mono font-bold text-[#121212] dark:text-white truncate max-w-[200px]\">\n                        {item.media_filename}\n                      </span>\n                    </div>\n\n                    <button\n                      onClick={() => handleCopyText(`${item.caption_variation.hook}\\n\\n${item.caption_variation.body}`, item.id)}\n                      className=\"px-3.5 py-1.5 rounded text-xs font-mono font-bold bg-[#FAF8F5] dark:bg-[#0D0E12] hover:bg-[#E6E4DD] dark:hover:bg-[#1E202B] text-[#121212] dark:text-slate-200 border border-[#E6E4DD] dark:border-[#22242F] flex items-center gap-1.5 cursor-pointer transition-colors\"\n                    >\n                      {copiedId === item.id ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5 text-[#FF3B00]\" />}\n                      <span>{copiedId === item.id ? \'COPIED TO CLIPBOARD\' : \'COPY CAPTION\'}</span>\n                    </button>\n                  </div>\n\n                  {/* Editorial Proof Body */}\n                  <div className=\"p-4 rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] space-y-2\">\n                    <p className=\"text-sm font-extrabold text-[#121212] dark:text-white font-sans leading-snug\">\n                      \360\237\252\235 {item.caption_variation.hook}\n                    </p>\n                    <p className=\"text-xs text-gray-800 dark:text-slate-200 font-sans leading-relaxed whitespace-pre-wrap\">\n                      {item.caption_variation.body}\n                    </p>\n                    {item.caption_variation.cta && (\n                      <p className=\"text-xs font-bold text-[#FF3B00] pt-1\">\n                        \360\237\221\211 {item.caption_variation.cta}\n                      </p>\n                    )}\n                  </div>\n\n                  <div className=\"flex items-center justify-between text-[10px] font-mono text-gray-400\">\n                    <span>GENERATED WITH GEMINI VISION MODEL</span>\n                    <span>{new Date(item.created_at).toLocaleString()}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 289
      unified_diff {
        lines {
