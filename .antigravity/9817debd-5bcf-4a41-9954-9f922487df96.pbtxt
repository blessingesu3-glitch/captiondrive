    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Heart, Sparkles, FolderOpen } from \'lucide-react\';\nimport { MediaItem } from \'../types\';\nimport { MediaCard } from \'./MediaCard\';\n\ninterface FavoritesViewProps {\n  items: MediaItem[];\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onOpenLibrary: () => void;\n}\n\nexport const FavoritesView: React.FC<FavoritesViewProps> = ({\n  items,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n  onOpenLibrary\n}) => {\n  const favoriteItems = items.filter((i) => i.is_favorite);\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n            <Heart className=\"w-5 h-5 text-rose-500 fill-current\" />\n            <span>Favorite Media ({favoriteItems.length})</span>\n          </h2>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n            Quickly access your starred Google Drive assets for rapid post creation\n          </p>\n        </div>\n      </div>\n\n      {favoriteItems.length > 0 ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">\n          {favoriteItems.map((item) => (\n            <MediaCard\n              key={item.id}\n              item={item}\n              viewMode=\"grid\"\n              onSelectMedia={onSelectMedia}\n              onGenerateCaption={onGenerateCaption}\n              onToggleFavorite={onToggleFavorite}\n            />\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-3xl bg-white dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 p-8 space-y-3\">\n          <div className=\"w-14 h-14 rounded-full bg-rose-50 dark:bg-rose-950 text-rose-500 flex items-center justify-center mx-auto\">\n            <Heart className=\"w-7 h-7\" />\n          </div>\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            No favorite assets starred yet\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Click the heart icon on any media card in your library to bookmark it here for fast access.\n          </p>\n          <button\n            onClick={onOpenLibrary}\n            className=\"mt-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md\"\n          >\n            Go to Media Library\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Heart } from \'lucide-react\';\nimport { MediaItem } from \'../types\';\nimport { MediaCard } from \'./MediaCard\';\n\ninterface FavoritesViewProps {\n  items: MediaItem[];\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onOpenLibrary: () => void;\n}\n\nexport const FavoritesView: React.FC<FavoritesViewProps> = ({\n  items,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n  onOpenLibrary\n}) => {\n  const favoriteItems = items.filter((i) => i.is_favorite);\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-2\">\n            <Heart className=\"w-5 h-5 text-rose-500 fill-current\" strokeWidth={1.75} />\n            <span>Favorite Assets ({favoriteItems.length})</span>\n          </h1>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 mt-1\">\n            Access your starred media items for rapid caption generation\n          </p>\n        </div>\n      </div>\n\n      {favoriteItems.length > 0 ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4\">\n          {favoriteItems.map((item) => (\n            <MediaCard\n              key={item.id}\n              item={item}\n              viewMode=\"grid\"\n              onSelectMedia={onSelectMedia}\n              onGenerateCaption={onGenerateCaption}\n              onToggleFavorite={onToggleFavorite}\n            />\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-dashed border-gray-300 dark:border-slate-800 p-8 space-y-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/60 text-rose-500 flex items-center justify-center mx-auto border border-rose-100 dark:border-rose-900/40\">\n            <Heart className=\"w-6 h-6\" strokeWidth={1.75} />\n          </div>\n          <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">\n            No Favorite Assets Starred\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto leading-relaxed\">\n            Click the heart icon on any media item in your library to bookmark it here.\n          </p>\n          <button\n            onClick={onOpenLibrary}\n            className=\"mt-2 px-4 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs cursor-pointer transition-transform active:scale-95\"\n          >\n            Explore Media Library\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
