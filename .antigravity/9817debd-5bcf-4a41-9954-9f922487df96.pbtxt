    instruction: "Update SocialPublishModal footer and controls with Kickpush studio theme, vermillion buttons, and mono badges."
    replacement_infos {
      original_chunk {
        target_content: "          {/* Schedule Toggle */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-semibold text-gray-700 dark:text-slate-300 flex items-center gap-1.5 cursor-pointer\">\n                <Clock className=\"w-4 h-4 text-blue-600\" strokeWidth={1.75} />\n                <span>Schedule Post</span>\n              </label>\n              <input\n                type=\"checkbox\"\n                checked={isScheduling}\n                onChange={(e) => setIsScheduling(e.target.checked)}\n                className=\"w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500 cursor-pointer\"\n              />\n            </div>\n\n            {isScheduling && (\n              <input\n                type=\"datetime-local\"\n                value={scheduledTime}\n                onChange={(e) => setScheduledTime(e.target.value)}\n                className=\"w-full h-10 px-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n              />\n            )}\n          </div>\n\n          {/* Mandatory User Approval Checkbox */}\n          <div className=\"p-4 rounded-xl bg-blue-50/70 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900/60 flex items-start gap-3\">\n            <input\n              type=\"checkbox\"\n              id=\"user-approval-check\"\n              checked={userApproved}\n              onChange={(e) => setUserApproved(e.target.checked)}\n              className=\"w-4 h-4 mt-0.5 text-blue-600 rounded border-gray-300 focus:ring-blue-500 cursor-pointer\"\n            />\n            <label htmlFor=\"user-approval-check\" className=\"text-xs text-blue-950 dark:text-blue-200 font-medium leading-relaxed cursor-pointer\">\n              <strong className=\"font-bold text-blue-900 dark:text-blue-100 block mb-0.5 flex items-center gap-1\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600\" strokeWidth={1.75} />\n                Explicit Approval\n              </strong>\n              I approve publishing this media content and caption directly to <span className=\"font-bold\">{selectedPlatform}</span> ({currentAccount?.handle || \'@connected_page\'}).\n            </label>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-gray-200 dark:border-slate-800 bg-gray-50/80 dark:bg-[#111622]/80 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 h-9 rounded-xl text-xs font-semibold text-gray-600 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            Cancel\n          </button>\n\n          <button\n            onClick={handleExecutePublish}\n            disabled={!userApproved || isSubmitting || (isScheduling && !scheduledTime)}\n            className=\"px-5 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition-all active:scale-95 disabled:opacity-50 disabled:pointer-events-none flex items-center gap-2 cursor-pointer\"\n          >\n            {isSubmitting ? (\n              <>\n                <Sparkles className=\"w-4 h-4 animate-spin\" />\n                <span>Publishing...</span>\n              </>\n            ) : isScheduling ? (\n              <>\n                <Clock className=\"w-4 h-4\" strokeWidth={1.75} />\n                <span>Approve & Schedule</span>\n              </>\n            ) : (\n              <>\n                <Send className=\"w-4 h-4\" strokeWidth={1.75} />\n                <span>Approve & Post Now</span>\n              </>\n            )}\n          </button>\n        </div>"
        replacement_content: "          {/* Schedule Toggle */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-mono font-bold text-[#121212] dark:text-slate-300 flex items-center gap-1.5 cursor-pointer uppercase\">\n                <Clock className=\"w-4 h-4 text-[#FF3B00]\" strokeWidth={2} />\n                <span>SCHEDULE POST</span>\n              </label>\n              <input\n                type=\"checkbox\"\n                checked={isScheduling}\n                onChange={(e) => setIsScheduling(e.target.checked)}\n                className=\"w-4 h-4 text-[#FF3B00] rounded border-gray-300 focus:ring-[#FF3B00] cursor-pointer\"\n              />\n            </div>\n\n            {isScheduling && (\n              <input\n                type=\"datetime-local\"\n                value={scheduledTime}\n                onChange={(e) => setScheduledTime(e.target.value)}\n                className=\"w-full h-9 px-3 text-xs rounded-lg border border-[#E6E4DD] dark:border-[#22242F] bg-white dark:bg-[#151720] text-[#121212] dark:text-slate-200 focus:outline-none focus:border-[#FF3B00] font-mono\"\n              />\n            )}\n          </div>\n\n          {/* Mandatory User Approval Checkbox */}\n          <div className=\"p-4 rounded-xl bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] flex items-start gap-3\">\n            <input\n              type=\"checkbox\"\n              id=\"user-approval-check\"\n              checked={userApproved}\n              onChange={(e) => setUserApproved(e.target.checked)}\n              className=\"w-4 h-4 mt-0.5 text-[#FF3B00] rounded border-gray-300 focus:ring-[#FF3B00] cursor-pointer\"\n            />\n            <label htmlFor=\"user-approval-check\" className=\"text-xs text-[#121212] dark:text-slate-200 font-medium leading-relaxed cursor-pointer\">\n              <strong className=\"font-bold font-mono text-[#FF3B00] block mb-0.5 flex items-center gap-1 uppercase\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-[#FF3B00]\" strokeWidth={2} />\n                Explicit Approval\n              </strong>\n              I approve publishing this media content and caption directly to <span className=\"font-bold\">{selectedPlatform}</span> ({currentAccount?.handle || \'@connected_page\'}).\n            </label>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-[#E6E4DD] dark:border-[#22242F] bg-[#FAF8F5]/80 dark:bg-[#0D0E12]/80 flex items-center justify-between\">\n          <button\n            onClick={onClose}\n            className=\"px-4 h-9 rounded-lg text-xs font-mono font-bold text-gray-600 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-[#151720] transition-colors cursor-pointer\"\n          >\n            CANCEL\n          </button>\n\n          <button\n            onClick={handleExecutePublish}\n            disabled={!userApproved || isSubmitting || (isScheduling && !scheduledTime)}\n            className=\"px-5 h-9 rounded-lg text-xs font-bold font-mono bg-[#FF3B00] hover:bg-[#E03400] text-white shadow-2xs transition-all active:scale-95 disabled:opacity-50 disabled:pointer-events-none flex items-center gap-2 cursor-pointer\"\n          >\n            {isSubmitting ? (\n              <>\n                <Sparkles className=\"w-4 h-4 animate-spin\" />\n                <span>PUBLISHING...</span>\n              </>\n            ) : isScheduling ? (\n              <>\n                <Clock className=\"w-4 h-4\" strokeWidth={2} />\n                <span>APPROVE & SCHEDULE</span>\n              </>\n            ) : (\n              <>\n                <Send className=\"w-4 h-4\" strokeWidth={2} />\n                <span>APPROVE & POST NOW</span>\n              </>\n            )}\n          </button>\n        </div>"
      }
      num_matches: 1
    }
  }
