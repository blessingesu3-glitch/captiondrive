    instruction: "Update Sidebar.tsx with 280px fixed width, Linear/Arc minimalist navigation, and full active tab set."
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { \n  LayoutDashboard, \n  FolderOpen, \n  Heart, \n  History, \n  Send,\n  Settings, \n  HardDrive,\n  Sparkles,\n  ChevronRight\n} from \'lucide-react\';\nimport { ActiveTab, User } from \'../types\';\n\ninterface SidebarProps {\n  activeTab: ActiveTab;\n  onSelectTab: (tab: ActiveTab) => void;\n  user: User;\n  onConnectDrive: () => void;\n  favoritesCount: number;\n  captionsCount: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  onSelectTab,\n  user,\n  onConnectDrive,\n  favoritesCount,\n  captionsCount\n}) => {\n  const navItems = [\n    {\n      id: \'dashboard\' as ActiveTab,\n      label: \'Dashboard\',\n      icon: LayoutDashboard,\n      badge: null,\n    },\n    {\n      id: \'media\' as ActiveTab,\n      label: \'My Media\',\n      icon: FolderOpen,\n      badge: user.isDriveConnected ? \'Synced\' : null,\n    },\n    {\n      id: \'social\' as ActiveTab,\n      label: \'Social Publishing\',\n      icon: Send,\n      badge: \'Pages & Post\',\n    },\n    {\n      id: \'favorites\' as ActiveTab,\n      label: \'Favorites\',\n      icon: Heart,\n      badge: favoritesCount > 0 ? favoritesCount.toString() : null,\n    },\n    {\n      id: \'captions\' as ActiveTab,\n      label: \'Recent Captions\',\n      icon: History,\n      badge: captionsCount > 0 ? captionsCount.toString() : null,\n    },\n    {\n      id: \'settings\' as ActiveTab,\n      label: \'Settings\',\n      icon: Settings,\n      badge: null,\n    },\n  ];\n\n  return (\n    <aside className=\"w-64 shrink-0 hidden md:flex flex-col border-r border-gray-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 min-h-[calc(100vh-4rem)] p-4 transition-colors\">\n      \n      {/* Navigation list */}\n      <nav className=\"space-y-1 flex-1\">\n        <div className=\"px-3 py-2 text-[10px] font-bold tracking-widest text-gray-400 dark:text-slate-500 uppercase\">\n          Navigation\n        </div>\n        \n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => onSelectTab(item.id)}\n              className={`w-full flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                isActive\n                  ? \'text-gray-900 bg-gray-100 dark:bg-slate-800 dark:text-white font-bold\'\n                  : \'text-gray-600 hover:bg-gray-50 dark:text-slate-400 dark:hover:bg-slate-800/60 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <Icon className={`w-4 h-4 ${isActive ? \'text-gray-900 dark:text-white\' : \'text-gray-400 dark:text-slate-500\'}`} />\n                <span>{item.label}</span>\n              </div>\n              \n              {item.badge && (\n                <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${\n                  isActive \n                    ? \'bg-gray-200 text-gray-900 dark:bg-slate-700 dark:text-slate-100\' \n                    : \'bg-gray-100 text-gray-500 dark:bg-slate-800 dark:text-slate-400\'\n                }`}>\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Footer Profile & Drive Status */}\n      <div className=\"pt-4 border-t border-gray-200/80 dark:border-slate-800 space-y-3\">\n        <div className=\"flex items-center gap-3 p-2 rounded-lg\">\n          <div className=\"w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 flex items-center justify-center text-xs font-bold text-gray-800 dark:text-slate-200\">\n            {user.name ? user.name.split(\' \').map(n => n[0]).join(\'\') : \'JD\'}\n          </div>\n          <div className=\"flex-1 min-w-0\">\n            <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">{user.name || \'Jane Designer\'}</p>\n            <p className=\"text-[10px] text-gray-400 dark:text-slate-400\">Pro Plan</p>\n          </div>\n        </div>\n\n        <div className=\"bg-gray-50 dark:bg-slate-800/60 rounded-xl p-3 border border-gray-200/80 dark:border-slate-700\">\n          <div className=\"flex items-center justify-between mb-1.5\">\n            <p className=\"text-[10px] text-gray-500 dark:text-slate-400 font-bold uppercase tracking-wider\">Drive Sync</p>\n            <button onClick={onConnectDrive} className=\"text-[10px] text-indigo-600 dark:text-indigo-400 font-bold hover:underline cursor-pointer\">\n              {user.isDriveConnected ? \'Sync\' : \'Connect\'}\n            </button>\n          </div>\n          <div className=\"w-full bg-gray-200 dark:bg-slate-700 rounded-full h-1.5 mb-2 overflow-hidden\">\n            <div \n              className=\"bg-gray-900 dark:bg-slate-200 h-1.5 rounded-full transition-all duration-500\" \n              style={{ width: user.isDriveConnected ? \'65%\' : \'0%\' }} \n            />\n          </div>\n          <p className=\"text-[10px] text-gray-600 dark:text-slate-300 font-medium\">\n            {user.isDriveConnected ? \'842 MB of 2 GB used\' : \'Google Drive offline\'}\n          </p>\n        </div>\n      </div>\n\n    </aside>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { \n  LayoutDashboard, \n  FolderOpen, \n  Sparkles,\n  Bot,\n  Calendar,\n  BarChart2,\n  FileText,\n  Settings, \n  HardDrive,\n  Heart,\n  CheckCircle2,\n  Zap\n} from \'lucide-react\';\nimport { ActiveTab, User } from \'../types\';\n\ninterface SidebarProps {\n  activeTab: ActiveTab;\n  onSelectTab: (tab: ActiveTab) => void;\n  user: User;\n  onConnectDrive: () => void;\n  favoritesCount: number;\n  captionsCount: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  onSelectTab,\n  user,\n  onConnectDrive,\n  favoritesCount,\n  captionsCount\n}) => {\n  const mainNavItems = [\n    {\n      id: \'dashboard\' as ActiveTab,\n      label: \'Dashboard\',\n      icon: LayoutDashboard,\n      badge: null,\n    },\n    {\n      id: \'media\' as ActiveTab,\n      label: \'Content Library\',\n      icon: FolderOpen,\n      badge: user.isDriveConnected ? \'Synced\' : null,\n    },\n    {\n      id: \'generator\' as ActiveTab,\n      label: \'Caption Generator\',\n      icon: Sparkles,\n      badge: \'AI\',\n    },\n    {\n      id: \'ai\' as ActiveTab,\n      label: \'AI Assistant\',\n      icon: Bot,\n      badge: null,\n    },\n    {\n      id: \'calendar\' as ActiveTab,\n      label: \'Calendar & Schedule\',\n      icon: Calendar,\n      badge: null,\n    },\n    {\n      id: \'analytics\' as ActiveTab,\n      label: \'Analytics\',\n      icon: BarChart2,\n      badge: null,\n    },\n    {\n      id: \'captions\' as ActiveTab,\n      label: \'Saved Captions\',\n      icon: FileText,\n      badge: captionsCount > 0 ? captionsCount.toString() : null,\n    },\n    {\n      id: \'favorites\' as ActiveTab,\n      label: \'Favorites\',\n      icon: Heart,\n      badge: favoritesCount > 0 ? favoritesCount.toString() : null,\n    },\n    {\n      id: \'settings\' as ActiveTab,\n      label: \'Settings\',\n      icon: Settings,\n      badge: null,\n    },\n  ];\n\n  return (\n    <aside className=\"w-[280px] shrink-0 hidden md:flex flex-col border-r border-gray-200 dark:border-slate-800 bg-white dark:bg-[#111622] min-h-[calc(100vh-4rem)] p-4 transition-colors\">\n      \n      {/* Navigation section */}\n      <nav className=\"space-y-1 flex-1\">\n        <div className=\"px-3 py-2 text-[11px] font-semibold tracking-wider text-gray-400 dark:text-slate-500 uppercase\">\n          Workspace\n        </div>\n        \n        {mainNavItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => onSelectTab(item.id)}\n              className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium transition-all duration-150 cursor-pointer ${\n                isActive\n                  ? \'text-gray-900 bg-gray-100/90 dark:bg-slate-800 dark:text-white font-semibold shadow-xs\'\n                  : \'text-gray-600 hover:bg-gray-50 dark:text-slate-400 dark:hover:bg-slate-800/60 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <Icon \n                  className={`w-4 h-4 transition-colors ${\n                    isActive \n                      ? \'text-blue-600 dark:text-blue-400\' \n                      : \'text-gray-400 dark:text-slate-500\'\n                  }`} \n                  strokeWidth={1.75}\n                />\n                <span>{item.label}</span>\n              </div>\n              \n              {item.badge && (\n                <span className={`text-[11px] font-medium px-2 py-0.5 rounded-full ${\n                  isActive \n                    ? \'bg-blue-50 text-blue-700 dark:bg-blue-950 dark:text-blue-300\' \n                    : \'bg-gray-100 text-gray-500 dark:bg-slate-800 dark:text-slate-400\'\n                }`}>\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Footer Profile & Drive Status */}\n      <div className=\"pt-4 border-t border-gray-200/80 dark:border-slate-800 space-y-3\">\n        {/* Drive Sync Card */}\n        <div className=\"bg-gray-50 dark:bg-slate-800/50 rounded-xl p-3 border border-gray-200/70 dark:border-slate-700/60\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <div className=\"flex items-center gap-1.5\">\n              <HardDrive className=\"w-3.5 h-3.5 text-blue-600 dark:text-blue-400\" />\n              <span className=\"text-xs font-semibold text-gray-800 dark:text-slate-200\">Google Drive</span>\n            </div>\n            <button \n              onClick={onConnectDrive} \n              className=\"text-[11px] text-blue-600 dark:text-blue-400 font-semibold hover:underline cursor-pointer\"\n            >\n              {user.isDriveConnected ? \'Manage\' : \'Connect\'}\n            </button>\n          </div>\n          \n          <div className=\"w-full bg-gray-200 dark:bg-slate-700 rounded-full h-1.5 mb-2 overflow-hidden\">\n            <div \n              className=\"bg-blue-600 dark:bg-blue-500 h-1.5 rounded-full transition-all duration-300\" \n              style={{ width: user.isDriveConnected ? \'68%\' : \'0%\' }} \n            />\n          </div>\n          <p className=\"text-[11px] text-gray-500 dark:text-slate-400\">\n            {user.isDriveConnected ? \'1.4 GB / 2 GB Synced\' : \'Sync drive folder for instant captions\'}\n          </p>\n        </div>\n\n        {/* User Card */}\n        <div className=\"flex items-center gap-3 p-2 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/60 dark:border-slate-800\">\n          {user.avatar ? (\n            <img src={user.avatar} alt={user.name} className=\"w-8 h-8 rounded-full object-cover border border-gray-200 dark:border-slate-700\" />\n          ) : (\n            <div className=\"w-8 h-8 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 flex items-center justify-center font-bold text-xs\">\n              {user.name ? user.name.split(\' \').map(n => n[0]).join(\'\') : \'BE\'}\n            </div>\n          )}\n          <div className=\"flex-1 min-w-0\">\n            <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">{user.name || \'Blessing Esu\'}</p>\n            <p className=\"text-[11px] text-gray-500 dark:text-slate-400 truncate\">{user.email || \'blessingesu3@gmail.com\'}</p>\n          </div>\n        </div>\n      </div>\n\n    </aside>\n  );\n};\n"
