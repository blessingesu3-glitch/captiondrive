        }
        lines {
          text: "                        acc ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300\' : \'bg-gray-100 text-gray-500 dark:bg-slate-800 dark:text-slate-400\'"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
