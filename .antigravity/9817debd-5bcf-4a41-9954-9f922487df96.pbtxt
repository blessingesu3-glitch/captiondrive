ton\n              key={p}\n              onClick={() => setSelectedPlatform(p)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-colors cursor-pointer ${\n                selectedPlatform === p\n                  ? \'bg-white dark:bg-[#111622] text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              {p === \'all\' ? \'All Channels\' : p}\n            </button>\n          ))}\n        </div>\n\n      </div>\n\n      {/* History Grid */}\n      {filteredHistory.length > 0 ? (\n        <div className=\"space-y-4\">\n          {filteredHistory.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-3\"\n            >\n              <div className=\"flex items-center justify-between gap-3 flex-wrap border-b border-gray-100 dark:border-slate-800 pb-3\">\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"w-10 h-10 rounded-xl overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700\">\n                    <img src={item.media_thumbnail} alt={item.media_filename} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                      {item.media_filename}\n                    </h4>\n                    <div className=\"flex items-center gap-2 mt-0.5 text-[11px] text-gray-500 dark:text-slate-400\">\n                      <span className=\"font-semibold text-blue-600 dark:text-blue-400\">{item.platform}</span>\n                      <span>\342\200\242</span>\n                      <span>{item.tone} Tone</span>\n                      <span>\342\200\242</span>\n                      <span>{item.length}</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopy(item)}\n                    className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    {copiedId === item.id ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                        <span>Copied!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                        <span>Copy</span>\n                      </>\n                    )}\n                  </button>\n\n                  {onOpenPublishModal && (\n                    <button\n                      onClick={() => {\n                        const fullText = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta || \'\'}\\n\\n${item.caption_variation.hashtags?.join(\' \') || \'\'}`;\n                        onOpenPublishModal({\n                          mediaFilename: item.media_filename,\n                          mediaThumbnail: item.media_thumbnail,\n                          captionText: fullText,\n                          platform: item.platform\n                        });\n                      }}\n                      className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center gap-1.5 transition-transform active:scale-95 cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                      <span>Post to Social</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteHistoryItem(item.id)}\n                    className=\"p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" strokeWidth={1.75} />\n                  </button>\n                </div>\n              </div>\n\n              {/* Caption Content */}\n              <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n                <p className=\"text-xs font-bold text-gray-900 dark:text-white\">\n                  \360\237\252\235 {item.caption_variation.hook}\n                </p>\n                <p className=\"text-xs text-gray-700 dark:text-slate-300 font-sans whitespace-pre-wrap leading-relaxed\">\n                  {item.caption_variation.body}\n                </p>\n                {item.caption_variation.cta && (\n                  <p className=\"text-xs font-medium text-blue-600 dark:text-blue-400 pt-1\">\n                    \360\237\221\211 {item.caption_variation.cta}\n                  </p>\n                )}\n                {item.caption_variation.hashtags?.length > 0 && (\n                  <div className=\"flex flex-wrap gap-1 pt-1\">\n                    {item.caption_variation.hashtags.map((h, idx) => (\n                      <span key={idx} className=\"text-[10px] font-medium text-gray-500 dark:text-slate-400\">\n                        {h}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              <div className=\"text-[10px] text-gray-400 dark:text-slate-500 text-right\">\n                Created: {new Date(item.created_at).toLocaleString()}\n              </div>\n\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-dashed border-gray-300 dark:border-slate-800 p-8 space-y-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gray-50 dark:bg-slate-800 text-gray-400 flex items-center justify-center mx-auto\">\n            <History className=\"w-6 h-6\" strokeWidth={1.75} />\n          </div>\n          <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">\n            No Generated Captions\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Select an image or video from your library and click Generate Caption to save history here.\n          </p>\n        </div>\n      )}\n\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header */}\n      <div className=\"p-6 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-2xl font-extrabold tracking-tight text-[#121212] dark:text-white flex items-center gap-2 font-sans\">\n            <History className=\"w-5 h-5 text-[#FF3B00]\" strokeWidth={2} />\n            <span>CAPTION HISTORY ({history.length})</span>\n          </h1>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 mt-1\">\n            Review, copy, or publish previously generated captions from your studio archive\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Toolbar */}\n      <div className=\"p-4 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card flex flex-col sm:flex-row items-center justify-between gap-3\">\n        \n        {/* Search */}\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400\" strokeWidth={1.75} />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search generated text or file...\"\n            className=\"w-full h-9 pl-9 pr-4 text-xs rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] text-[#121212] dark:text-white placeholder-gray-400 focus:outline-none focus:border-[#FF3B00]\"\n          />\n        </div>\n\n        {/* Platform Filter Tabs */}\n        <div className=\"flex items-center gap-1 p-1 rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] w-full sm:w-auto overflow-x-auto\">\n          {platforms.map((p) => (\n            <button\n              key={p}\n              onClick={() => setSelectedPlatform(p)}\n              className={`px-3 py-1.5 rounded text-xs font-bold font-mono uppercase whitespace-nowrap transition-colors cursor-pointer ${\n                selectedPlatform === p\n                  ? \'bg-white dark:bg-[#151720] text-[#FF3B00] border border-[#E6E4DD] dark:border-[#22242F] shadow-2xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-[#121212] dark:hover:text-white\'\n              }`}\n            >\n              {p === \'all\' ? \'All Channels\' : p}\n            </button>\n          ))}\n        </div>\n\n      </div>\n\n      {/* History Grid */}\n      {filteredHistory.length > 0 ? (\n        <div className=\"space-y-4\">\n          {filteredHistory.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-5 rounded-xl bg-white dark:bg-[#151720] border border-[#E6E4DD] dark:border-[#22242F] shadow-card space-y-3\"\n            >\n              <div className=\"flex items-center justify-between gap-3 flex-wrap border-b border-[#E6E4DD] dark:border-[#22242F] pb-3\">\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"w-10 h-10 rounded-lg overflow-hidden shrink-0 bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F]\">\n                    <img src={item.media_thumbnail} alt={item.media_filename} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-xs font-bold text-[#121212] dark:text-white truncate\">\n                      {item.media_filename}\n                    </h4>\n                    <div className=\"flex items-center gap-2 mt-0.5 text-[10px] font-mono text-gray-500 dark:text-slate-400 uppercase\">\n                      <span className=\"font-bold text-[#FF3B00]\">{item.platform}</span>\n                      <span>\342\200\242</span>\n                      <span>{item.tone} TONE</span>\n                      <span>\342\200\242</span>\n                      <span>{item.length}</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopy(item)}\n                    className=\"px-3 h-8 rounded text-xs font-mono font-bold bg-white hover:bg-gray-100 dark:bg-[#151720] dark:hover:bg-[#1E202B] text-[#121212] dark:text-slate-200 border border-[#E6E4DD] dark:border-[#22242F] flex items-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    {copiedId === item.id ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                        <span>COPIED</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                        <span>COPY</span>\n                      </>\n                    )}\n                  </button>\n\n                  {onOpenPublishModal && (\n                    <button\n                      onClick={() => {\n                        const fullText = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta || \'\'}\\n\\n${item.caption_variation.hashtags?.join(\' \') || \'\'}`;\n                        onOpenPublishModal({\n                          mediaFilename: item.media_filename,\n                          mediaThumbnail: item.media_thumbnail,\n                          captionText: fullText,\n                          platform: item.platform\n                        });\n                      }}\n                      className=\"px-3 h-8 rounded text-xs font-mono font-bold bg-[#FF3B00] hover:bg-[#E03400] text-white shadow-2xs flex items-center gap-1.5 transition-transform active:scale-95 cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" strokeWidth={2} />\n                      <span>POST / SCHEDULE</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteHistoryItem(item.id)}\n                    className=\"p-1.5 rounded text-gray-400 hover:text-[#FF3B00] hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer border border-transparent hover:border-[#FF3B00]/20\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" strokeWidth={1.75} />\n                  </button>\n                </div>\n              </div>\n\n              {/* Caption Content */}\n              <div className=\"p-4 rounded-lg bg-[#FAF8F5] dark:bg-[#0D0E12] border border-[#E6E4DD] dark:border-[#22242F] space-y-2\">\n                <p className=\"text-xs font-bold text-[#121212] dark:text-white\">\n                  \360\237\252\235 {item.caption_variation.hook}\n                </p>\n                <p className=\"text-xs text-gray-800 dark:text-slate-300 font-sans whitespace-pre-wrap leading-relaxed\">\n                  {item.caption_variation.body}\n                </p>\n                {item.caption_variation.cta && (\n                  <p className=\"text-xs font-bold text-[#FF3B00] pt-1\">\n                    \360\237\221\211 {item.caption_variation.cta}\n                  </p>\n                )}\n                {item.caption_variation.hashtags?.length > 0 && (\n                  <div className=\"flex flex-wrap gap-1 pt-1\">\n                    {item.caption_variation.hashtags.map((h, idx) => (\n                      <span key={idx} className=\"text-[10px] font-mono font-bold text-[#FF3B00]\">\n                        {h}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              <div className=\"text-[10px] font-mono text-gray-400 dark:text-slate-500 text-right\">\n                CREATED: {new Date(item.created_at).toLocaleString()}\n              </div>\n\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-xl bg-white dark:bg-[#151720] border border-dashed border-[#E6E4DD] dark:border-[#22242F] p-8 space-y-3\">\n          <div className=\"w-12 h-12 rounded-xl bg-[#FAF8F5] dark:bg-[#0D0E12] text-gray-400 flex items-center justify-center mx-auto border border-[#E6E4DD] dark:border-[#22242F]\">\n            <History className=\"w-6 h-6\" strokeWidth={1.75} />\n          </div>\n          <h3 className=\"text-sm font-extrabold uppercase text-[#121212] dark:text-white font-sans\">\n            No Generated Captions\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Select an image or video from your library and click Generate Caption to save history here.\n          </p>\n        </div>\n      )}\n\n    </div>\n  );"
