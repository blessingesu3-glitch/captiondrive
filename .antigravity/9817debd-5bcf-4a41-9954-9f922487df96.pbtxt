  file_change {
    absolute_path_uri: "file:///src/components/SmartSearchModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Zap, Search, Sparkles, ArrowRight, Check } from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface SmartSearchModalProps {\n  mediaList: MediaItem[];\n  onClose: () => void;\n  onSelectMatchedMedia: (matched: MediaItem[]) => void;\n}\n\nexport const SmartSearchModal: React.FC<SmartSearchModalProps> = ({\n  mediaList,\n  onClose,\n  onSelectMatchedMedia,\n}) => {\n  const [query, setQuery] = useState(\'\');\n  const [isSearching, setIsSearching] = useState(false);\n  const [matchedResults, setMatchedResults] = useState<MediaItem[]>([]);\n  const [hasSearched, setHasSearched] = useState(false);\n\n  const samplePrompts = [\n    \'Show my beach photos\',\n    \'Find videos about AI\',\n    \'Find pictures with laptops\',\n    \'Show speaking event photos\',\n    \'Find media with coffee cups or workspace\',\n    \'Find tropical travel vibes\'\n  ];\n\n  const handleRunSearch = async (promptText?: string) => {\n    const activeQuery = promptText || query;\n    if (!activeQuery.trim()) return;\n\n    setIsSearching(true);\n    setHasSearched(true);\n    setMatchedResults([]);\n\n    try {\n      const response = await fetch(\'/api/ai/smart-search\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ query: activeQuery, mediaList })\n      });\n\n      const data = await response.json();\n      if (data.matched_ids && Array.isArray(data.matched_ids)) {\n        const matches = mediaList.filter((m) => data.matched_ids.includes(m.id));\n        setMatchedResults(matches);\n      }\n    } catch (err) {\n      console.error(\'Smart search failed:\', err);\n    } finally {\n      setIsSearching(false);\n    }\n  };\n\n  const handleApplyResults = () => {\n    onSelectMatchedMedia(matchedResults);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-xl bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden p-6 space-y-5\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 rounded-full text-slate-400 hover:text-slate-900 dark:hover:text-white\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center shadow-md shadow-amber-500/20\">\n            <Zap className=\"w-5 h-5 fill-current\" />\n          </div>\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n              <span>Smart AI Natural Language Search</span>\n              <span className=\"text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300\">\n                Premium\n              </span>\n            </h2>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n              Search by visual content, mood, objects, and themes\342\200\224not just filenames.\n            </p>\n          </div>\n        </div>\n\n        {/* Input box */}\n        <div className=\"relative\">\n          <input\n            type=\"text\"\n            value={query}\n            onChange={(e) => setQuery(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleRunSearch()}\n            placeholder=\'e.g. \"Show my beach photos\" or \"Videos about AI\"\'\n            className=\"w-full pl-4 pr-24 py-3 text-xs sm:text-sm rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/30\"\n          />\n          <button\n            onClick={() => handleRunSearch()}\n            disabled={isSearching || !query.trim()}\n            className=\"absolute right-1.5 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-all disabled:opacity-50\"\n          >\n            {isSearching ? \'Analyzing...\' : \'Search\'}\n          </button>\n        </div>\n\n        {/* Sample Prompt Suggestions */}\n        <div className=\"space-y-1.5\">\n          <span className=\"text-[11px] font-semibold text-slate-400 uppercase tracking-wider\">\n            Try these example queries:\n          </span>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {samplePrompts.map((p) => (\n              <button\n                key={p}\n                onClick={() => {\n                  setQuery(p);\n                  handleRunSearch(p);\n                }}\n                className=\"px-2.5 py-1 rounded-full text-xs bg-slate-100 dark:bg-slate-800 hover:bg-amber-50 dark:hover:bg-amber-950/60 hover:text-amber-700 dark:hover:text-amber-300 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700 transition-colors\"\n              >\n                \"{p}\"\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Results output */}\n        {hasSearched && (\n          <div className=\"pt-3 border-t border-slate-200 dark:border-slate-800 space-y-3\">\n            <div className=\"flex items-center justify-between text-xs font-semibold text-slate-700 dark:text-slate-300\">\n              <span>Results ({matchedResults.length} items found)</span>\n              {matchedResults.length > 0 && (\n                <button\n                  onClick={handleApplyResults}\n                  className=\"text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1 font-bold\"\n                >\n                  <span>Filter Library View</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n\n            {matchedResults.length > 0 ? (\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-h-[220px] overflow-y-auto p-1\">\n                {matchedResults.map((m) => (\n                  <div \n                    key={m.id}\n                    className=\"group relative rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 aspect-square\"\n                  >\n                    <img src={m.thumbnail} alt={m.filename} className=\"w-full h-full object-cover\" />\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-90 p-2 flex flex-col justify-end text-white text-[10px]\">\n                      <span className=\"font-semibold truncate\">{m.filename}</span>\n                      <span className=\"text-slate-300 text-[9px] truncate\">{m.ai_analysis?.main_subject || m.folder}</span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            ) : (\n              <div className=\"p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 text-center text-xs text-slate-500\">\n                No files matched your natural language query. Try a broader search term.\n              </div>\n            )}\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n};\n"
    }
