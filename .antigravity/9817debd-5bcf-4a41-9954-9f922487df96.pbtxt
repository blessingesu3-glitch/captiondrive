  file_change {
    absolute_path_uri: "file:///src/components/MediaCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { \n  FileImage, \n  Video, \n  Folder, \n  Calendar, \n  Heart, \n  Sparkles, \n  Play, \n  Zap,\n  Clock\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface MediaCardProps {\n  item: MediaItem;\n  viewMode: \'grid\' | \'list\';\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n}\n\nexport const MediaCard: React.FC<MediaCardProps> = ({\n  item,\n  viewMode,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n}) => {\n  const isVideo = item.file_type === \'video\';\n\n  if (viewMode === \'list\') {\n    return (\n      <div \n        onClick={() => onSelectMedia(item)}\n        className=\"group relative flex items-center justify-between gap-4 p-3 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 hover:border-gray-400 dark:hover:border-slate-600 shadow-2xs transition-all cursor-pointer\"\n      >\n        <div className=\"flex items-center gap-3.5 min-w-0\">\n          {/* Thumbnail */}\n          <div className=\"relative w-16 h-16 rounded-lg overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-900 border border-gray-200/60 dark:border-slate-700\">\n            <img \n              src={item.thumbnail} \n              alt={item.filename}\n              className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n              loading=\"lazy\"\n            />\n            <div className=\"absolute top-1 left-1 px-1.5 py-0.5 rounded bg-black/60 text-white text-[10px] font-medium backdrop-blur-xs flex items-center gap-1\">\n              {isVideo ? <Video className=\"w-2.5 h-2.5 text-white\" /> : <FileImage className=\"w-2.5 h-2.5 text-white\" />}\n            </div>\n            {isVideo && item.duration && (\n              <div className=\"absolute bottom-1 right-1 px-1 py-0.2 rounded bg-black/80 text-white text-[9px] font-mono\">\n                {item.duration}\n              </div>\n            )}\n          </div>\n\n          {/* Info */}\n          <div className=\"min-w-0\">\n            <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors\">\n              {item.filename}\n            </h4>\n            \n            <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-gray-500 dark:text-slate-400 mt-1\">\n              <span className=\"flex items-center gap-1\">\n                <Folder className=\"w-3 h-3 text-gray-400\" />\n                <span className=\"truncate max-w-[120px]\">{item.folder}</span>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3 h-3 text-gray-400\" />\n                <span>{new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}</span>\n              </span>\n              {item.size_formatted && (\n                <span className=\"text-gray-400 text-[10px]\">\342\200\242 {item.size_formatted}</span>\n              )}\n            </div>\n\n            {/* AI Summary snippet */}\n            {item.ai_analysis?.overall_summary && (\n              <p className=\"text-[11px] text-gray-600 dark:text-slate-300 line-clamp-1 mt-1 font-normal\">\n                <span className=\"font-semibold text-gray-800 dark:text-slate-200\">AI:</span> {item.ai_analysis.overall_summary}\n              </p>\n            )}\n          </div>\n        </div>\n\n        {/* Action buttons */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-lg transition-colors cursor-pointer ${\n              item.is_favorite \n                ? \'text-rose-500 bg-rose-50 dark:bg-rose-950/50\' \n                : \'text-gray-400 hover:text-rose-500 hover:bg-gray-100 dark:hover:bg-slate-800\'\n            }`}\n            title=\"Toggle favorite\"\n          >\n            <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-900 hover:bg-black dark:bg-white dark:hover:bg-slate-100 text-white dark:text-gray-900 shadow-2xs transition-colors cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // Grid view layout\n  return (\n    <div \n      onClick={() => onSelectMedia(item)}\n      className=\"group relative flex flex-col rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 hover:border-gray-400 dark:hover:border-slate-600 shadow-2xs transition-all cursor-pointer overflow-hidden\"\n    >\n      {/* Thumbnail Container */}\n      <div className=\"relative aspect-video w-full overflow-hidden bg-gray-100 dark:bg-slate-900\">\n        <img \n          src={item.thumbnail} \n          alt={item.filename}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between\">\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-xs text-white text-[10px] font-semibold\">\n            {isVideo ? (\n              <>\n                <Video className=\"w-3 h-3 text-white\" />\n                <span>Video</span>\n              </>\n            ) : (\n              <>\n                <FileImage className=\"w-3 h-3 text-white\" />\n                <span>Image</span>\n              </>\n            )}\n          </span>\n\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-1.5 rounded-full backdrop-blur-xs transition-all cursor-pointer ${\n              item.is_favorite \n                ? \'bg-rose-500 text-white shadow-2xs\' \n                : \'bg-black/40 text-white hover:bg-black/60 hover:text-rose-400\'\n            }`}\n            title=\"Favorite\"\n          >\n            <Heart className={`w-3.5 h-3.5 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n        </div>\n\n        {/* Video Play Icon / Duration overlay */}\n        {isVideo && (\n          <div className=\"absolute inset-0 flex items-center justify-center\">\n            <div className=\"w-9 h-9 rounded-full bg-white/90 dark:bg-slate-900/90 text-gray-900 dark:text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform\">\n              <Play className=\"w-4 h-4 fill-current ml-0.5\" />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom overlay info */}\n        <div className=\"absolute bottom-2 left-2 right-2 text-white flex items-center justify-between text-[11px]\">\n          <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded backdrop-blur-xs text-[10px]\">\n            <Folder className=\"w-3 h-3 text-slate-300\" />\n            <span className=\"truncate max-w-[100px]\">{item.folder}</span>\n          </span>\n\n          {isVideo && item.duration && (\n            <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded backdrop-blur-xs text-[10px] font-mono\">\n              <Clock className=\"w-3 h-3 text-slate-300\" />\n              <span>{item.duration}</span>\n            </span>\n          )}\n        </div>\n      </div>\n\n      {/* Card Info Content */}\n      <div className=\"p-3 flex flex-col justify-between flex-1 gap-2\">\n        <div>\n          <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate group-hover:text-gray-600 dark:group-hover:text-slate-300 transition-colors\">\n            {item.filename}\n          </p>\n\n          <p className=\"text-[10px] text-gray-400 dark:text-slate-400 mt-0.5\">\n            {new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\', year: \'numeric\' })} \342\200\242 {item.folder}\n          </p>\n        </div>\n\n        {/* Card Footer Actions */}\n        <div className=\"pt-2 border-t border-gray-100 dark:border-slate-800 flex items-center justify-between gap-2\">\n          <span className=\"text-[10px] font-semibold text-gray-400 dark:text-slate-500 uppercase\">\n            {item.size_formatted || \'1.2 MB\'}\n          </span>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-gray-100 hover:bg-gray-900 hover:text-white dark:bg-slate-800 dark:hover:bg-white dark:hover:text-gray-900 text-gray-800 dark:text-slate-200 transition-all cursor-pointer\"\n          >\n            <Sparkles className=\"w-3 h-3\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { \n  FileImage, \n  Video, \n  Folder, \n  Calendar, \n  Heart, \n  Sparkles, \n  Play, \n  Clock\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface MediaCardProps {\n  item: MediaItem;\n  viewMode: \'grid\' | \'list\';\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n}\n\nexport const MediaCard: React.FC<MediaCardProps> = ({\n  item,\n  viewMode,\n  onSelectMedia,\n  onGenerateCaption,\n  onToggleFavorite,\n}) => {\n  const isVideo = item.file_type === \'video\';\n\n  if (viewMode === \'list\') {\n    return (\n      <div \n        onClick={() => onSelectMedia(item)}\n        className=\"group relative flex items-center justify-between gap-4 p-3.5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 hover:border-gray-300 dark:hover:border-slate-700 shadow-card transition-all cursor-pointer\"\n      >\n        <div className=\"flex items-center gap-4 min-w-0\">\n          {/* Thumbnail */}\n          <div className=\"relative w-16 h-16 rounded-xl overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-900 border border-gray-200/60 dark:border-slate-700\">\n            <img \n              src={item.thumbnail} \n              alt={item.filename}\n              className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n              loading=\"lazy\"\n            />\n            <div className=\"absolute top-1 left-1 px-1.5 py-0.5 rounded-md bg-black/60 text-white text-[10px] font-medium backdrop-blur-xs flex items-center gap-1\">\n              {isVideo ? <Video className=\"w-2.5 h-2.5 text-white\" strokeWidth={1.75} /> : <FileImage className=\"w-2.5 h-2.5 text-white\" strokeWidth={1.75} />}\n            </div>\n            {isVideo && item.duration && (\n              <div className=\"absolute bottom-1 right-1 px-1 py-0.2 rounded bg-black/80 text-white text-[9px] font-mono\">\n                {item.duration}\n              </div>\n            )}\n          </div>\n\n          {/* Info */}\n          <div className=\"min-w-0\">\n            <h4 className=\"text-sm font-semibold text-gray-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors\">\n              {item.filename}\n            </h4>\n            \n            <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-slate-400 mt-1\">\n              <span className=\"flex items-center gap-1\">\n                <Folder className=\"w-3 h-3 text-gray-400\" strokeWidth={1.75} />\n                <span className=\"truncate max-w-[120px]\">{item.folder}</span>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3 h-3 text-gray-400\" strokeWidth={1.75} />\n                <span>{new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}</span>\n              </span>\n              {item.size_formatted && (\n                <span className=\"text-gray-400 text-xs\">\342\200\242 {item.size_formatted}</span>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Action buttons */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-xl transition-colors cursor-pointer ${\n              item.is_favorite \n                ? \'text-rose-500 bg-rose-50 dark:bg-rose-950/50\' \n                : \'text-gray-400 hover:text-rose-500 hover:bg-gray-100 dark:hover:bg-slate-800\'\n            }`}\n            title=\"Toggle favorite\"\n          >\n            <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} strokeWidth={1.75} />\n          </button>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3.5 h-9 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition-colors cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 fill-current\" strokeWidth={1.75} />\n            <span>Generate Caption</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // Grid view layout\n  return (\n    <div \n      onClick={() => onSelectMedia(item)}\n      className=\"group relative flex flex-col rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 hover:border-gray-300 dark:hover:border-slate-700 shadow-card transition-all cursor-pointer overflow-hidden\"\n    >\n      {/* Thumbnail Container */}\n      <div className=\"relative aspect-video w-full overflow-hidden bg-gray-100 dark:bg-slate-900\">\n        <img \n          src={item.thumbnail} \n          alt={item.filename}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-3 left-3 right-3 flex items-center justify-between\">\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-xs text-white text-[10px] font-semibold\">\n            {isVideo ? (\n              <>\n                <Video className=\"w-3 h-3 text-white\" strokeWidth={1.75} />\n                <span>Video</span>\n              </>\n            ) : (\n              <>\n                <FileImage className=\"w-3 h-3 text-white\" strokeWidth={1.75} />\n                <span>Image</span>\n              </>\n            )}\n          </span>\n\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-1.5 rounded-full backdrop-blur-xs transition-all cursor-pointer ${\n              item.is_favorite \n                ? \'bg-rose-500 text-white shadow-xs\' \n                : \'bg-black/40 text-white hover:bg-black/60 hover:text-rose-400\'\n            }`}\n            title=\"Favorite\"\n          >\n            <Heart className={`w-3.5 h-3.5 ${item.is_favorite ? \'fill-current\' : \'\'}`} strokeWidth={1.75} />\n          </button>\n        </div>\n\n        {/* Video Play Icon */}\n        {isVideo && (\n          <div className=\"absolute inset-0 flex items-center justify-center\">\n            <div className=\"w-10 h-10 rounded-full bg-white/90 dark:bg-slate-900/90 text-gray-900 dark:text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform\">\n              <Play className=\"w-4 h-4 fill-current ml-0.5\" strokeWidth={1.75} />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom overlay info */}\n        <div className=\"absolute bottom-2.5 left-2.5 right-2.5 text-white flex items-center justify-between text-[11px]\">\n          <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded-md backdrop-blur-xs text-[10px]\">\n            <Folder className=\"w-3 h-3 text-slate-300\" strokeWidth={1.75} />\n            <span className=\"truncate max-w-[100px]\">{item.folder}</span>\n          </span>\n\n          {isVideo && item.duration && (\n            <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded-md backdrop-blur-xs text-[10px] font-mono\">\n              <Clock className=\"w-3 h-3 text-slate-300\" strokeWidth={1.75} />\n              <span>{item.duration}</span>\n            </span>\n          )}\n        </div>\n      </div>\n\n      {/* Card Info Content */}\n      <div className=\"p-4 flex flex-col justify-between flex-1 gap-3\">\n        <div>\n          <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors\">\n            {item.filename}\n          </p>\n\n          <p className=\"text-[11px] text-gray-400 dark:text-slate-400 mt-1\">\n            {new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\', year: \'numeric\' })} \342\200\242 {item.folder}\n          </p>\n        </div>\n\n        {/* Card Footer Actions */}\n        <div className=\"pt-2 border-t border-gray-100 dark:border-slate-800 flex items-center justify-between gap-2\">\n          <span className=\"text-[11px] font-medium text-gray-400 dark:text-slate-500 uppercase\">\n            {item.size_formatted || \'1.2 MB\'}\n          </span>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 h-8 rounded-xl text-xs font-semibold bg-gray-50 hover:bg-blue-600 hover:text-white dark:bg-slate-800 dark:hover:bg-blue-600 text-gray-800 dark:text-slate-200 transition-all cursor-pointer border border-gray-200/80 dark:border-slate-700/80\"\n          >\n            <Sparkles className=\"w-3 h-3 fill-current\" strokeWidth={1.75} />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
