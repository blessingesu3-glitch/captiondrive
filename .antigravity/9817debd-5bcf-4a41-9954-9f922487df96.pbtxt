        <Folder className=\"w-3 h-3 text-slate-400\" />\n                <span className=\"truncate max-w-[120px]\">{item.folder}</span>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3 h-3 text-slate-400\" />\n                <span>{new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}</span>\n              </span>\n              {item.size_formatted && (\n                <span className=\"text-slate-400 text-[11px]\">\342\200\242 {item.size_formatted}</span>\n              )}\n            </div>\n\n            {/* AI Summary snippet */}\n            {item.ai_analysis?.overall_summary && (\n              <p className=\"text-xs text-slate-600 dark:text-slate-300 line-clamp-1 mt-1 font-normal italic\">\n                \"{item.ai_analysis.overall_summary}\"\n              </p>\n            )}\n          </div>\n        </div>\n\n        {/* Action buttons */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-full transition-colors ${\n              item.is_favorite \n                ? \'text-rose-500 bg-rose-50 dark:bg-rose-950/50\' \n                : \'text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-700\'\n            }`}\n            title=\"Toggle favorite\"\n          >\n            <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm shadow-indigo-500/20 transition-transform active:scale-95\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Generate Caption</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // Grid view layout\n  return (\n    <div \n      onClick={() => onSelectMedia(item)}\n      className=\"group relative flex flex-col rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 hover:border-indigo-400 dark:hover:border-indigo-500/60 hover:shadow-xl hover:shadow-indigo-500/5 transition-all cursor-pointer overflow-hidden\"\n    >\n      {/* Thumbnail Container */}\n      <div className=\"relative aspect-4/3 w-full overflow-hidden bg-slate-100 dark:bg-slate-900\">\n        <img \n          src={item.thumbnail} \n          alt={item.filename}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Dark overlay gradient on hover */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity\" />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between\">\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-medium border border-white/10\">\n            {isVideo ? (\n              <>\n                <Video className=\"w-3 h-3 text-amber-400\" />\n                <span>Video</span>\n              </>\n            ) : (\n              <>\n                <FileImage className=\"w-3 h-3 text-indigo-400\" />\n                <span>Image</span>\n              </>\n            )}\n          </span>\n\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-full backdrop-blur-md transition-all ${\n              item.is_favorite \n                ? \'bg-rose-500 text-white shadow-sm\' \n                : \'bg-black/40 text-white hover:bg-black/60 hover:text-rose-400\'\n            }`}\n            title=\"Favorite\"\n          >\n            <Heart className={`w-3.5 h-3.5 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n        </div>\n\n        {/* Video Play Icon / Duration overlay */}\n        {isVideo && (\n          <div className=\"absolute inset-0 flex items-center justify-center\">\n            <div className=\"w-10 h-10 rounded-full bg-white/90 dark:bg-slate-900/90 text-indigo-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform\">\n              <Play className=\"w-4 h-4 fill-current ml-0.5\" />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom overlay info */}\n        <div className=\"absolute bottom-2.5 left-2.5 right-2.5 text-white flex items-center justify-between text-xs\">\n          <span className=\"flex items-center gap-1 text-slate-200 bg-black/50 px-2 py-0.5 rounded-md backdrop-blur-xs text-[11px]\">\n            <Folder className=\"w-3 h-3 text-indigo-300\" />\n            <span className=\"truncate max-w-[100px]\">{item.folder}</span>\n          </span>\n\n          {isVideo && item.duration && (\n            <span className=\"flex items-center gap-1 text-slate-200 bg-black/50 px-2 py-0.5 rounded-md backdrop-blur-xs text-[11px] font-mono\">\n              <Clock className=\"w-3 h-3 text-amber-300\" />\n              <span>{item.duration}</span>\n            </span>\n          )}\n        </div>\n      </div>\n\n      {/* Card Info Content */}\n      <div className=\"p-3.5 flex flex-col justify-between flex-1 gap-2\">\n        <div>\n          <h4 className=\"text-sm font-semibold text-slate-900 dark:text-white line-clamp-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors\">\n            {item.filename}\n          </h4>\n\n          {item.ai_analysis?.overall_summary ? (\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-1 leading-relaxed\">\n              {item.ai_analysis.overall_summary}\n            </p>\n          ) : (\n            <p className=\"text-xs text-slate-400 dark:text-slate-500 italic mt-1\">\n              Click to run AI visual analysis...\n            </p>\n          )}\n        </div>\n\n        {/* Card Footer Actions */}\n        <div className=\"pt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-2\">\n          <span className=\"text-[11px] text-slate-400 dark:text-slate-500 flex items-center gap-1\">\n            <Calendar className=\"w-3 h-3\" />\n            {new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}\n          </span>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white dark:bg-indigo-950/60 dark:hover:bg-indigo-600 dark:text-indigo-300 dark:hover:text-white transition-all shadow-2xs\"\n          >\n            <Sparkles className=\"w-3 h-3\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  if (viewMode === \'list\') {\n    return (\n      <div \n        onClick={() => onSelectMedia(item)}\n        className=\"group relative flex items-center justify-between gap-4 p-3 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 shadow-xs hover:shadow-sm transition-all cursor-pointer\"\n      >\n        <div className=\"flex items-center gap-3.5 min-w-0\">\n          {/* Thumbnail */}\n          <div className=\"relative w-16 h-16 rounded-lg overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-900 border border-gray-100 dark:border-slate-700\">\n            <img \n              src={item.thumbnail} \n              alt={item.filename}\n              className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n              loading=\"lazy\"\n            />\n            <div className=\"absolute top-1 left-1 px-1.5 py-0.5 rounded bg-black/60 text-white text-[10px] font-medium backdrop-blur-xs flex items-center gap-1\">\n              {isVideo ? <Video className=\"w-2.5 h-2.5 text-amber-400\" /> : <FileImage className=\"w-2.5 h-2.5 text-indigo-400\" />}\n            </div>\n            {isVideo && item.duration && (\n              <div className=\"absolute bottom-1 right-1 px-1 py-0.2 rounded bg-black/80 text-white text-[9px] font-mono\">\n                {item.duration}\n              </div>\n            )}\n          </div>\n\n          {/* Info */}\n          <div className=\"min-w-0\">\n            <h4 className=\"text-sm font-bold text-gray-900 dark:text-white truncate group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors\">\n              {item.filename}\n            </h4>\n            \n            <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-slate-400 mt-1\">\n              <span className=\"flex items-center gap-1\">\n                <Folder className=\"w-3 h-3 text-gray-400\" />\n                <span className=\"truncate max-w-[120px]\">{item.folder}</span>\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3 h-3 text-gray-400\" />\n                <span>{new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\' })}</span>\n              </span>\n              {item.size_formatted && (\n                <span className=\"text-gray-400 text-[11px]\">\342\200\242 {item.size_formatted}</span>\n              )}\n            </div>\n\n            {/* AI Summary snippet */}\n            {item.ai_analysis?.overall_summary && (\n              <p className=\"text-xs text-gray-600 dark:text-slate-300 line-clamp-1 mt-1 font-normal\">\n                <span className=\"font-semibold text-gray-800 dark:text-slate-200\">AI:</span> {item.ai_analysis.overall_summary}\n              </p>\n            )}\n          </div>\n        </div>\n\n        {/* Action buttons */}\n        <div className=\"flex items-center gap-2 shrink-0\">\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-2 rounded-lg transition-colors cursor-pointer ${\n              item.is_favorite \n                ? \'text-rose-500 bg-rose-50 dark:bg-rose-950/50\' \n                : \'text-gray-400 hover:text-rose-500 hover:bg-gray-100 dark:hover:bg-slate-700\'\n            }`}\n            title=\"Toggle favorite\"\n          >\n            <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-colors cursor-pointer\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  // Grid view layout\n  return (\n    <div \n      onClick={() => onSelectMedia(item)}\n      className=\"group relative flex flex-col rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 shadow-xs hover:shadow-md transition-all cursor-pointer overflow-hidden\"\n    >\n      {/* Thumbnail Container */}\n      <div className=\"relative aspect-video w-full overflow-hidden bg-gray-100 dark:bg-slate-900\">\n        <img \n          src={item.thumbnail} \n          alt={item.filename}\n          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          loading=\"lazy\"\n        />\n\n        {/* Top Badges */}\n        <div className=\"absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between\">\n          <span className=\"inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-black/60 backdrop-blur-xs text-white text-[10px] font-bold\">\n            {isVideo ? (\n              <>\n                <Video className=\"w-3 h-3 text-amber-400\" />\n                <span>Video</span>\n              </>\n            ) : (\n              <>\n                <FileImage className=\"w-3 h-3 text-indigo-400\" />\n                <span>Image</span>\n              </>\n            )}\n          </span>\n\n          <button\n            onClick={(e) => onToggleFavorite(item.id, e)}\n            className={`p-1.5 rounded-full backdrop-blur-xs transition-all cursor-pointer ${\n              item.is_favorite \n                ? \'bg-rose-500 text-white shadow-xs\' \n                : \'bg-black/40 text-white hover:bg-black/60 hover:text-rose-400\'\n            }`}\n            title=\"Favorite\"\n          >\n            <Heart className={`w-3.5 h-3.5 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n          </button>\n        </div>\n\n        {/* Video Play Icon / Duration overlay */}\n        {isVideo && (\n          <div className=\"absolute inset-0 flex items-center justify-center\">\n            <div className=\"w-9 h-9 rounded-full bg-white/90 dark:bg-slate-900/90 text-indigo-600 flex items-center justify-center shadow-md group-hover:scale-110 transition-transform\">\n              <Play className=\"w-4 h-4 fill-current ml-0.5\" />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom overlay info */}\n        <div className=\"absolute bottom-2 left-2 right-2 text-white flex items-center justify-between text-[11px]\">\n          <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded backdrop-blur-xs text-[10px]\">\n            <Folder className=\"w-3 h-3 text-indigo-300\" />\n            <span className=\"truncate max-w-[100px]\">{item.folder}</span>\n          </span>\n\n          {isVideo && item.duration && (\n            <span className=\"flex items-center gap-1 text-slate-200 bg-black/60 px-2 py-0.5 rounded backdrop-blur-xs text-[10px] font-mono\">\n              <Clock className=\"w-3 h-3 text-amber-300\" />\n              <span>{item.duration}</span>\n            </span>\n          )}\n        </div>\n      </div>\n\n      {/* Card Info Content */}\n      <div className=\"p-3 flex flex-col justify-between flex-1 gap-2\">\n        <div>\n          <p className=\"text-sm font-bold text-gray-900 dark:text-white truncate group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors\">\n            {item.filename}\n          </p>\n\n          <p className=\"text-[10px] text-gray-400 dark:text-slate-400 mt-0.5\">\n            {new Date(item.uploaded_at).toLocaleDateString(undefined, { month: \'short\', day: \'numeric\', year: \'numeric\' })} \342\200\242 {item.folder}\n          </p>\n        </div>\n\n        {/* Card Footer Actions */}\n        <div className=\"pt-2 border-t border-gray-100 dark:border-slate-700/60 flex items-center justify-between gap-2\">\n          <span className=\"text-[10px] font-semibold text-gray-500 dark:text-slate-400 uppercase\">\n            {item.size_formatted || \'1.2 MB\'}\n          </span>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onGenerateCaption(item);\n            }}\n            className=\"flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-bold bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white dark:bg-indigo-950 dark:hover:bg-indigo-600 dark:text-indigo-300 dark:hover:text-white transition-all cursor-pointer\"\n          >\n            <Sparkles className=\"w-3 h-3\" />\n            <span>Caption</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
