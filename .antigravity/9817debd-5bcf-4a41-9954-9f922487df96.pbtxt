    replacement_chunks {
      target_content: "      {/* Welcome Banner */}\n      <div className=\"p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 shadow-xs\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 text-[11px] font-semibold border border-indigo-100 dark:border-indigo-900/50 uppercase tracking-wider\">\n              <Sparkles className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400\" />\n              <span>AI Media Analysis & Social Publisher</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white\">\n              Hello, {user.name.split(\' \')[0]} \360\237\221\213\n            </h1>\n            \n            <p className=\"text-xs sm:text-sm text-gray-600 dark:text-slate-400 leading-relaxed\">\n              Scan Google Drive media, analyze photos or videos using Gemini multimodal vision, generate platform-specific captions, and schedule post approvals.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {user.isDriveConnected ? (\n              <button\n                onClick={onOpenImportModal}\n                className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>Import File</span>\n              </button>\n            ) : (\n              <button\n                onClick={onConnectDrive}\n                className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <span>Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        \n        {/* Metric 1 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 shadow-xs flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0\">\n            <FolderOpen className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {mediaItems.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Synced Drive Assets\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 shadow-xs flex items-center gap-4\">\n          <div className=\"w-11 h-11 rounded-lg bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {captionHistory.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Captions Generated\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 shadow-xs flex items-center gap-4\">\n          <div className={`w-11 h-11 rounded-lg flex items-center justify-center shrink-0 ${\n            user.isDriveConnected \n              ? \'bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400\' \n              : \'bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400\'\n          }`}>\n            <HardDrive className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <span className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-1.5\">\n              {user.isDriveConnected ? (\n                <>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500\" />\n                  <span>Sync Active</span>\n                </>\n              ) : (\n                <span>Action Needed</span>\n              )}\n            </span>\n            <span className=\"text-xs text-gray-500 dark:text-slate-400 truncate max-w-[150px] block\">\n              {user.isDriveConnected ? user.connectedDriveEmail : \'Drive Sync Inactive\'}\n            </span>\n          </div>\n        </div>\n\n      </div>"
      replacement_content: "      {/* Welcome Banner */}\n      <div className=\"p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs\">\n        <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-100 dark:bg-slate-800 text-gray-800 dark:text-slate-200 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 uppercase tracking-wider\">\n              <Sparkles className=\"w-3.5 h-3.5 text-gray-900 dark:text-white\" />\n              <span>AI Media Analysis & Social Publisher</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white\">\n              Hello, {user.name.split(\' \')[0]} \360\237\221\213\n            </h1>\n            \n            <p className=\"text-xs sm:text-sm text-gray-600 dark:text-slate-400 leading-relaxed\">\n              Scan Google Drive media, analyze photos or videos using Gemini multimodal vision, generate platform-specific captions, and schedule post approvals.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {user.isDriveConnected ? (\n              <button\n                onClick={onOpenImportModal}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-gray-900 hover:bg-black dark:bg-white dark:hover:bg-slate-100 text-white dark:text-gray-900 shadow-2xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>Import File</span>\n              </button>\n            ) : (\n              <button\n                onClick={onConnectDrive}\n                className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-2xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2 rounded-lg text-xs font-semibold bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-800 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <span>Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        \n        {/* Metric 1 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <FolderOpen className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {mediaItems.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Synced Drive Assets\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-gray-900 dark:text-white block\">\n              {captionHistory.length}\n            </span>\n            <span className=\"text-xs font-semibold text-gray-500 dark:text-slate-400\">\n              Captions Generated\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"p-5 rounded-xl bg-white dark:bg-slate-900 border border-gray-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-lg bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-900 dark:text-white flex items-center justify-center shrink-0\">\n            <HardDrive className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <span className=\"text-sm font-bold text-gray-900 dark:text-white flex items-center gap-1.5\">\n              {user.isDriveConnected ? (\n                <>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500\" />\n                  <span>Sync Active</span>\n                </>\n              ) : (\n                <span>Action Needed</span>\n              )}\n            </span>\n            <span className=\"text-xs text-gray-500 dark:text-slate-400 truncate max-w-[150px] block\">\n              {user.isDriveConnected ? user.connectedDriveEmail : \'Drive Sync Inactive\'}\n            </span>\n          </div>\n        </div>\n\n      </div>"
