    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Welcome Banner */}\n      <div className=\"relative overflow-hidden p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 text-white shadow-md\">\n        {/* Background glow graphics */}\n        <div className=\"absolute -top-12 -right-12 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"absolute -bottom-12 -left-12 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl pointer-events-none\" />\n\n        <div className=\"relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-white/10 text-indigo-300 text-[11px] font-bold backdrop-blur-md border border-white/10 uppercase tracking-wider\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>AI Content Analysis & Captions</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">\n              Hello, {user.name.split(\' \')[0]} \360\237\221\213\n            </h1>\n            \n            <p className=\"text-xs sm:text-sm text-indigo-200/90 leading-relaxed\">\n              Scan Google Drive media assets, perform multimodal computer vision analysis, and craft viral social captions in seconds.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {user.isDriveConnected ? (\n              <button\n                onClick={onOpenImportModal}\n                className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <PlusCircle className=\"w-4 h-4\" />\n                <span>Import New File</span>\n              </button>\n            ) : (\n              <button\n                onClick={onConnectDrive}\n                className=\"px-4 py-2 rounded-lg text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs transition-transform active:scale-95 flex items-center gap-2 cursor-pointer\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Sync Google Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2 rounded-lg text-sm font-medium bg-white/10 hover:bg-white/20 text-white border border-white/15 backdrop-blur-md flex items-center gap-1.5 transition-colors cursor-pointer\"\n            >\n              <span>View Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n"
