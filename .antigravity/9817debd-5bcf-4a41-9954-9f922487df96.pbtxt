    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { Sparkles, HardDrive, Zap, CheckCircle2, ArrowRight, X } from \'lucide-react\';\n\ninterface OnboardingModalProps {\n  onClose: () => void;\n  onConnectDrive: () => void;\n}\n\nexport const OnboardingModal: React.FC<OnboardingModalProps> = ({ onClose, onConnectDrive }) => {\n  const [step, setStep] = useState<number>(1);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-lg bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden p-6 sm:p-8 space-y-6 text-center\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 p-2 rounded-full text-slate-400 hover:text-slate-900 dark:hover:text-white\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {/* Step 1: Welcome */}\n        {step === 1 && (\n          <div className=\"space-y-4\">\n            <div className=\"w-16 h-16 rounded-3xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center text-white mx-auto shadow-xl shadow-indigo-500/30\">\n              <Sparkles className=\"w-8 h-8 animate-pulse\" />\n            </div>\n\n            <div className=\"space-y-2\">\n              <h2 className=\"text-2xl font-bold text-slate-900 dark:text-white\">\n                Welcome to CaptionDrive\n              </h2>\n              <p className=\"text-xs text-slate-600 dark:text-slate-300 max-w-sm mx-auto leading-relaxed\">\n                Turn your Google Drive images and videos into social media captions in seconds with Gemini AI.\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 text-left space-y-2.5 text-xs text-slate-700 dark:text-slate-300\">\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-500 shrink-0\" />\n                <span>No more downloading files or switching between tabs</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-500 shrink-0\" />\n                <span>Multimodal Gemini vision analyzes photos & video transcripts</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-500 shrink-0\" />\n                <span>Generates 3 tailored platform captions (Instagram, LinkedIn, X, FB)</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => setStep(2)}\n              className=\"w-full py-3 px-4 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-500/25 flex items-center justify-center gap-2 transition-transform active:scale-95\"\n            >\n              <span>Get Started</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        )}\n\n        {/* Step 2: Connect Drive or Try Sample */}\n        {step === 2 && (\n          <div className=\"space-y-5\">\n            <div className=\"w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 dark:bg-emerald-950 dark:text-emerald-400 flex items-center justify-center mx-auto\">\n              <HardDrive className=\"w-7 h-7\" />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <h2 className=\"text-xl font-bold text-slate-900 dark:text-white\">\n                Connect Google Drive\n              </h2>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n                Securely grant read-only access to scan your photos and video assets.\n              </p>\n            </div>\n\n            <div className=\"space-y-2.5\">\n              <button\n                onClick={() => {\n                  onConnectDrive();\n                  onClose();\n                }}\n                className=\"w-full py-3 px-4 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg shadow-emerald-500/25 flex items-center justify-center gap-2\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect My Google Drive</span>\n              </button>\n\n              <button\n                onClick={onClose}\n                className=\"w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n              >\n                Explore Sample Drive Media First\n              </button>\n            </div>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { Sparkles, HardDrive, CheckCircle2, ArrowRight, X } from \'lucide-react\';\n\ninterface OnboardingModalProps {\n  onClose: () => void;\n  onConnectDrive: () => void;\n}\n\nexport const OnboardingModal: React.FC<OnboardingModalProps> = ({ onClose, onConnectDrive }) => {\n  const [step, setStep] = useState<number>(1);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-lg bg-white dark:bg-[#111622] rounded-[24px] border border-gray-200 dark:border-slate-800 shadow-2xl overflow-hidden p-6 sm:p-8 space-y-6 text-center\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <button\n          onClick={onClose}\n          className=\"absolute top-5 right-5 p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n        >\n          <X className=\"w-5 h-5\" strokeWidth={1.75} />\n        </button>\n\n        {/* Step 1: Welcome */}\n        {step === 1 && (\n          <div className=\"space-y-4\">\n            <div className=\"w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center mx-auto shadow-xs\">\n              <Sparkles className=\"w-7 h-7\" strokeWidth={1.75} />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <h2 className=\"text-2xl font-bold tracking-tight text-gray-900 dark:text-white\">\n                Welcome to CaptionDrive\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto leading-relaxed\">\n                Turn your Google Drive media into platform-specific social media captions using Gemini AI.\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 text-left space-y-2.5 text-xs text-gray-700 dark:text-slate-300\">\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" strokeWidth={1.75} />\n                <span>Seamless integration with Google Drive media folders</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" strokeWidth={1.75} />\n                <span>Multimodal AI analyzes visual subjects, context & speech</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" strokeWidth={1.75} />\n                <span>Generates optimized variations for Instagram, LinkedIn, X & Facebook</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => setStep(2)}\n              className=\"w-full h-10 px-4 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center justify-center gap-2 transition-transform active:scale-95 cursor-pointer\"\n            >\n              <span>Get Started</span>\n              <ArrowRight className=\"w-4 h-4\" strokeWidth={1.75} />\n            </button>\n          </div>\n        )}\n\n        {/* Step 2: Connect Drive or Try Sample */}\n        {step === 2 && (\n          <div className=\"space-y-5\">\n            <div className=\"w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 flex items-center justify-center mx-auto border border-emerald-100 dark:border-emerald-900/40\">\n              <HardDrive className=\"w-7 h-7\" strokeWidth={1.75} />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <h2 className=\"text-xl font-bold tracking-tight text-gray-900 dark:text-white\">\n                Connect Google Drive\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto leading-relaxed\">\n                Securely grant access to scan your media files and folders.\n              </p>\n            </div>\n\n            <div className=\"space-y-2\">\n              <button\n                onClick={() => {\n                  onConnectDrive();\n                  onClose();\n                }}\n                className=\"w-full h-10 px-4 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs flex items-center justify-center gap-2 cursor-pointer transition-transform active:scale-95\"\n              >\n                <HardDrive className=\"w-4 h-4\" strokeWidth={1.75} />\n                <span>Connect Google Drive Account</span>\n              </button>\n\n              <button\n                onClick={onClose}\n                className=\"w-full h-10 px-4 rounded-xl text-xs font-semibold text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n              >\n                Explore Sample Drive Library\n              </button>\n            </div>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n};\n"
    }
