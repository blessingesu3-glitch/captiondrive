    instruction: "Update MediaDetailModal.tsx with #2563EB accent blue, 24px modal container, 12px buttons, and Linear styling."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { \n  X, \n  Sparkles, \n  Folder, \n  Calendar, \n  Heart, \n  Video, \n  FileImage, \n  Tag, \n  Eye, \n  Palette, \n  Activity, \n  MessageSquareQuote, \n  Check, \n  Clock,\n  ExternalLink,\n  Layers\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface MediaDetailModalProps {\n  item: MediaItem;\n  onClose: () => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onAnalyzeWithAI: (item: MediaItem) => void;\n  isAnalyzing?: boolean;\n}\n\nexport const MediaDetailModal: React.FC<MediaDetailModalProps> = ({\n  item,\n  onClose,\n  onGenerateCaption,\n  onToggleFavorite,\n  onAnalyzeWithAI,\n  isAnalyzing = false\n}) => {\n  const isVideo = item.file_type === \'video\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/70 backdrop-blur-md animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-4xl max-h-[90vh] bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col md:flex-row\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        \n        {/* Close button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 z-20 p-2 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {/* Left Column: High-Res Preview */}\n        <div className=\"w-full md:w-1/2 bg-slate-950 flex flex-col justify-between relative group min-h-[280px] md:min-h-auto\">\n          <div className=\"relative flex-1 flex items-center justify-center p-4 overflow-hidden\">\n            {isVideo ? (\n              <div className=\"relative w-full h-full flex flex-col items-center justify-center\">\n                <img \n                  src={item.preview_url || item.thumbnail} \n                  alt={item.filename}\n                  className=\"w-full max-h-[380px] object-contain rounded-2xl\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center bg-black/30\">\n                  <div className=\"p-4 rounded-full bg-white/90 text-indigo-600 shadow-2xl backdrop-blur-xs\">\n                    <Video className=\"w-8 h-8 fill-current\" />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <img \n                src={item.preview_url || item.thumbnail} \n                alt={item.filename}\n                className=\"w-full max-h-[420px] object-contain rounded-2xl\"\n              />\n            )}\n          </div>\n\n          {/* Bottom Bar on image column */}\n          <div className=\"p-4 bg-slate-900/90 backdrop-blur-xs border-t border-slate-800 flex items-center justify-between gap-3 text-xs text-slate-300\">\n            <span className=\"truncate max-w-[200px] font-mono text-slate-400\">{item.filename}</span>\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={(e) => onToggleFavorite(item.id, e)}\n                className={`p-2 rounded-xl border transition-colors ${\n                  item.is_favorite \n                    ? \'bg-rose-500 text-white border-rose-500\' \n                    : \'border-slate-700 text-slate-300 hover:bg-slate-800\'\n                }`}\n              >\n                <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} />\n              </button>\n              {item.web_view_link && (\n                <a\n                  href={item.web_view_link}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"p-2 rounded-xl border border-slate-700 text-slate-300 hover:bg-slate-800 transition-colors\"\n                  title=\"Open in Google Drive\"\n                >\n                  <ExternalLink className=\"w-4 h-4\" />\n                </a>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: AI Analysis & Caption Trigger */}\n        <div className=\"w-full md:w-1/2 p-6 flex flex-col justify-between overflow-y-auto max-h-[90vh] md:max-h-none\">\n          \n          <div className=\"space-y-5\">\n            \n            {/* Title Header */}\n            <div>\n              <div className=\"flex items-center gap-2 mb-1\">\n                <span className=\"px-2 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1\">\n                  {isVideo ? <Video className=\"w-3 h-3\" /> : <FileImage className=\"w-3 h-3\" />}\n                  {item.file_type}\n                </span>\n                <span className=\"text-xs text-gray-500 flex items-center gap-1\">\n                  <Folder className=\"w-3 h-3\" />\n                  {item.folder}\n                </span>\n              </div>\n              \n              <h2 className=\"text-lg font-bold text-gray-900 dark:text-white leading-tight\">\n                {item.filename}\n              </h2>\n            </div>\n\n            {/* AI Insights Panel */}\n            <div className=\"p-4 rounded-xl bg-indigo-50/60 dark:bg-indigo-950/40 border border-indigo-100 dark:border-indigo-900/50 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold uppercase tracking-wider text-indigo-700 dark:text-indigo-300 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-indigo-600\" />\n                  AI Content Analysis\n                </span>\n                \n                <button\n                  onClick={() => onAnalyzeWithAI(item)}\n                  disabled={isAnalyzing}\n                  className=\"text-[11px] font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1 disabled:opacity-50 cursor-pointer\"\n                >\n                  {isAnalyzing ? \'Analyzing with Gemini...\' : \'Re-Analyze\'}\n                </button>\n              </div>\n\n              {item.ai_analysis ? (\n                <div className=\"space-y-3 text-xs text-slate-700 dark:text-slate-300\">\n                  \n                  {/* Overall Summary */}\n                  <div>\n                    <span className=\"font-semibold text-slate-900 dark:text-slate-100\">Summary:</span>\n                    <p className=\"mt-0.5 leading-relaxed text-slate-600 dark:text-slate-300 italic bg-white/60 dark:bg-slate-900/60 p-2.5 rounded-xl border border-indigo-100/60 dark:border-indigo-900/40\">\n                      \"{item.ai_analysis.overall_summary}\"\n                    </p>\n                  </div>\n\n                  {/* Main Subject & Mood */}\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div className=\"p-2 rounded-xl bg-white/50 dark:bg-slate-900/50 border border-indigo-100/50 dark:border-indigo-900/30\">\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-0.5\">Main Subject</span>\n                      <p className=\"font-medium text-slate-800 dark:text-slate-200 line-clamp-2\">{item.ai_analysis.main_subject}</p>\n                    </div>\n                    <div className=\"p-2 rounded-xl bg-white/50 dark:bg-slate-900/50 border border-indigo-100/50 dark:border-indigo-900/30\">\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-0.5\">Mood & Vibe</span>\n                      <p className=\"font-medium text-slate-800 dark:text-slate-200\">{item.ai_analysis.mood}</p>\n                    </div>\n                  </div>\n\n                  {/* Detected Objects Pills */}\n                  {item.ai_analysis.objects && item.ai_analysis.objects.length > 0 && (\n                    <div>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-1\">Detected Objects</span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.ai_analysis.objects.map((obj) => (\n                          <span key={obj} className=\"px-2 py-0.5 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-[11px] font-medium text-slate-700 dark:text-slate-300\">\n                            {obj}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Color Palette */}\n                  {item.ai_analysis.colors && item.ai_analysis.colors.length > 0 && (\n                    <div>\n                      <span className=\"text-[10px] uppercase font-bold text-slate-400 block mb-1\">Color Palette</span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.ai_analysis.colors.map((c) => (\n                          <span key={c} className=\"px-2 py-0.5 rounded-full bg-slate-200/80 dark:bg-slate-800 text-[10px] font-medium text-slate-600 dark:text-slate-400\">\n                            {c}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Video Specific: Transcript & Points */}\n                  {isVideo && item.ai_analysis.transcript && (\n                    <div className=\"pt-2 border-t border-indigo-200/50 dark:border-indigo-900/50 space-y-1.5\">\n                      <span className=\"font-semibold text-slate-900 dark:text-slate-100 flex items-center gap-1\">\n                        <MessageSquareQuote className=\"w-3.5 h-3.5 text-indigo-500\" />\n                        Speech Transcript & Key Points:\n                      </span>\n                      <p className=\"text-[11px] text-slate-600 dark:text-slate-300 bg-white/70 dark:bg-slate-900/70 p-2 rounded-lg\">\n                        {item.ai_analysis.transcript}\n                      </p>\n                      {item.ai_analysis.key_talking_points && (\n                        <ul className=\"list-disc list-inside text-[11px] text-slate-600 dark:text-slate-300 space-y-0.5 pt-1\">\n                          {item.ai_analysis.key_talking_points.map((pt, idx) => (\n                            <li key={idx}>{pt}</li>\n                          ))}\n                        </ul>\n                      )}\n                    </div>\n                  )}\n\n                </div>\n              ) : (\n                <div className=\"text-center py-6 text-slate-500 text-xs\">\n                  <p>AI insights not generated yet.</p>\n                  <button\n                    onClick={() => onAnalyzeWithAI(item)}\n                    className=\"mt-2 px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-semibold text-xs\"\n                  >\n                    Analyze with Gemini\n                  </button>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n          {/* Action CTA */}\n          <div className=\"pt-4 border-t border-slate-200 dark:border-slate-800 mt-4 flex items-center justify-end gap-3\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n            >\n              Close\n            </button>\n            <button\n              onClick={() => {\n                onClose();\n                onGenerateCaption(item);\n              }}\n              className=\"px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-500/25 flex items-center gap-2 transition-transform active:scale-95\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Generate Captions</span>\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { \n  X, \n  Sparkles, \n  Folder, \n  Heart, \n  Video, \n  FileImage, \n  MessageSquareQuote, \n  ExternalLink\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface MediaDetailModalProps {\n  item: MediaItem;\n  onClose: () => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onToggleFavorite: (id: string, e: React.MouseEvent) => void;\n  onAnalyzeWithAI: (item: MediaItem) => void;\n  isAnalyzing?: boolean;\n}\n\nexport const MediaDetailModal: React.FC<MediaDetailModalProps> = ({\n  item,\n  onClose,\n  onGenerateCaption,\n  onToggleFavorite,\n  onAnalyzeWithAI,\n  isAnalyzing = false\n}) => {\n  const isVideo = item.file_type === \'video\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n      <div \n        className=\"relative w-full max-w-4xl max-h-[90vh] bg-white dark:bg-[#111622] rounded-[24px] border border-gray-200 dark:border-slate-800 shadow-2xl overflow-hidden flex flex-col md:flex-row\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        \n        {/* Close button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 z-20 p-2 rounded-lg bg-gray-100 dark:bg-slate-800 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer\"\n        >\n          <X className=\"w-5 h-5\" strokeWidth={1.75} />\n        </button>\n\n        {/* Left Column: High-Res Preview */}\n        <div className=\"w-full md:w-1/2 bg-slate-950 flex flex-col justify-between relative group min-h-[280px] md:min-h-auto\">\n          <div className=\"relative flex-1 flex items-center justify-center p-4 overflow-hidden\">\n            {isVideo ? (\n              <div className=\"relative w-full h-full flex flex-col items-center justify-center\">\n                <img \n                  src={item.preview_url || item.thumbnail} \n                  alt={item.filename}\n                  className=\"w-full max-h-[380px] object-contain rounded-xl\"\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center bg-black/30\">\n                  <div className=\"p-4 rounded-full bg-white/90 text-blue-600 shadow-2xl backdrop-blur-xs\">\n                    <Video className=\"w-8 h-8 fill-current\" />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <img \n                src={item.preview_url || item.thumbnail} \n                alt={item.filename}\n                className=\"w-full max-h-[420px] object-contain rounded-xl\"\n              />\n            )}\n          </div>\n\n          {/* Bottom Bar on image column */}\n          <div className=\"p-4 bg-slate-900/90 backdrop-blur-xs border-t border-slate-800 flex items-center justify-between gap-3 text-xs text-slate-300\">\n            <span className=\"truncate max-w-[200px] font-mono text-slate-400\">{item.filename}</span>\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={(e) => onToggleFavorite(item.id, e)}\n                className={`p-2 rounded-lg border transition-colors cursor-pointer ${\n                  item.is_favorite \n                    ? \'bg-rose-500 text-white border-rose-500\' \n                    : \'border-slate-700 text-slate-300 hover:bg-slate-800\'\n                }`}\n              >\n                <Heart className={`w-4 h-4 ${item.is_favorite ? \'fill-current\' : \'\'}`} strokeWidth={1.75} />\n              </button>\n              {item.web_view_link && (\n                <a\n                  href={item.web_view_link}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"p-2 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 transition-colors\"\n                  title=\"Open in Drive\"\n                >\n                  <ExternalLink className=\"w-4 h-4\" strokeWidth={1.75} />\n                </a>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: AI Analysis & Caption Trigger */}\n        <div className=\"w-full md:w-1/2 p-6 flex flex-col justify-between overflow-y-auto max-h-[90vh] md:max-h-none\">\n          \n          <div className=\"space-y-5\">\n            \n            {/* Title Header */}\n            <div>\n              <div className=\"flex items-center gap-2 mb-1\">\n                <span className=\"px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 text-xs font-bold uppercase tracking-wider flex items-center gap-1 border border-blue-100 dark:border-blue-900/40\">\n                  {isVideo ? <Video className=\"w-3 h-3\" /> : <FileImage className=\"w-3 h-3\" />}\n                  {item.file_type}\n                </span>\n                <span className=\"text-xs text-gray-500 dark:text-slate-400 flex items-center gap-1\">\n                  <Folder className=\"w-3 h-3\" strokeWidth={1.75} />\n                  {item.folder}\n                </span>\n              </div>\n              \n              <h2 className=\"text-lg font-bold text-gray-900 dark:text-white leading-tight\">\n                {item.filename}\n              </h2>\n            </div>\n\n            {/* AI Insights Panel */}\n            <div className=\"p-4 rounded-xl bg-blue-50/50 dark:bg-slate-800/60 border border-blue-100 dark:border-slate-700 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400 flex items-center gap-1.5\">\n                  <Sparkles className=\"w-4 h-4 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n                  AI Content Analysis\n                </span>\n                \n                <button\n                  onClick={() => onAnalyzeWithAI(item)}\n                  disabled={isAnalyzing}\n                  className=\"text-[11px] font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 disabled:opacity-50 cursor-pointer\"\n                >\n                  {isAnalyzing ? \'Analyzing...\' : \'Re-Analyze\'}\n                </button>\n              </div>\n\n              {item.ai_analysis ? (\n                <div className=\"space-y-3 text-xs text-gray-700 dark:text-slate-300\">\n                  \n                  {/* Overall Summary */}\n                  <div>\n                    <span className=\"font-semibold text-gray-900 dark:text-white\">Summary:</span>\n                    <p className=\"mt-1 leading-relaxed text-gray-600 dark:text-slate-300 italic bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-gray-200 dark:border-slate-800\">\n                      \"{item.ai_analysis.overall_summary}\"\n                    </p>\n                  </div>\n\n                  {/* Main Subject & Mood */}\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div className=\"p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800\">\n                      <span className=\"text-[10px] uppercase font-bold text-gray-400 dark:text-slate-500 block mb-0.5\">Main Subject</span>\n                      <p className=\"font-medium text-gray-800 dark:text-slate-200 line-clamp-2\">{item.ai_analysis.main_subject}</p>\n                    </div>\n                    <div className=\"p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800\">\n                      <span className=\"text-[10px] uppercase font-bold text-gray-400 dark:text-slate-500 block mb-0.5\">Mood & Vibe</span>\n                      <p className=\"font-medium text-gray-800 dark:text-slate-200\">{item.ai_analysis.mood}</p>\n                    </div>\n                  </div>\n\n                  {/* Detected Objects Pills */}\n                  {item.ai_analysis.objects && item.ai_analysis.objects.length > 0 && (\n                    <div>\n                      <span className=\"text-[10px] uppercase font-bold text-gray-400 dark:text-slate-500 block mb-1\">Detected Objects</span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.ai_analysis.objects.map((obj) => (\n                          <span key={obj} className=\"px-2 py-0.5 rounded-md bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 text-[11px] font-medium text-gray-700 dark:text-slate-300\">\n                            {obj}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Color Palette */}\n                  {item.ai_analysis.colors && item.ai_analysis.colors.length > 0 && (\n                    <div>\n                      <span className=\"text-[10px] uppercase font-bold text-gray-400 dark:text-slate-500 block mb-1\">Color Palette</span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {item.ai_analysis.colors.map((c) => (\n                          <span key={c} className=\"px-2 py-0.5 rounded-full bg-gray-200 dark:bg-slate-800 text-[10px] font-medium text-gray-700 dark:text-slate-300\">\n                            {c}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Video Specific: Transcript & Points */}\n                  {isVideo && item.ai_analysis.transcript && (\n                    <div className=\"pt-2 border-t border-gray-200 dark:border-slate-700 space-y-1.5\">\n                      <span className=\"font-semibold text-gray-900 dark:text-white flex items-center gap-1\">\n                        <MessageSquareQuote className=\"w-3.5 h-3.5 text-blue-600\" />\n                        Speech Transcript & Key Points:\n                      </span>\n                      <p className=\"text-[11px] text-gray-600 dark:text-slate-300 bg-white dark:bg-slate-900 p-2.5 rounded-lg border border-gray-200 dark:border-slate-800\">\n                        {item.ai_analysis.transcript}\n                      </p>\n                      {item.ai_analysis.key_talking_points && (\n                        <ul className=\"list-disc list-inside text-[11px] text-gray-600 dark:text-slate-300 space-y-0.5 pt-1\">\n                          {item.ai_analysis.key_talking_points.map((pt, idx) => (\n                            <li key={idx}>{pt}</li>\n                          ))}\n                        </ul>\n                      )}\n                    </div>\n                  )}\n\n                </div>\n              ) : (\n                <div className=\"text-center py-6 text-gray-500 dark:text-slate-400 text-xs\">\n                  <p>AI analysis not generated yet.</p>\n                  <button\n                    onClick={() => onAnalyzeWithAI(item)}\n                    className=\"mt-2 px-3 h-8 rounded-lg bg-blue-600 text-white font-semibold text-xs cursor-pointer shadow-xs\"\n                  >\n                    Analyze with Gemini\n                  </button>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n          {/* Action CTA */}\n          <div className=\"pt-4 border-t border-gray-200 dark:border-slate-800 mt-4 flex items-center justify-end gap-3\">\n            <button\n              onClick={onClose}\n              className=\"px-4 h-9 rounded-xl text-xs font-semibold text-gray-600 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n            >\n              Close\n            </button>\n            <button\n              onClick={() => {\n                onClose();\n  