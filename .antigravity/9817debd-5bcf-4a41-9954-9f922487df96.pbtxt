      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    background-color: #FBFBFC;\n    color: #1A1A1B;\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #EBECEF;\n  border-radius: 9999px;\n}\n\n.dark .custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #27272a;\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    background-color: #FAFAFA;\n    color: #111827;\n    font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    letter-spacing: -0.011em;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .dark body {\n    background-color: #0B0F19;\n    color: #F9FAFB;\n  }\n}\n\n/* Linear-style smooth transitions */\n.transition-linear-fast {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);\n  transition-duration: 180ms;\n}\n\n/* Custom Soft Shadow conforming to specifications */\n.shadow-card {\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 4px 12px -2px rgba(0, 0, 0, 0.03);\n}\n\n.dark .shadow-card {\n  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.3), 0 4px 12px -2px rgba(0, 0, 0, 0.4);\n}\n\n.shadow-card-hover {\n  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.04), 0 12px 24px -4px rgba(0, 0, 0, 0.06);\n}\n\n.dark .shadow-card-hover {\n  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.4), 0 12px 24px -4px rgba(0, 0, 0, 0.6);\n}\n\n/* Custom scrollbars */\n.custom-scrollbar::-webkit-scrollbar {\n  width: 5px;\n  height: 5px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #E5E7EB;\n  border-radius: 9999px;\n}\n\n.dark .custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #1F2937;\n}\n"
    }
