    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Sparkles, \n  FolderImage, \n  History, \n  HardDrive, \n  PlusCircle, \n  ArrowRight, \n  Flame, \n  Zap, \n  Copy, \n  Check, \n  FileImage, \n  Video,\n  CheckCircle2\n} from \'lucide-react\';\nimport { MediaItem, CaptionHistoryItem, User } from \'../types\';\n\ninterface DashboardViewProps {\n  mediaItems: MediaItem[];\n  captionHistory: CaptionHistoryItem[];\n  user: User;\n  onConnectDrive: () => void;\n  onOpenMediaLibrary: () => void;\n  onSelectMedia: (item: MediaItem) => void;\n  onGenerateCaption: (item: MediaItem) => void;\n  onOpenImportModal: () => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  mediaItems,\n  captionHistory,\n  user,\n  onConnectDrive,\n  onOpenMediaLibrary,\n  onSelectMedia,\n  onGenerateCaption,\n  onOpenImportModal,\n}) => {\n  const recentMedia = mediaItems.slice(0, 4);\n  const recentCaptions = captionHistory.slice(0, 3);\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Welcome Banner */}\n      <div className=\"relative overflow-hidden p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 text-white shadow-xl\">\n        {/* Background glow graphics */}\n        <div className=\"absolute -top-12 -right-12 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none\" />\n        <div className=\"absolute -bottom-12 -left-12 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl pointer-events-none\" />\n\n        <div className=\"relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"space-y-2 max-w-xl\">\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-indigo-300 text-xs font-semibold backdrop-blur-md border border-white/10\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>AI Content Engine Ready</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">\n              Hello, {user.name.split(\' \')[0]} \360\237\221\213\n            </h1>\n            \n            <p className=\"text-xs sm:text-sm text-indigo-200/90 leading-relaxed\">\n              Turn your raw photos and videos stored in Google Drive into viral captions for Instagram, LinkedIn, and X in less than 30 seconds.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            {user.isDriveConnected ? (\n              <button\n                onClick={onOpenImportModal}\n                className=\"px-5 py-2.5 rounded-xl text-xs font-bold bg-white text-indigo-950 hover:bg-indigo-50 shadow-lg transition-transform active:scale-95 flex items-center gap-2\"\n              >\n                <PlusCircle className=\"w-4 h-4 text-indigo-600\" />\n                <span>Import New File</span>\n              </button>\n            ) : (\n              <button\n                onClick={onConnectDrive}\n                className=\"px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-500 hover:bg-emerald-600 text-white shadow-lg shadow-emerald-500/25 transition-transform active:scale-95 flex items-center gap-2\"\n              >\n                <HardDrive className=\"w-4 h-4\" />\n                <span>Connect Google Drive</span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenMediaLibrary}\n              className=\"px-4 py-2.5 rounded-xl text-xs font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/15 backdrop-blur-md flex items-center gap-1.5 transition-colors\"\n            >\n              <span>View Library ({mediaItems.length})</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Metrics Row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        \n        {/* Metric 1 */}\n        <div className=\"p-5 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0\">\n            <FolderImage className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-slate-900 dark:text-white block\">\n              {mediaItems.length}\n            </span>\n            <span className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n              Synced Drive Assets\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"p-5 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/80 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0\">\n            <Sparkles className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-2xl font-bold text-slate-900 dark:text-white block\">\n              {captionHistory.length}\n            </span>\n            <span className=\"text-xs font-medium text-slate-500 dark:text-slate-400\">\n              Captions Generated\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"p-5 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex items-center gap-4\">\n          <div className={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${\n            user.isDriveConnected \n              ? \'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400\' \n              : \'bg-amber-50 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400\'\n          }`}>\n            <HardDrive className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5\">\n              {user.isDriveConnected ? (\n                <>\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-500\" />\n                  <span>Connected</span>\n                </>\n              ) : (\n                <span>Action Needed</span>\n              )}\n            </span>\n            <span className=\"text-xs font-medium text-slate-500 dark:text-slate-400 truncate max-w-[150px] block\">\n              {user.isDriveConnected ? user.connectedDriveEmail : \'Drive Sync Inactive\'}\n            </span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Recently Imported Drive Files */}\n      <div className=\"space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n              Recently Synced Media\n            </h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n              Select any photo or video to generate social captions instantly\n            </p>\n          </div>\n\n          <button\n            onClick={onOpenMediaLibrary}\n            className=\"text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1\"\n          >\n            <span>View All</span>\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {recentMedia.map((item) => (\n            <div\n              key={item.id}\n              onClick={() => onSelectMedia(item)}\n              className=\"group relative rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 overflow-hidden hover:border-indigo-400 dark:hover:border-indigo-500 cursor-pointer transition-all shadow-xs\"\n            >\n              <div className=\"aspect-16/10 w-full overflow-hidden relative bg-slate-100 dark:bg-slate-900\">\n                <img src={item.thumbnail} alt={item.filename} className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\" />\n                <div className=\"absolute top-2 left-2 px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-xs text-white text-[10px] font-medium flex items-center gap-1\">\n                  {item.file_type === \'video\' ? <Video className=\"w-3 h-3 text-amber-400\" /> : <FileImage className=\"w-3 h-3 text-indigo-400\" />}\n                  <span className=\"capitalize\">{item.file_type}</span>\n                </div>\n              </div>\n\n              <div className=\"p-3 space-y-2\">\n                <h4 className=\"text-xs font-bold text-slate-900 dark:text-white truncate\">\n                  {item.filename}\n                </h4>\n\n                <button\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    onGenerateCaption(item);\n                  }}\n                  className=\"w-full py-1.5 px-3 rounded-xl text-xs font-semibold bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white dark:bg-indigo-950/60 dark:hover:bg-indigo-600 dark:text-indigo-300 dark:hover:text-white transition-all flex items-center justify-center gap-1.5\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  <span>Generate Captions</span>\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Recent Captions Feed */}\n      {recentCaptions.length > 0 && (\n        <div className=\"space-y-4 pt-2\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-base font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n              <History className=\"w-4 h-4 text-indigo-500\" />\n              <span>Recent Generated Captions</span>\n            </h3>\n          </div>\n\n          <div className=\"space-y-3\">\n            {recentCaptions.map((hist) => (\n              <div\n                key={hist.id}\n                className=\"p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 space-y-2 shadow-xs\"\n              >\n                <div className=\"flex items-center justify-between gap-2 text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-0.5 rounded-md font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300\">\n                      {hist.platform}\n                    </span>\n                    <span className=\"text-slate-400\">\342\200\242</span>\n                    <span className=\"text-slate-500 dark:text-slate-400 font-medium\">{hist.tone}</span>\n                    <span className=\"text-slate-400\">\342\200\242</span>\n                    <span className=\"text-slate-400 truncate max-w-[150px]\">{hist.media_filename}</span>\n                  </div>\n\n                  <span className=\"text-[11px] text-slate-400\">\n                    {new Date(hist.created_at).toLocaleDateString()}\n                  </span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-50 dark:bg-slate-900 text-xs text-slate-800 dark:text-slate-200 font-sans whitespace-pre-wrap line-clamp-3\">\n                  <strong>{hist.caption_variation.hook}</strong>\n                  {\'\\n\\n\'}\n                  {hist.caption_variation.body}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
