    instruction: "Update CaptionHistoryView.tsx to match #2563EB accent blue, 18px rounded cards, 12px buttons, and Linear styling."
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { \n  History, \n  Search, \n  Copy, \n  Check, \n  Trash2, \n  Filter, \n  ExternalLink,\n  Share2,\n  Send,\n  FileImage,\n  Video\n} from \'lucide-react\';\nimport { CaptionHistoryItem, SocialPlatform } from \'../types\';\n\ninterface CaptionHistoryViewProps {\n  history: CaptionHistoryItem[];\n  onDeleteHistoryItem: (id: string) => void;\n  onOpenPublishModal?: (data: {\n    mediaFilename: string;\n    mediaThumbnail: string;\n    captionText: string;\n    platform: SocialPlatform;\n  }) => void;\n}\n\nexport const CaptionHistoryView: React.FC<CaptionHistoryViewProps> = ({\n  history,\n  onDeleteHistoryItem,\n  onOpenPublishModal\n}) => {\n  const [selectedPlatform, setSelectedPlatform] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const platforms = [\'all\', \'Instagram\', \'LinkedIn\', \'Facebook\', \'X\'];\n\n  const filteredHistory = history.filter((item) => {\n    if (selectedPlatform !== \'all\' && item.platform !== selectedPlatform) {\n      return false;\n    }\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const matchesHook = item.caption_variation.hook.toLowerCase().includes(q);\n      const matchesBody = item.caption_variation.body.toLowerCase().includes(q);\n      const matchesFile = item.media_filename.toLowerCase().includes(q);\n      return matchesHook || matchesBody || matchesFile;\n    }\n    return true;\n  });\n\n  const handleCopy = (item: CaptionHistoryItem) => {\n    const text = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta}\\n\\n${item.caption_variation.hashtags.join(\' \')}`;\n    navigator.clipboard.writeText(text);\n    setCopiedId(item.id);\n    setTimeout(() => setCopiedId(null), 2500);\n  };\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-indigo-500\" />\n            <span>Recent Generated Captions ({history.length})</span>\n          </h2>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n            Review, copy, or manage your previously AI-generated captions\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Toolbar */}\n      <div className=\"p-4 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n        \n        {/* Search */}\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search generated text or filename...\"\n            className=\"w-full pl-10 pr-4 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30\"\n          />\n        </div>\n\n        {/* Platform Filter Tabs */}\n        <div className=\"flex items-center gap-1 p-1 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 w-full sm:w-auto overflow-x-auto\">\n          {platforms.map((p) => (\n            <button\n              key={p}\n              onClick={() => setSelectedPlatform(p)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-all ${\n                selectedPlatform === p\n                  ? \'bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n              }`}\n            >\n              {p === \'all\' ? \'All Platforms\' : p}\n            </button>\n          ))}\n        </div>\n\n      </div>\n\n      {/* History Grid */}\n      {filteredHistory.length > 0 ? (\n        <div className=\"space-y-4\">\n          {filteredHistory.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-5 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 space-y-3 shadow-xs hover:border-indigo-300 dark:hover:border-indigo-600/50 transition-all\"\n            >\n              <div className=\"flex items-center justify-between gap-3 flex-wrap border-b border-slate-100 dark:border-slate-800/80 pb-3\">\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"w-10 h-10 rounded-xl overflow-hidden shrink-0 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700\">\n                    <img src={item.media_thumbnail} alt={item.media_filename} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-xs font-bold text-slate-900 dark:text-white truncate\">\n                      {item.media_filename}\n                    </h4>\n                    <div className=\"flex items-center gap-2 mt-0.5 text-[11px] text-slate-500\">\n                      <span className=\"font-semibold text-indigo-600 dark:text-indigo-400\">{item.platform}</span>\n                      <span>\342\200\242</span>\n                      <span>{item.tone} Tone</span>\n                      <span>\342\200\242</span>\n                      <span>{item.length}</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopy(item)}\n                    className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    {copiedId === item.id ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                        <span>Copied!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-3.5 h-3.5\" />\n                        <span>Copy</span>\n                      </>\n                    )}\n                  </button>\n\n                  {onOpenPublishModal && (\n                    <button\n                      onClick={() => {\n                        const fullText = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta || \'\'}\\n\\n${item.caption_variation.hashtags?.join(\' \') || \'\'}`;\n                        onOpenPublishModal({\n                          mediaFilename: item.media_filename,\n                          mediaThumbnail: item.media_thumbnail,\n                          captionText: fullText,\n                          platform: item.platform\n                        });\n                      }}\n                      className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-xs flex items-center gap-1.5 transition-transform active:scale-95 cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Post to Social</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteHistoryItem(item.id)}\n                    className=\"p-2 rounded-xl text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition-colors\"\n                    title=\"Delete caption history item\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Caption Content */}\n              <div className=\"p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200/60 dark:border-slate-800 space-y-2\">\n                <p className=\"text-xs font-bold text-slate-900 dark:text-slate-100\">\n                  \360\237\252\235 {item.caption_variation.hook}\n                </p>\n                <p className=\"text-xs text-slate-700 dark:text-slate-300 font-sans whitespace-pre-wrap leading-relaxed\">\n                  {item.caption_variation.body}\n                </p>\n                {item.caption_variation.cta && (\n                  <p className=\"text-xs font-medium text-indigo-600 dark:text-indigo-400 pt-1\">\n                    \360\237\221\211 {item.caption_variation.cta}\n                  </p>\n                )}\n                {item.caption_variation.hashtags?.length > 0 && (\n                  <div className=\"flex flex-wrap gap-1 pt-1\">\n                    {item.caption_variation.hashtags.map((h, idx) => (\n                      <span key={idx} className=\"text-[10px] font-medium text-slate-500 dark:text-slate-400\">\n                        {h}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              <div className=\"text-[10px] text-slate-400 text-right\">\n                Created: {new Date(item.created_at).toLocaleString()}\n              </div>\n\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-3xl bg-white dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 p-8 space-y-3\">\n          <div className=\"w-14 h-14 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto\">\n            <History className=\"w-7 h-7\" />\n          </div>\n          <h3 className=\"text-base font-bold text-slate-900 dark:text-white\">\n            No generated captions found\n          </h3>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Select a photo or video from your media library and click Generate Caption to save your first caption here.\n          </p>\n        </div>\n      )}\n\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { \n  History, \n  Search, \n  Copy, \n  Check, \n  Trash2, \n  Send\n} from \'lucide-react\';\nimport { CaptionHistoryItem, SocialPlatform } from \'../types\';\n\ninterface CaptionHistoryViewProps {\n  history: CaptionHistoryItem[];\n  onDeleteHistoryItem: (id: string) => void;\n  onOpenPublishModal?: (data: {\n    mediaFilename: string;\n    mediaThumbnail: string;\n    captionText: string;\n    platform: SocialPlatform;\n  }) => void;\n}\n\nexport const CaptionHistoryView: React.FC<CaptionHistoryViewProps> = ({\n  history,\n  onDeleteHistoryItem,\n  onOpenPublishModal\n}) => {\n  const [selectedPlatform, setSelectedPlatform] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const platforms = [\'all\', \'Instagram\', \'LinkedIn\', \'Facebook\', \'X\'];\n\n  const filteredHistory = history.filter((item) => {\n    if (selectedPlatform !== \'all\' && item.platform !== selectedPlatform) {\n      return false;\n    }\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      const matchesHook = item.caption_variation.hook.toLowerCase().includes(q);\n      const matchesBody = item.caption_variation.body.toLowerCase().includes(q);\n      const matchesFile = item.media_filename.toLowerCase().includes(q);\n      return matchesHook || matchesBody || matchesFile;\n    }\n    return true;\n  });\n\n  const handleCopy = (item: CaptionHistoryItem) => {\n    const text = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta}\\n\\n${item.caption_variation.hashtags.join(\' \')}`;\n    navigator.clipboard.writeText(text);\n    setCopiedId(item.id);\n    setTimeout(() => setCopiedId(null), 2500);\n  };\n\n  return (\n    <div className=\"space-y-6 animate-fadeIn\">\n      \n      {/* Header */}\n      <div className=\"p-6 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-2\">\n            <History className=\"w-5 h-5 text-blue-600 dark:text-blue-400\" strokeWidth={1.75} />\n            <span>Generated Captions ({history.length})</span>\n          </h1>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 mt-1\">\n            Review, copy, or publish previously generated captions\n          </p>\n        </div>\n      </div>\n\n      {/* Filter Toolbar */}\n      <div className=\"p-4 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card flex flex-col sm:flex-row items-center justify-between gap-3\">\n        \n        {/* Search */}\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400\" strokeWidth={1.75} />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search generated text or file...\"\n            className=\"w-full h-9 pl-9 pr-4 text-xs rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-800 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-600/20\"\n          />\n        </div>\n\n        {/* Platform Filter Tabs */}\n        <div className=\"flex items-center gap-1 p-1 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 w-full sm:w-auto overflow-x-auto\">\n          {platforms.map((p) => (\n            <button\n              key={p}\n              onClick={() => setSelectedPlatform(p)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold capitalize whitespace-nowrap transition-colors cursor-pointer ${\n                selectedPlatform === p\n                  ? \'bg-white dark:bg-[#111622] text-blue-600 dark:text-blue-400 shadow-xs\'\n                  : \'text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white\'\n              }`}\n            >\n              {p === \'all\' ? \'All Channels\' : p}\n            </button>\n          ))}\n        </div>\n\n      </div>\n\n      {/* History Grid */}\n      {filteredHistory.length > 0 ? (\n        <div className=\"space-y-4\">\n          {filteredHistory.map((item) => (\n            <div\n              key={item.id}\n              className=\"p-5 rounded-[18px] bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 shadow-card space-y-3\"\n            >\n              <div className=\"flex items-center justify-between gap-3 flex-wrap border-b border-gray-100 dark:border-slate-800 pb-3\">\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"w-10 h-10 rounded-xl overflow-hidden shrink-0 bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700\">\n                    <img src={item.media_thumbnail} alt={item.media_filename} className=\"w-full h-full object-cover\" />\n                  </div>\n\n                  <div className=\"min-w-0\">\n                    <h4 className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                      {item.media_filename}\n                    </h4>\n                    <div className=\"flex items-center gap-2 mt-0.5 text-[11px] text-gray-500 dark:text-slate-400\">\n                      <span className=\"font-semibold text-blue-600 dark:text-blue-400\">{item.platform}</span>\n                      <span>\342\200\242</span>\n                      <span>{item.tone} Tone</span>\n                      <span>\342\200\242</span>\n                      <span>{item.length}</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => handleCopy(item)}\n                    className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-white hover:bg-gray-100 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-200 border border-gray-200 dark:border-slate-700 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                  >\n                    {copiedId === item.id ? (\n                      <>\n                        <Check className=\"w-3.5 h-3.5 text-emerald-500\" />\n                        <span>Copied!</span>\n                      </>\n                    ) : (\n                      <>\n                        <Copy className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                        <span>Copy</span>\n                      </>\n                    )}\n                  </button>\n\n                  {onOpenPublishModal && (\n                    <button\n                      onClick={() => {\n                        const fullText = `${item.caption_variation.hook}\\n\\n${item.caption_variation.body}\\n\\n${item.caption_variation.cta || \'\'}\\n\\n${item.caption_variation.hashtags?.join(\' \') || \'\'}`;\n                        onOpenPublishModal({\n                          mediaFilename: item.media_filename,\n                          mediaThumbnail: item.media_thumbnail,\n                          captionText: fullText,\n                          platform: item.platform\n                        });\n                      }}\n                      className=\"px-3 h-8 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-xs flex items-center gap-1.5 transition-transform active:scale-95 cursor-pointer\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                      <span>Post to Social</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteHistoryItem(item.id)}\n                    className=\"p-1.5 rounded-lg text-gray-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer\"\n                    title=\"Delete item\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" strokeWidth={1.75} />\n                  </button>\n                </div>\n              </div>\n\n              {/* Caption Content */}\n              <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-2\">\n                <p className=\"text-xs font-bold text-gray-900 dark:text-white\">\n                  \360\237\252\235 {item.caption_variation.hook}\n                </p>\n                <p className=\"text-xs text-gray-700 dark:text-slate-300 font-sans whitespace-pre-wrap leading-relaxed\">\n                  {item.caption_variation.body}\n                </p>\n                {item.caption_variation.cta && (\n                  <p className=\"text-xs font-medium text-blue-600 dark:text-blue-400 pt-1\">\n                    \360\237\221\211 {item.caption_variation.cta}\n                  </p>\n                )}\n                {item.caption_variation.hashtags?.length > 0 && (\n                  <div className=\"flex flex-wrap gap-1 pt-1\">\n                    {item.caption_variation.hashtags.map((h, idx) => (\n                      <span key={idx} className=\"text-[10px] font-medium text-gray-500 dark:text-slate-400\">\n                        {h}\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              <div className=\"text-[10px] text-gray-400 dark:text-slate-500 text-right\">\n                Created: {new Date(item.created_at).toLocaleString()}\n              </div>\n\n            </div>\n          ))}\n        </div>\n      ) : (\n        <div className=\"py-20 text-center rounded-[18px] bg-white dark:bg-[#111622] border border-dashed border-gray-300 dark:border-slate-800 p-8 space-y-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gray-50 dark:bg-slate-800 text-gray-400 flex items-center justify-center mx-auto\">\n            <History className=\"w-6 h-6\" strokeWidth={1.75} />\n          </div>\n          <h3 className=\"text-sm font-bold text-gray-900 dark:text-white\">\n            No Generated Captions\n          </h3>\n          <p className=\"text-xs text-gray-500 dark:text-slate-400 max-w-sm mx-auto\">\n            Select an image or video from your library and click Generate Caption to save history here.\n          </p>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
