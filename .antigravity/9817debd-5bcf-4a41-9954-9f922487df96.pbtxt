    replacement_chunks {
      target_content: "  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n      <div className=\"bg-white dark:bg-[#111622] border border-gray-200 dark:border-slate-800 rounded-[24px] w-full max-w-xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between bg-white dark:bg-[#111622]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs\">\n              <Send className=\"w-4 h-4\" strokeWidth={1.75} />\n            </div>\n            <div>\n              <h2 className=\"text-base font-bold text-gray-900 dark:text-white flex items-center gap-2\">\n                <span>Publish Content</span>\n                <span className=\"text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 flex items-center gap-1\">\n                  <ShieldCheck className=\"w-3 h-3\" />\n                  Approval Required\n                </span>\n              </h2>\n              <p className=\"text-xs text-gray-500 dark:text-slate-400\">\n                Review caption text and authorize immediate or scheduled social post\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" strokeWidth={1.75} />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5 flex-1\">\n          \n          {/* Success Banner */}\n          {publishResult && publishResult.success ? (\n            <div className=\"p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-200 space-y-2\">\n              <div className=\"flex items-center gap-2 text-xs font-bold\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                <span>{publishResult.message}</span>\n              </div>\n              {publishResult.postUrl && (\n                <a\n                  href={publishResult.postUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline pt-1\"\n                >\n                  <span>View Published Post on {selectedPlatform}</span>\n                  <ExternalLink className=\"w-3.5 h-3.5\" strokeWidth={1.75} />\n                </a>\n              )}\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  onClick={onClose}\n                  className=\"px-4 h-8 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 cursor-pointer shadow-xs\"\n                >\n                  Done\n                </button>\n              </div>\n            </div>\n          ) : publishResult && !publishResult.success ? (\n            <div className=\"p-4 rounded-xl bg-rose-50 dark:bg-rose-950/80 border border-rose-200 dark:border-rose-800 text-rose-900 dark:text-rose-200 flex items-center gap-2 text-xs font-medium\">\n              <AlertCircle className=\"w-4 h-4 text-rose-600 shrink-0\" />\n              <span>{publishResult.message}</span>\n            </div>\n          ) : null}\n\n          {/* Platform Selector */}\n          <div className=\"space-y-2\">\n            <label className=\"text-[11px] font-bold text-gray-500 dark:text-slate-400 uppercase tracking-wider block\">\n              Target Channel\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n              {([\'Instagram\', \'LinkedIn\', \'X\', \'Facebook\'] as SocialPlatform[]).map((plat) => {\n                const isSelected = selectedPlatform === plat;\n                const acc = connectedAccounts.find(a => a.platform === plat && a.is_connected);\n                return (\n                  <button\n                    key={plat}\n                    onClick={() => setSelectedPlatform(plat)}\n                    className={`p-3 rounded-xl border text-left flex flex-col justify-between transition-all cursor-pointer ${\n                      isSelected\n                        ? \'border-blue-600 bg-blue-50/50 dark:bg-blue-950/40 ring-1 ring-blue-600\'\n                        : \'border-gray-200 dark:border-slate-800 hover:border-gray-300 bg-white dark:bg-[#111622]\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between w-full mb-2\">\n                      {getPlatformIcon(plat)}\n                      <span className={`text-[10px] font-semibold px-1.5 py-0.5 rounded-full ${\n                        acc ? \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300\' : \'bg-gray-100 text-gray-500 dark:bg-slate-800 dark:text-slate-400\'\n                      }`}>\n                        {acc ? \'Linked\' : \'Offline\'}\n                      </span>\n                    </div>\n                    <div>\n                      <span className=\"text-xs font-bold text-gray-900 dark:text-white block\">{plat}</span>\n                      <span className=\"text-[10px] text-gray-500 dark:text-slate-400 truncate block\">\n                        {acc ? acc.handle : \'Unlinked\'}\n                      </span>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Preview Card */}\n          <div className=\"p-4 rounded-xl bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 space-y-3\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={mediaThumbnail}\n                alt={mediaFilename}\n                className=\"w-14 h-14 rounded-xl object-cover border border-gray-200 dark:border-slate-700 shrink-0\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <span className=\"text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider block\">\n                  Media Attachment\n                </span>\n                <p className=\"text-xs font-bold text-gray-900 dark:text-white truncate\">\n                  {mediaFilename}\n                </p>\n                <p className=\"text-[11px] text-gray-500 dark:text-slate-400\">\n                  Target: <strong className=\"text-gray-800 dark:text-slate-200\">{currentAccount ? currentAccount.account_name : selectedPlatform}</strong> ({currentAccount?.handle || \'Unlinked\'})\n                </p>\n              </div>\n            </div>\n\n            {/* Editable Caption Text */}\n            <div className=\"space-y-1\">\n              <label className=\"text-[11px] font-bold text-gray-600 dark:text-slate-400 block\">\n                Caption Content\n              </label>\n              <textarea\n                value={editedCaption}\n                onChange={(e) => setEditedCaption(e.target.value)}\n                rows={5}\n                className=\"w-full p-3 text-xs rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-[#111622] text-gray-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600/20 font-sans leading-relaxed resize-none\"\n              />\n            </div>\n          </div>"
