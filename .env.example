# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Social Media OAuth Credentials (Optional for real platform publishing —
# still a demo/simulated integration as of this pass, see server.ts)
# Instagram publishing (real — via Meta Graph API + a Facebook Page with a
# linked Instagram Business/Creator account). From Meta for Developers >
# your app > Settings > Basic.
META_APP_ID=
META_APP_SECRET=

# Shared secret for the /api/cron/publish-scheduled-posts endpoint, which an
# external scheduler (cron-job.org, a GitHub Actions scheduled workflow, or
# Vercel Cron on a Pro plan) calls periodically to fire due scheduled posts.
# Generate any long random string for this.
CRON_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---- Firebase Admin (server-side) ----
# From Firebase Console > Project Settings > Service Accounts > Generate new
# private key. Paste the private_key value exactly as downloaded, including
# the literal \n sequences — buildAdminApp() in lib/firebaseAdmin.ts unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth Client ID used for the Drive-connect flow (Google Identity
# Services). This is the "Web client (auto created by Google Service)" OAuth
# client that Firebase creates automatically once you enable the Google
# sign-in provider under Authentication > Sign-in method — find it in
# Google Cloud Console > APIs & Services > Credentials for this project.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Firebase Web config (client-side, exposed to the browser — not secret) ----
# From Firebase Console > Project Settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
