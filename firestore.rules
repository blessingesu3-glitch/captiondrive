rules_version = '2';

// Our backend (server.ts) talks to Firestore via the Admin SDK, which
// bypasses these rules entirely — they exist as defense-in-depth for any
// future direct client access (e.g. if a real-time listener is added later),
// and so a misconfigured or leaked client can't read/write another user's
// data even if it somehow gets a valid ID token.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Covers captionHistory/{id}, importedMedia/{id}, mediaAnalysisCache/{fileId}
      // — every subcollection under a user doc is scoped to that same uid.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else is denied by default (no matching rule = deny in v2).
  }
}
